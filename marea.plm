// Marea: the ball, written with pleamar.
//
// The measurements come from the life-size sheet (`design/concepts/
// 2026-09-12-reposo-vivo/referencia-real-limpia.png`): a 46 px body, eyes of
// 5 × 13 with rounded tips, 13 apart between centres and 2.5 px below the
// centre of the body.
//
// The timings come from the contract (`docs/ANIMACIONES.md`), and they are not
// negotiable: a brief blink every 5.2 s, a glance every 11 s, and every 12–24 s
// «Marea's breath» of 1.3 s —the eyes look first, the body rises 2 px, blinks
// fully, settles and goes back exactly to neutral—.
//
// Everything in this file is run by the renderer. There is no logic here at all.

import "pleamar:ui"
import "common/palette.plm"
import "common/accessories.plm"
import "lang/es.plm"
import "lang/es-logic.plm"

scene Marea {
    permissions {
        //  All on one line, which is how it is said: written twice, the lower one
        //  ate the upper one and audio was left without permission. Now pleamar
        //  says so on loading, but the lesson is the same.
        //
        //  The finder asks which applications there are, to launch them and where
        //  your home lives; the session, to be able to say goodbye. What is NOT
        //  here is `notifications`: the first one to ask for it keeps the spot,
        //  and on this machine that spot is Marea's.
        services: "audio", "audio.*", "clock", "media", "media.*", "network", "brightness", "brightness.*", "apps", "apps.launch", "env", "session.*", "tray", "tray.*", "notifications", "notifications.*", "auth", "files", "files.write", "window", "window.*", "network.*", "bluetooth", "bluetooth.*"
        //  The network and the headphones are pleamar's own services now
        //  (NetworkManager and BlueZ, spoken to directly): listing, joining
        //  with a password, pairing. And `fd` finds the files and the folders.
        run: "curl", "timedatectl", "node", "notify-send", "fd", "deriva-worker", "kill", "xdg-open", "grim", "slurp", "hyprctl", "magick", "wl-copy", "mkdir", "wf-recorder", "xdg-user-dir", "test", "pgrep", "swaybg", "pactl", "pleamar-wm", "marea-halley"
    }
    service clock as now { time: text = "--:--"; date: text; hour: number; minute: number }
    service audio as sound { volume: number; muted: bool; input: number; input_muted: bool }
    service media as playback { playing: bool; title: text; artist: text }
    service network as net { online: bool; name: text; kind: text; strength: number }
    service brightness as display { present: bool; level: number }

    // ── the pages of the control center ──────────────────────────
    //  Pressing a card opens its page, and **the page comes out of the card**:
    //  it grows from its place until it fills the panel. It is not a screen that
    //  replaces another; it is the same card, opened.
    fact page: none | wifi | bluetooth | concentration | wardrobe | sound | session | systray | settings | agents | calendar | history | drift | walls = none
    //  Her look, which is chosen in Settings and saved: glass that bends what is
    //  behind like Apple's, glass that only blurs it —lighter, the compositor
    //  does it—, or the usual one, opaque.
    //  Classic by default: it needs nothing of the compositor. The liquid one
    //  reads the screen behind her, and on some setups (colour management,
    //  fractional scaling) what it reads does not match and she fills with noise.
    fact skin: lens | liquid | classic = classic
    //  And how much glass there is right now: a spring, so changing look is not
    //  a jump. The glass appears by bending the light, not by fading in.
    prop glassiness = 1 ~calm
    follow glassiness = if(skin == classic, 0, 1)
    let bends = skin == lens
    //  Settings has two sections: the usual stuff and the look.
    //  The language she speaks: the system's (`LANG`), or one chosen in
    //  Settings. The logic turns it into `locale`, which is what switches the texts.
    fact language: system | english | spanish = system
    prop paging = 0 ~240ms
    follow paging = if(page == none, 0, 1)
    model networks max 8 { name: text; signal: number; current: bool; secure: bool; known: bool }
    model gadgets max 8 { name: text; current: bool; paired: bool; battery: number = -1 }
    //  A network that asks for its password: which row (−1, none), and the
    //  one being joined right now, which breathes until it is.
    fact asking = -1
    fact joining = -1
    text wifi_pw = ""
    event join ->                      // the password is written: join
    event forget_ask                   // not now
    //  The Bluetooth radio looking for new gadgets: its radar turns meanwhile.
    fact bt_scanning = false
    event bt_scan ->
    text ask.name = ""
    //  What the Bluetooth card says under its name: the one connected, or on/off.
    text bt.sub = "Headphones"
    prop ask.in = 0 ~220ms
    follow ask.in = if(asking >= 0, 1, 0)
    on change asking while asking >= 0 { focus wifi_pw }
    prop join.t = 0
    prop radar.t = 0
    prop join_btn.glow = 0 ~140ms
    spin join.t by if(joining >= 0, 1, 0)
    spin radar.t by if(bt_scanning and page == bluetooth, 0.8, 0)
    //  Where it plays and where it listens. pleamar brings them in the same
    //  service as the volume, so this does not know about `wpctl`, nor does it
    //  need to.
    model outputs max 5 { name: text; current: bool }
    model mics max 4 { name: text; current: bool }
    event pick_device ->
    //  The system tray: the icons left by the applications that stay alive
    //  without a window. pleamar brings them —`tray`, which knows how to live
    //  alongside another bar: if there is already a watcher, it asks that one—
    //  and here they are only drawn. A click is the usual one; the right one asks
    //  for its menu, which is a tree: a submenu is ENTERED, with a row to go
    //  back, instead of opening beside it.
    model icons max 8 { icon: image 22, 22; title: text }
    model options max 16 {
        label: text
        separator: bool
        enabled: bool = true
        checked: number = -1            // -1: not a checkbox · 0: empty · 1: ticked
        children: number                // how many it holds inside: it is a submenu
    }
    text systray.title = ""
    event systray_activate ->           // (i): the usual click
    event systray_menu ->               // (i): wants to see its menu
    event systray_pick ->               // (i): that row of the menu
    //  The session: lock, suspend, log out, reboot and power off. pleamar does it
    //  —`session.*`, which underneath are `loginctl` and `systemctl`—, and the
    //  last three ask for a separate confirmation, which is what the sheet says:
    //  «the chosen action needs a new, deliberate activation».
    //  The lock. Marea IS the lock screen: she does not tell someone else to
    //  lock, she bolts the door herself (`kind: lock`, further down) and it is
    //  the compositor that guarantees that while it lasts nothing else is seen or
    //  touched. Who gets in is not up to her: the logic asks PAM.
    fact locked = false
    fact checking = false              // PAM is thinking about it
    fact with_exit = false             // the first locks carry Esc, and say so
    text password = ""
    event lock                         // SUPER+L, or the card: `--say marea "emit lock"`
    event wrong_password               // the logic: that was not it
    prop headshake = 0 ~lively         // and she shakes her head no
    prop lock.glow = 0 ~220ms          // the box, when it has the keyboard
    fact confirming: none | logout | reboot | poweroff = none
    fact armed = false                 // the question, already settled
    //  The step from the list to the question: «small displacement and
    //  opacity», 220 ms. One leaves to the left while the other comes in from
    //  the right, which is what makes it read as a step forward and not as a
    //  change of sign.
    prop question = 0 ~220ms
    event session ->                   // 1 lock · 2 suspend · 3 log out · 4 reboot · 5 power off
    //  And its face. «Hovering or moving the focus only shows an ANTICIPATION
    //  of the gesture. It does not lock, suspend, log out or power off.» That is
    //  why it is a fact apart from `confirming`: what it shows and what it is
    //  going to do are not the same.
    fact hint: none | lock | sleep | logout | reboot | poweroff = none
    prop padlock = 0 ~150ms            // the padlock's shackle and body
    prop lids = 0 ~170ms               // two curved eyelids
    prop door = 0 ~200ms               // the frame and the arrow coming out
    prop turn = 0 ~160ms               // the circular arrow
    prop twirl = 0 ~350ms              // and its single turn, one at a time
    prop power = 0 ~180ms              // the open ring and the vertical stroke
    prop powerdown = 0 ~280ms          // and the point of light it ends in
    event scan ->                      // «look what's there»: the logic finds out
    event pick_network ->
    event pick_gadget ->

    fact compositor_halley = false
    surface {
        //  The surface has to stretch to fit the card **and its shadow**: 18 px
        //  of offset plus 44 of spread, below and at the sides. Otherwise the
        //  shadow is cut sharply against the edge and the cut shows.
        //  And it grows with the card: 572 of card hanging from `card.top` ≈ 38
        //  make 610, plus the shadow's 62. When it falls short, pleamar says so
        //  —«a drawing is cut: it needs 36 px below»— as soon as it has been like
        //  that for three seconds, which is what used to have to be seen by eye.
        size: 820, 680
        anchor: top
        margin: 0
        //  Her strip, if you want windows to leave it to her: as tall as she is
        //  with a little air. Only the copy that is open keeps it.
        reserve: 72 while taking_room
        //  One copy per monitor, and each one with its own. Which one shows is
        //  said by `mine`, in the logic: the one at her home, or the one on the
        //  monitor with the focus if you have set her to follow you. The others
        //  are there, but closed.
        screens: each max 2
        //  And the copy she has left through is CLOSED: it has nothing to show,
        //  and a closed surface is not painted and costs nothing. Open while
        //  she is in it or on her way through it, which is what lets you see her
        //  leap out of one and fall into the other; `swim.here` is this copy's one.
        open: swim.here > 0.01
        //  Sixty frames per second, decided here and not by the monitor: she is
        //  always breathing, and at 165 Hz she painted every breath 165 times a
        //  second. Measured: 21.5 % of a core, against 8.6 % on a 60 Hz screen.
        //  What she costs has to be the same on any screen.
        rate: 60
        //  Keyboard only while something of hers is open, and handed back on
        //  closing: «the click gives keyboard focus, but does not leave them
        //  stuck to the screen». Exclusive once used to close the menu by
        //  itself —reconfiguring the surface sends a «the pointer has left» and
        //  its grace zone emptied—; nothing closes on leaving any more.
        //  On demand: Hyprland hands it over when the mouse moves over her or
        //  the catcher. Exclusive was tried —so Esc worked without moving the
        //  mouse— and on closing the window below did not get the keyboard
        //  back.
        keyboard: on_demand while searching or menu_open or open or tray_open or reel_open
        //  Above everything while something of hers is open —so the catcher
        //  below can take the click outside—, and in its layer the rest of the
        //  time, so a video in full screen still covers her.
        //  Not for the finder: it takes the keyboard exclusively as it opens,
        //  and changing layer at that same moment left it without the keyboard
        //  and without the clicks. The finder closes with Esc, as always.
        //  Halley hides the top layer under fullscreen too. Its finder needs
        //  the overlay layer while searching; the Hyprland focus workaround
        //  above still applies on the other backends.
        level: top, overlay while open or tray_open or menu_open or reel_open or (compositor_halley and searching)
    }

    // ── where she lives ──────────────────────────────────────────
    //  At rest she lives at the top and centred; on opening she moves aside to
    //  the left to present the card, which is how it is on the control center's
    //  sheet.
    //  Where SHE is. It is no longer «how open the card is»: on closing, the
    //  card folds away first and she comes back afterwards, which is what makes
    //  the journey show instead of the two things happening on top of each other.
    prop offset = 0 ~290ms
    // ── her home: which monitor she lives on ─────────────────────
    //  `home` is the number of the monitor she lives on, and `following` sets
    //  her to go wherever the focus is. Who shows is decided by the LOGIC: it is
    //  the one that finds out which monitor the active window is on —a surface
    //  only receives the pointer while it is over it, so it has to be asked—,
    //  the one that knows which monitors there are and in what order, and the
    //  one that saves her home by its name in `settings.json`. Two facts arrive
    //  here already chewed: `hosts.0` and `hosts.1`, whether she is on that
    //  monitor.
    fact home = 0
    fact following = false
    //  Whether windows leave her the strip at the top (the compositor keeps
    //  it for her) or go under her, all of the screen theirs.
    fact taking_room = false
    //  pleamar-wm says which monitor the mouse is on, by its number: «follow
    //  me» there goes where the mouse is, even onto a monitor with no window.
    event pointer_monitor ->
    fact hosts.0 = true
    fact hosts.1 = false
    //  And the journey. She does not switch off and on: she lives hanging from
    //  the water at the top edge, so she goes the way water lets her. She
    //  LEAPS UP into it on the monitor she leaves —a crouch, a push, and she
    //  shoots through the edge stretched like a drop, the surface closing over
    //  her— and she FALLS OUT of it on the other one: the water there stirs,
    //  she drops through the edge, the thread breaks with its tug and she lands
    //  squashing and bouncing a hair. One after the other, never both at once:
    //  there is only one of her.
    //  `swim.K` is only whether copy K is up at all: a closed surface is not
    //  painted and costs nothing. It changes by rules, not by `follow`, because
    //  who is shown changes at `gone` —when she has already left—, not when the
    //  logic says so. And the destination of a delayed rule is computed when it
    //  lands, so every one says `if(hosts.K, …)`: if the focus bounces back and
    //  forth mid-journey, the last word is always the true one.
    prop swim.0 = 1 ~16ms
    prop swim.1 = 0 ~16ms
    let swim.here = if(screen.index == 0, swim.0, swim.1)
    //  Straight up and straight down, at the centre where she lives: the edge
    //  of the screen is the same water on both monitors, so the journey needs
    //  no side. Leaning it towards the other monitor looked like an effect
    //  happening off to one side and then correcting itself.
    prop drop_in = 0 ~16ms            // 1: above the edge of the one she is going to
    //  Falling she stretches with her own speed, and nobody leads it: it is the
    //  velocity of the spring that drops her, so it is longest mid-fall and
    //  gone by the time she touches.
    let fall.stretch = clamp(-vel(drop_in) * 0.055, 0, 0.32)
    //  While she travels the water is there even if she is not tucked into it:
    //  it is what she goes through.
    prop splashing = 0 ~16ms
    let wet = max(if(hidden, 1, 0), splashing)
    //  And her place is set ONLY by this, not by the geometry of whatever she has
    //  open: with the tray pulling her directly, on closing she came back at the
    //  same time as it folded, and two things on top of each other cannot be seen.
    let aside = offset
    let cx = 120 + (1 - aside) * 240
    //  Open, she drops to the height of the card's header, as on the sheet.
    //  And the path bows: the height goes by the square, so she leaves and comes
    //  in from above instead of crossing in a straight line. Something with
    //  weight does not travel diagonally.
    let cy = 46 + aside * aside * 46
    let r = 23                        // half of the sheet's 46 px

    // ── what moves her ───────────────────────────────────────────
    //  `pose` is what a gesture leads by the hand: when it ends it goes back to
    //  its base by itself, and that is what makes the breath «return exactly to
    //  neutral».
    pose body.y = 0                   // how much the body rises
    pose lid = 1                      // the eyelids: 1 open, 0 closed
    pose eyes = 13                    // how tall the eyes are
    pose look.y = 0                   // the gaze inside the face
    pose tilt = 0                     // the body's tilt
    pose sx = 1                       // what stretches: widthwise
    pose sy = 1                       // and heightwise
    pose shut = 0                     // the shutter: 1 closed

    prop gaze.x = 0 ~gentle           // where they look, following the mouse
    prop gaze.y = 0 ~gentle
    prop press = 0 ~quick             // the squeeze under the click

    //  The journey of leaving by the edge and coming back: 620 ms, which is what
    //  the contract says. A drop that leaves in 200 ms is a drop nobody saw leave.
    fact hidden = true                // «tuck into the edge», switched on
    fact needed = false               // something calls her: a notice, the pointer…
    prop out = 0 ~620ms               // 0 sunk, 1 fully separated

    //  The card. Two things that travel separately, and that is the trick: on
    //  opening the geometry leads and the content follows it; on closing the
    //  content fades first and **then** the geometry folds away.
    fact open = false
    // ── the notices ──────────────────────────────────────────────
    //  «Everything arrives, you decide»: arriving opens nothing. A small card
    //  comes in beside her, she gives a start and looks at it, it stays as long
    //  as it takes to read it and then narrows until it is a drop of its
    //  category's colour, which flies along a curve to her shoulder. On arriving,
    //  a gulp.
    //  While this is true, the logic keeps releasing a batch of made-up notices:
    //  it is the demo mode, to be able to see the whole swell without waiting for
    //  someone to write to you. `--say "fact demo false"` stops it.
    //  pleamar knows how to bring the real ones, but it asks for its permission
    //  and on this machine that spot is Marea's.
    fact demo = true
    event another_batch ->             // «release the batch for me again»
    event notice                       // one arrives: `cat`, `who` and `line` are said first
    event landed
    event tray ->                      // pressing the card: the logic opens the tray
    fact cat = 1                       // 1 messages · 2 work · 3 calendar · 4 system
    fact reading_cat = 1               // that of the one being read: `cat` can change meanwhile
    fact arrival_seq = 0               // and its turn of arrival: it lands late, but it arrived first
    event direct                       // one that arrives with another on screen
    text who = ""
    text line = ""
    fact phase = 0                     // 0 nothing · 1 being read · 2 flying
    fact hovered = false               // the pointer over it: stops the reading
    fact mark = 0                      // every time the reading starts over
    fact seq = 0                       // to know which one is the most recent
    fact burst = 1                     // how many the burst brings
    // ── the tray ─────────────────────────────────────────────────
    //  «Everything arrives, you decide». Arriving does not open it: it opens by
    //  pressing her, the preview, a drop or the card that arrives.
    fact tray_open = false
    //  Which category is shown in the swell: 0 all, or a single one.
    //  It is set on pressing a drop, and cleared on opening it from anywhere
    //  else —pressing her, the card that arrives, an urgent one—.
    fact filter = 0
    event open_tray
    //  What has washed up: the notices already dealt with, newest first, with
    //  a row for each day (`head`). `age` 0 today … 1 a week or more.
    model past max 9 { app: text; title: text; detail: text; when: text; day: text; cat: number = 4; head: bool; age: number }
    event show_history                 // from her menu or the swell's footer
    // ── wallpapers: the tide that brings a new one ───────────────
    //  Her page shows the wallpapers there are, small. Picking one closes
    //  the card, a drop falls from her onto the desktop, and from where it
    //  lands the new picture spreads as a ring of water with a shadow running
    //  ahead of it and a line of light on its crest; behind it the water
    //  ripples until it settles. Then `swaybg` takes the new one, unseen.
    model walls max 9 { name: text; thumb: image 144, 81; ready: bool; current: bool }
    model wallnow max 1 { name: text; thumb: image 160, 90; ready: bool }   // the one on now, in her wardrobe
    model tidepics max 1 { pic: image 1280, 720 }
    event show_walls
    event walls_open ->
    event wall_pick ->
    event walls_scroll ->
    event tide_start                   // the logic: the new picture is ready
    event tide_done ->                 // the water has settled: swaybg can take it
    event splash
    fact tide.on = false
    fact tide.home = 0                 // the monitor where the drop lands
    prop tide.fall = 0 ~450ms
    prop tide.p = 0 ~2400ms
    prop tide.settle = 0 ~2600ms
    prop tide.fade = 0 ~500ms
    on show_walls { menu_open = false; tray_open = false; searching = false; open = true; page = walls; emit walls_open }
    on tide_start {
        open = false
        tide.on = true
        tide.fade: 1 ~0ms
        tide.p: 0 ~0ms
        tide.settle: 0 ~0ms
        tide.fall: 0 ~0ms
        tide.fall: 1 ~450ms after 30ms
    }
    //  The drop has landed: the splash, and the wave sets off.
    on still tide.fall for 40ms while tide.on and tide.fall > 0.9 and tide.p < 0.001 {
        emit splash
        tide.p: 1 ~2400ms
        tide.settle: 1 ~2600ms after 900ms
    }
    on still tide.settle for 80ms while tide.on and tide.settle > 0.9 and tide.p > 0.9 { emit tide_done }
    //  Once swaybg has it, the tide melts into it and goes.
    event tide_away
    on tide_away { tide.fade: 0 ~500ms }
    on still tide.fade for 60ms while tide.on and tide.fade < 0.1 and tide.p > 0.9 { tide.on = false }
    // ── Deriva: what is dropped on her, kept, and found again ────
    //  Carry something over her —a link, a file, an image, some text— and a
    //  pool opens under her, with two more places to leave it; let it go and
    //  she swallows it. Her library (`deriva-worker`, on disk) keeps it, and its
    //  page finds it again: cards with their picture, the wheel to go on.
    model drift max 4 { title: text; source: text; kind: text; date: text; preview: image 222, 92; has_preview: bool; link: text }
    text drift_q = ""
    text drift.toast = ""
    fact drift.result = 0              // 0 none · 1 saved · 2 already there · 3 could not
    fact drift.kept = 0
    //  Her library is not installed: the page says so instead of staying empty.
    fact drift.missing = false
    event show_drift
    event drift_open ->
    event drift_pick ->
    event drift_scroll ->
    event drift_saved                  // the logic: it is kept (or it already was)
    prop catch = 0 ~260ms
    follow catch = if(drag.over, 1, 0)
    prop pool.t = 0
    spin pool.t by if(drag.over, 0.9, 0)
    prop later.hl = 0 ~140ms
    prop insp.hl = 0 ~140ms
    prop toast.in = 0 ~220ms
    on show_drift { menu_open = false; tray_open = false; searching = false; open = true; page = drift; emit drift_open }
    on drift_saved {
        toast.in: 1 ~220ms
        toast.in: 0 ~400ms after 2200ms
        play gulp
    }
    //  The same note, for anything else she wants to say in passing.
    event say_toast
    on say_toast {
        toast.in: 1 ~220ms
        toast.in: 0 ~400ms after 2200ms
    }
    event clear_history ->
    event history_scroll ->            // the wheel over it: back and forth in time
    prop hist.wash = 0 ~700ms
    prop clear.glow = 0 ~140ms
    prop hist_link.glow = 0 ~140ms
    prop tide.t = 0
    spin tide.t by if(page == history, 0.4, 0)
    on show_history { menu_open = false; tray_open = false; open = true; page = history; emit history_open }
    event history_open ->
    event close_tray
    event resolve ->                   // with which one, as payload: the logic marks it read
    event dismiss ->                   // and this one is thrown away: it does not come back, nor send a drop
    event open_notice ->               // a tap: let the logic open it wherever it lives
    event undone ->                    // changed her mind in time: that row does not close
    //  «Undo» for 5 s, with a fuse that burns down. Five exact seconds at a
    //  constant pace are not given by a spring: they are given by a gesture,
    //  which is a timeline with its curve. `linear` is what makes a fuse look
    //  like a fuse and not like something that brakes at the end.
    // ── the finder ───────────────────────────────────────────────
    //  «Replace the app drawer with a main search for apps, files and folders»
    //  —review of 31 August—, and the sequence sheet tells it in six beats:
    //  rests, moves aside, **searches**, finds, opens and folds away. What makes
    //  it hers and not just any launcher is the third: **her eyes turn into a
    //  magnifying glass**.
    fact searching = false
    event search ->                    // from her menu, or from an outside shortcut
    event open_result ->               // `emit open_result(2)`: opens the third one
    text query = ""
    //  What is found, just as the logic delivers it: apps from the system's
    //  service, and files and folders from `fd`. The icon travels in the record.
    model results max 7 { name: text; kind_label: text; icon: image 40, 40; glyph: number; path: text }
    fact selected = 0
    prop magnifier = 0 ~320ms          // the face, turning into a magnifying glass
    prop finder = 0 ~290ms             // the panel's geometry
    prop finder_content = 0 ~200ms     // and what is read inside

    // ── sleeping ─────────────────────────────────────────────────
    //  «Dozing off: the eyelids drop, she nods gently and settles in. 1.24 s.
    //  It starts on pressing “Sleep” or after 45 s idle.» And asleep: «eyes like
    //  little lines, light breathing and a discreet “z”, a 3.6 s cycle».
    //
    //  Sleeping is not the Haven: there she is still awake and attentive —that
    //  is why the eyes drop to two strokes and do not close—, and here she is
    //  not. That is why automatic sleep is suspended while the Haven lasts,
    //  which is what the contract asks for.
    fact asleep = false
    event sleep ->
    event wake ->
    prop drowsy = 0 ~1240ms            // 0 awake, 1 asleep
    prop zee = 0 ~3400ms               // the «z» that rises and dissolves
    on sleep { asleep = true }
    on wake { asleep = false }
    //  Falling asleep takes 1.24 s and waking up 380 ms: nobody wakes up slowly
    //  when they are called.
    on change asleep while asleep { drowsy: 1 ~1240ms; play nod }
    on change asleep while not asleep { drowsy: 0 ~380ms; dozed = false }
    //  Dozing off on her own is not the same as being sent to bed. If she
    //  nodded off because nobody was there, the mouse moving anywhere —on
    //  another window, on the other monitor— is somebody back, and she wakes.
    //  Sent to bed with «Sleep», she sleeps until you come to her: otherwise
    //  moving away from the button would wake her.
    fact dozed = false
    on change cursor.x + cursor.y * 8192 while asleep and dozed { asleep = false }
    //  The «z», one every 3.6 s: it rises, opens and dissolves. Only when asleep,
    //  so the clock does not even run while she is not.
    every 3.6s while asleep { zee: 0 ~16ms; zee: 1 ~3400ms after 40ms }

    //  «One arrives and she is asleep: IT DOES NOT WAKE HER. A drop the colour of
    //  whoever writes forms hanging from the edge above her head, lets go and
    //  sinks into her; a ripple of that colour spreads, the drop on her side
    //  beats and she opens only her right eye towards that drop, closes it and
    //  breathes a little deeper.» Dripping 420 ms + 90 hanging + a 190 in_quad fall.
    pose droplet = 0                   // 0 nothing · 1 hanging · 2 inside
    event sank_in                      // it is already inside
    prop ripple.drip = 0 ~760ms        // the ripple of its colour
    prop eye.r = 0 ~280ms              // and the right eye, only that one
    gesture trickle asked {
        420ms out_quad hold 90ms { droplet: 1 }
        190ms in_quad            { droplet: 2 }
        10ms emit sank_in        { droplet: 2 }
    }
    //  And a deeper breath, just one: it is `reflex`, so it beats the sleeping
    //  posture while it lasts and then hands it back.
    gesture deep_breath reflex {
        900ms in_out_sine { body.y: -1.8 }
        900ms in_out_sine { body.y: 1.2 }
    }
    on sank_in {
        ripple.drip: 0 ~16ms
        ripple.drip: 1 ~760ms after 30ms
        eye.r: 1 ~280ms
        eye.r: 0 ~280ms after 980ms
        play deep_breath
        emit direct
    }

    //  The nod of settling in: she lowers her head, shifts about and stays. The
    //  contract's 1 240 ms, split into three beats.
    gesture nod asked {
        420ms in_out_sine { tilt: 0.05; body.y: 1.6 }
        380ms out_quad    { tilt: -0.02; body.y: 0.8 }
        440ms out_back    { tilt: 0.02; body.y: 1.2 }
    }
    //  And the asleep breathing, which is a POSTURE and not a gesture: it repeats
    //  by itself while it lasts and falls silent when it stops being true,
    //  without anyone starting or stopping it. A 3.6 s cycle, and lighter than
    //  the awake one: 2 px of travel become 1.1.
    //  And the «suspend» nod, which the sheet asks to be slow and with the body
    //  somewhat squashed: 360 ms each way, 0.94 tall. It is not sleeping —she is
    //  not—, it is showing what would happen.
    posture settle while hint == sleep {
        360ms in_out_sine { tilt: 0.05; sy: 0.945; sx: 1.035 }
        360ms in_out_sine { tilt: 0; sy: 1; sx: 1 }
    }
    posture slumber while asleep {
        1800ms in_out_sine { body.y: 0.1 }
        1800ms in_out_sine { body.y: 1.2 }
    }

    // ── the Haven ────────────────────────────────────────────────
    //  Do not disturb, but awake. «Haven does not mean switched off»: she is
    //  still here, attentive, and keeps the notices while you concentrate.
    //
    //  The membrane shares **exactly** her diameter: entering does not enlarge
    //  her silhouette. Below the waterline the pearls are kept, one per category,
    //  and the tide changes its slope slowly —there and back in 7.6 s— without
    //  moving either the body or the pearls.
    fact haven = false
    fact remaining = 0                 // the minutes she has left
    fact glanced = false               // whether she has already looked at this urgency
    event enter_haven
    event leave_haven
    event view_rules ->
    prop calmness = 0 ~320ms           // 0 awake, 1 in the Haven
    prop glance = 0 ~260ms             // the urgency being looked at, without opening anything
    prop drawing = 0 ~320ms            // the wave the bubble draws, once
    prop summary = 0 ~500ms            // on coming back, a single summary
    //  The tide: there and back in 7.6 s. No nervous loops; this is the only
    //  thing that moves, and it moves like water.
    pose tide = 0
    wave tide = 1 at 0.827
    //  Entering takes 320 ms and waking 500: it is not the same journey, so it is
    //  not the same spring. And the wave the membrane drew is undone on leaving,
    //  in the same time she takes to wake up.
    on enter_haven { haven = true; glanced = false; calmness: 1 ~320ms; drawing: 0 ~16ms; drawing: 1 ~320ms after 30ms }
    on leave_haven { haven = false; remaining = 0; calmness: 0 ~500ms; drawing: 0 ~500ms; summary: 1 ~500ms; summary: 0 ~300ms after 4200ms }
    //  And it ends by itself: one minute less every minute, and on reaching zero
    //  she comes out. A «do not disturb» you have to remember to remove stays on
    //  all afternoon, and then it is no longer a haven but a plug.
    every 60s while haven and remaining > 0 { remaining = remaining - 1 }
    on change remaining while haven and remaining < 1 { emit leave_haven }

    //  «Something urgent has arrived»: the logic says so. The face is alarmed
    //  with an exclamation mark and a short jump; the numbers are those of
    //  Marea's `cupo` gesture, times 46/56.
    event urge
    gesture alarm_jump reflex {
        60ms in_quad   { sx: 1.08; sy: 0.90; body.y: 2.5 }
        130ms out_quad { sx: 0.96; sy: 1.06; body.y: -3.3 }
        110ms in_quad  { sx: 1.02; sy: 0.98 }
        180ms
    }
    fact undoable = false
    fact resolved_row = 0              // which row was resolved, to give it back
    event fuse_out
    pose fuse = 1
    gesture burn state {
        5s linear { fuse: 0 }
        10ms emit fuse_out
    }
    on fuse_out { undoable = false }

    //  An urgent one opens the tray without taking the keyboard, and the face is
    //  alarmed: an exclamation mark and a short jump. **Once per episode**, from
    //  the first one until none is left: a notice that jumps every time is a
    //  notice that ends up covered with a window.
    //  The exclamation mark is a REACTION, not a state: it lasts as long as the
    //  fright lasts and goes. What stays «while it lasts» is the amber drop on
    //  her shoulder, which is what it rises for. Before, the face stayed alarmed
    //  until no urgent one was left, and since an unresolved urgent one does not
    //  go away by itself, she kept the «!» on all afternoon.
    //
    //  And «once per episode» can no longer hang from the face, because the face
    //  comes back: its own fact carries it, which is cleared when none is left.
    fact alarmed = false
    //  Quiet: a notice that arrives with `hush` on goes straight to its drop,
    //  as in the Haven —no card, no jump, no tray opening by itself—. The
    //  logic says it for each one: «do not disturb» (which an urgent one gets
    //  through), a recording going on, or the screen locked.
    fact hush = false
    fact dnd = false                   // do not disturb, from Settings or the finder
    fact quiet_rec = true              // and quiet while recording the screen
    fact snooze_k = 1                  // «later» is 0: 15 min · 1: an hour · 2: three hours
    //  The screen being shared (pleamar-wm's portal says so): a coral ring
    //  breathes around her the whole time, and notices come in quietly.
    fact sharing = false
    event sharing_on ->
    event sharing_off ->
    on sharing_on { sharing = true }
    on sharing_off { sharing = false }
    prop share.lit = 0 ~400ms
    follow share.lit = if(sharing, 1, 0)
    prop share.breath = 0
    spin share.breath by if(sharing, 0.3, 0)
    model muted max 6 { app: text }    // the apps whose notices go straight to the history
    event flip_dnd
    event flip_quiet_rec
    event unmute ->
    on flip_dnd { toggle dnd }
    on flip_quiet_rec { toggle quiet_rec }
    on urge while not haven and not hush and not alarmed { alarmed = true; face = alert; sign: 0 ~100ms; play alarm_jump; filter = 0; tray_by_itself = true; emit open_tray }
    on still face for 1.6s while face == alert { face = eye }
    //  In the Haven an allowed urgency **does not open the tray or steal the
    //  focus**: an amber pearl appears over the membrane and only the eye beside
    //  it turns round to look at it. 1.1 s, and back to her own business.
    //  Once per episode, just like the alarmed face: what bothers about an
    //  urgent notice is not the first one, it is the fourth.
    on urge while (haven or hush) and not glanced { glanced = true; glance: 1; glance: 0 ~260ms after 840ms }
    on still any_urgent for 1.6s while not any_urgent { glanced = false; alarmed = false }
    //  What each row is about. The logic would set it; here it is born with something.
    prop tray = 0 ~240ms               // 0 inside her, 1 whole card
    prop lane = 0 ~240ms               // the drops: 0 on her shoulder, 1 in the lane
    //  Each row arrives a little after the one above: that is the swell.
    //  And on resolving it, it goes off to the right and releases a drop that
    //  comes back.
    repeat k in 1..6 {
        fact alive.$k = true
        fact row_cat.$k = 1
        //  An urgent one is not grouped: its own row, at the top and in amber.
        fact row_urgent.$k = false
        prop rise.$k = 0 ~lively
        prop flung.$k = 0 ~220ms
        prop freed.$k = 0 ~380ms
        //  How far the finger has dragged it. If it does not reach the threshold,
        //  it goes back by itself.
        prop pull.$k = 0 ~lively
        prop touch.$k = 0 ~140ms
        //  How many live ones it has above: its place in the list. On resolving
        //  one, the ones below rise to fill the gap instead of leaving it there.
        prop above.$k = 0 ~calm
    }
    //  Which rows show: the live ones, and if there is a filter only its own.
    //  It goes in a one-frame spring because a `let` does not see the facts of
    //  a `repeat`.
    repeat k in 1..6 {
        prop visible.$k = 0 ~16ms
        follow visible.$k = if(alive.$k and (filter < 0.5 or row_cat.$k == filter), 1, 0)
    }
    follow above.1 = if(visible.2 > 0.5 and row_urgent.2 and not row_urgent.1, 1, 0) + if(visible.3 > 0.5 and row_urgent.3 and not row_urgent.1, 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.1, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.1, 1, 0)
    follow above.2 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.2), 1, 0) + if(visible.3 > 0.5 and row_urgent.3 and not row_urgent.2, 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.2, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.2, 1, 0)
    follow above.3 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.3), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.3), 1, 0) + if(visible.4 > 0.5 and row_urgent.4 and not row_urgent.3, 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.3, 1, 0)
    follow above.4 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.4), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.4), 1, 0) + if(visible.3 > 0.5 and (row_urgent.3 or not row_urgent.4), 1, 0) + if(visible.5 > 0.5 and row_urgent.5 and not row_urgent.4, 1, 0)
    follow above.5 = if(visible.1 > 0.5 and (row_urgent.1 or not row_urgent.5), 1, 0) + if(visible.2 > 0.5 and (row_urgent.2 or not row_urgent.5), 1, 0) + if(visible.3 > 0.5 and (row_urgent.3 or not row_urgent.5), 1, 0) + if(visible.4 > 0.5 and (row_urgent.4 or not row_urgent.5), 1, 0)
    follow any_urgent = if(alive.1 and row_urgent.1, 1, 0) + if(alive.2 and row_urgent.2, 1, 0) + if(alive.3 and row_urgent.3, 1, 0) + if(alive.4 and row_urgent.4, 1, 0) + if(alive.5 and row_urgent.5, 1, 0)
    //  Which category the live urgent one belongs to: it is what makes ITS drop
    //  rise to shoulder height and turn amber while it lasts. It goes in props
    //  because a `let` does not see the facts a `repeat` declares.
    repeat k in 1..5 {
        prop cat_urgent.$k = 0 ~16ms
        follow cat_urgent.$k = clamp(if(alive.1 and row_urgent.1 and row_cat.1 == k, 1, 0) + if(alive.2 and row_urgent.2 and row_cat.2 == k, 1, 0) + if(alive.3 and row_urgent.3 and row_cat.3 == k, 1, 0) + if(alive.4 and row_urgent.4 and row_cat.4 == k, 1, 0) + if(alive.5 and row_urgent.5 and row_cat.5 == k, 1, 0), 0, 1)
    }
    prop cat_urgent.any = 0 ~16ms
    follow cat_urgent.any = cat_urgent.1 + cat_urgent.2 + cat_urgent.3 + cat_urgent.4
    fact row_cat.2 = 3
    fact row_cat.3 = 2
    fact row_cat.4 = 4
    fact row_cat.5 = 1
    text row.1.app = "TELEGRAM"
    text row.2.app = "CALENDAR"
    text row.3.app = "MAIL"
    text row.4.app = "SYSTEM"
    text row.5.app = "TELEGRAM"
    text row.1.title = "Ana Ruiz"
    text row.2.title = "Design review"
    text row.3.title = "September invoice"
    text row.4.title = "Backup done"
    text row.5.title = "Building site group"
    text row.1.detail = "Lunch today? I have a table at two"
    text row.2.detail = "in 10 minutes · big room"
    text row.3.detail = "due on the 30th"
    text row.4.detail = "412 files, 2.1 GB"
    text row.5.detail = "6 unread messages"
    text row.1.age = "now"
    text row.2.age = "2 min"
    text row.3.age = "1 h"
    text row.4.age = "3 h"
    text row.5.age = "yesterday"
    prop arrive = 0 ~220ms             // the card, coming in
    //  The arriving card's life, beat by beat: the drop falling from the top
    //  edge and unfolding (land), its words being written (write), how much of
    //  its reading has gone (read.t, which the pointer stops), the chips that
    //  come out under the pointer, the symbol in her eyes, and the pile opening.
    prop land = 0 ~16ms
    prop write = 0 ~16ms
    prop read.t = 0
    spin read.t by if(phase == 1 and not hovered and land > 0.95, 1 / if(burst > 1, 4.2, 3.2), 0)
    prop chips = 0 ~180ms
    follow chips = if(hovered and phase == 1, 1, 0)
    prop sign = 0 ~200ms
    prop pile.open = 0 ~gentle
    follow pile.open = if(hovered and burst > 1 and phase == 1, 1, 0)
    prop urgent.beat = 0
    spin urgent.beat by if(reading_urgent and phase == 1, 1.2, 0)
    fact reading_urgent = false
    fact acts = 0
    fact notice.icon = false
    text act.1 = ""
    text act.2 = ""
    model notice_face max 1 { icon: image 24, 24 }
    event notice_act ->                // a chip of the arriving card: 0 open, 1 done, 2 and 3 its own, 9 the whole pile
    event notice_puff                  // the one in front, done: it vanishes in a puff
    event notice_gone                  // all of them done: the card goes without flying to any count
    //  One per card in the pile: they fly together but not at the same time.
    repeat j in 0..3 { prop fly.$j = 0 ~280ms }
    prop attentive = 0 ~gentle         // looking at the card
    follow attentive = if(phase == 1, 1, 0)

    let blue = #6fb1e6
    let lilac = #a68be4
    let green = #8fd1ae
    let amber = #e3a35c
    //  How many there are of each, and when the last one arrived: they are
    //  declared before the drops because each drop looks at the other three.
    repeat k in 1..5 {
        fact n.$k = 0
        fact last.$k = 0
        //  The drop beats when something of its own falls, and in the Haven its
        //  pearl beats: it is the same blow, because it is the same news told
        //  somewhere else.
        prop beat.$k = 0 ~lively
        //  And the pearl, which appears when something of its category is kept.
        prop pearl.$k = 0 ~320ms
        follow pearl.$k = if(n.$k > 0, 1, 0)
    }
    //  Whether any urgent one is left. While there is, the face stays alarmed.
    prop any_urgent = 0 ~16ms

    //  How many are waiting, of all categories: it is what decides whether
    //  hovering over her brings out the time or the fan. It goes in a `prop`
    //  because a `let` does not see the facts a `repeat` declares —it is
    //  resolved earlier—, and with a one-frame spring so it does not drag.
    prop pending = 0 ~16ms
    follow pending = n.1 + n.2 + n.3 + n.4

    //  The preview. With pending notices, hovering over her opens the drops in a
    //  fan below her, with their category's icon, and shows the most recent one.
    //  **It takes the place of the time note**: either one, or the other.
    prop fan = 0 ~160ms

    //  The time note.
    fact note = false
    event calendar ->                  // a click on it: the logic opens the calendar
    //  What the card asks of the logic. There is no logic here, so they stay
    //  said: the boundary is written, which is what matters.
    event mute_output ->
    event mute_mic ->
    //  And the keyboard's own keys, from the compositor (`marea volume_up`…).
    event volume_up ->
    event volume_down ->
    event bright_up ->
    event bright_down ->
    event play_pause ->
    event previous ->
    event next ->
    event settings ->
    event flip ->                      // with which of the three, as payload
    //  Dragging a level sends WHERE the finger has gone, from 0 to 1. Two events
    //  and not one with the track as payload, because a payload is a number and
    //  here two things are needed: which one and how much.
    event set_brightness ->
    event set_volume ->
    event set_mic ->                   // the microphone's level, 0..1
    event set_rain ->                  // how hard it rains on the windows, 0..1
    event open_page ->                 // with which of the six, as payload
    //  The calendar: 42 days in the grid (six weeks, Monday first), what the
    //  logic says of each one, and the chosen day's events.
    event cal_pick ->                  // a day of the grid, by its place
    event cal_prev ->
    event cal_next ->
    event cal_today ->
    event cal_delete ->                // an event of the chosen day, by its row
    event cal_went_prev
    event cal_went_next
    event cal_added
    event cal_splash
    fact cal.sel = 0                   // which place of the grid is chosen
    text cal.month = ""
    text cal.sel_day = ""
    text cal.sel_title = ""
    text cal.sel_sub = ""
    text cal_new = ""
    text city_q = ""
    model cal_events max 6 { time: text; title: text }
    repeat k in 0..42 {
        fact cal.day.$k = 0
        fact cal.in.$k = false
        fact cal.today.$k = false
        fact cal.n.$k = 0
    }
    repeat w in 1..8 {
        text cal.wd.$w = ""
    }
    //  The agents' reservoirs: two agents (1 Claude Code, 2 Codex; 0 none), up
    //  to three windows each. The logic reads them; the scene draws them.
    event agents_refresh ->
    event agents_read
    fact ag.worst = 101                // the least left of the active windows, in %; 101, unknown
    //  Her face on opening the page: first she reads the water, then says
    //  what she thinks of it.
    fact agents.face: none | reading | verdict = none
    let ag.shown = if(ag.worst > 100, 0.5, ag.worst / 100)
    let ag.tone = mix(mix(mix(#ef7a66, #f0b85a, clamp((ag.worst - 12) / 8, 0, 1)), mint, clamp((ag.worst - 40) / 15, 0, 1)), #8b8f95, ag.worst > 100)
    repeat a in 1..3 {
        fact ag.kind.$a = 0
        text ag.name.$a = ""
        text ag.sub.$a = ""
        repeat l in 1..4 {
            fact ag.on.$a.$l = false
            fact ag.active.$a.$l = false
            fact ag.pending.$a.$l = false
            fact ag.used.$a.$l = -1
            fact ag.elapsed.$a.$l = 0
            text ag.lname.$a.$l = ""
            text ag.lrenew.$a.$l = ""
        }
    }
    repeat k in 1..7 {
        fact switched_on.$k = false
        prop lit.$k = 0 ~180ms
        follow lit.$k = if(switched_on.$k, 1, 0)
    }
    //  And the first one is lit by the network, not by a fact someone has to set.
    follow lit.1 = if(net.online, 1, 0)
    //  And the third one is lit by the Haven: the card does not keep its own
    //  switch, it shows the one there already is. Two truths of the same state
    //  is how you end up with a card switched on and the ball awake.
    follow lit.3 = if(haven, 1, 0)
    prop notecard = 0 ~650ms
    //  And with the menu out neither of the two comes out: they take its place.
    //  Going out it takes its time —it is a division, see below— and it goes
    //  back in quickly: two rules, because the two journeys are not the same.
    let notecard.wants = note and not open and not haven and not menu_open and face == eye and out > 0.9 and phase == 0 and pending < 1
    on change notecard.wants while notecard.wants { notecard: 1 ~700ms }
    on change notecard.wants while not notecard.wants { notecard: 0 ~260ms }
    follow fan = if(note and not open and not tray_open and not haven and not menu_open and face == eye and out > 0.9 and phase == 0 and pending > 0, 1, 0)
    // ── her menu, the right-button one ───────────────────────────
    //  «The right button opens her menu, which closes the same way on leaving
    //  her and the menu.» The house rows —Settings and Customize— and, below a
    //  line, what the add-ons bring, grouped by the name of each one's add-on:
    //  an entry called «History» says whose history it is.
    //  It comes out on the same side as the time and from the same box, because
    //  it is the same thing: what she has to say when you ask her there.
    fact menu_open = false
    fact menu_selected = -1            // the keyboard's row: 0 and 1 the house, 2+ the rest
    fact groups = 0                    // how many add-ons bring something
    event customize ->
    event menu_entry ->                // an add-on's entry, by its number
    event point_at ->
    model entries max 9 { group_name: text; title: text; first: bool = false }
    prop menu = 0 ~190ms
    follow menu = if(menu_open, 1, 0)

    //  And in the Haven, the capsule: it takes the same place as the time.
    prop capsule = 0 ~160ms
    //  It opens in 160 and folds back in 140, which is what the contract asks.
    //  A `follow` does not know which side it comes from, so the ones who say
    //  it are two rules about the same thing: going and coming back are not the
    //  same journey.
    let capsule.wants = note and haven and not menu_open and out > 0.9
    on change capsule.wants while capsule.wants { capsule: 1 ~160ms }
    on change capsule.wants while not capsule.wants { capsule: 0 ~140ms }
    //  The time comes out of her the way a drop divides. First a bud swells on
    //  her side, melted into her (a); then it moves off, and the melting
    //  lessens as it goes, so the neck stretches, thins and snaps (b); and once
    //  free it stretches into the card (c). Going back in, the same in reverse.
    let nc.a = clamp(notecard / 0.3, 0, 1)
    let nc.b = clamp((notecard - 0.3) / 0.3, 0, 1)
    let nc.c = clamp((notecard - 0.6) / 0.4, 0, 1)
    let notecard.x = cx + 12 + 15 * nc.a + 62 * nc.b
    let notecard.w = 28 * nc.a + 76 * nc.c
    let notecard.h = 28 * nc.a + 28 * nc.c
    //  And when it comes loose, both of them wobble.
    on change nc.b > 0.95 while nc.b > 0.95 and notecard.wants { impulse wobble 70 }
    //  The card of a recording just saved: it comes out of her, to her right,
    //  like the time and the capsule, and goes back into her on its own after
    //  ten seconds unless the pointer is on it.
    fact reel_open = false
    fact reel_hovered = false
    text reel.name = ""
    event recorded                     // the logic: a recording has been saved
    event reel_watch ->
    event reel_folder ->
    event reel_copy ->
    prop reel = 0 ~200ms
    follow reel = if(reel_open and out > 0.9, 1, 0)
    let reel.x = cx + (23 + 11 + 150) * reel
    //  Its time is a step, not a slow spring: a 10 s spring kicked back to 0
    //  in 16 ms swung past it and, depending on where it came from, crossed
    //  «ten seconds» less than one second after the card had come out. The step
    //  jumps when its moment comes, and its destination is worked out then: if
    //  the pointer is on the card, it does not jump.
    prop reel_clock = 0 ~16ms
    on recorded { reel_open = true; reel_clock: 0; reel_clock: if(reel_hovered, 0, 1) after 10s }
    on change reel_clock > 0.5 while reel_clock > 0.5 { reel_open = false }

    //  The Haven's capsule and the summary take the same place as the note, and
    //  that is why they are born the same way: from her centre, sliding to the
    //  right until they sit 11 px away. Their half width goes in the sum, as in
    //  the note.
    let capsule.x = cx + (23 + 11 + 104) * capsule
    let summary.x = cx + (23 + 11 + 98) * summary

    prop card = 0 ~290ms
    prop content = 0 ~200ms
    //  Closed, she starts again from the front page. Otherwise the page she was
    //  on stayed chosen with the card folded, and pressing her opened straight
    //  into Settings —or Wi-Fi, or half a confirmation— instead of her control
    //  center. Only once it has finished folding: done on closing, the content
    //  jumped to the front page while it was still shrinking.
    on change card < 0.02 while card < 0.02 and not open { page = none; section = menu; confirming = none }

    //  The level on the face. The system brings the volume: not a single line of
    //  logic, and that is why the panel's slider and the keyboard's key look
    //  exactly the same from here —which is just what the contract asks—.
    prop meter = 0 ~180ms             // 0 face, 1 bar
    prop vol_level = 0 ~quick         // what the bar shows
    prop mic_level = 0 ~quick         // and what the microphone's one shows
    follow mic_level = sound.input
    prop bright_level = 0 ~quick      // and the screen brightness one
    follow bright_level = display.level
    //  And, while it rains on pleamar-wm's windows, how hard: a fourth level
    //  that the other three make room for (the logic says both).
    fact rain_on = false
    fact rain_amount = 1
    prop rain_level = 1 ~quick
    follow rain_level = rain_amount
    prop four = 0 ~quick
    follow four = if(rain_on, 1, 0)

    //  ── what the face can be ────────────────────────────────────
    //  A fact with a type: the compiler checks what it is compared against, so
    //  `face == magnifier` does not get past the first reading.
    fact face: eye | count | camera | rec | alert | happy | angry | reading = eye
    fact left = 0                     // what is left of the countdown
    fact taping = false               // the recorder running FOR REAL

    prop num = 0 ~260ms               // 0 face, 1 number
    prop cam = 0 ~220ms               // 0 face, 1 camera
    prop dot = 0 ~260ms               // 0 face, 1 disc
    prop alarm = 0 ~180ms             // 0 face, 1 exclamation mark
    prop joy = 0 ~lively              // 0 face, 1 happy: «^ ^»
    prop fury = 0 ~quick              // 0 face, 1 angry: frowning, reddening
    //  Her skin: coal, reddening when she is angry. The face's holes are cut
    //  with it too, or they would show as dark patches on a red face.
    let skin = mix(coal, #4a1616, fury * 0.75)
    prop red = 0 ~200ms               // the red, which is something other than the disc
    prop pop = 0 ~lively              // the countdown's bounce

    //  Each state is a spring that follows its fact. That is why one can
    //  interrupt another halfway and the only thing that happens is that the
    //  shape bends: there are no two animations fighting over the same eyes.
    follow num = if(face == count, 1, 0)
    follow cam = if(face == camera, 1, 0)
    //  In the corner she films with a camera of her own (see the nook), not
    //  with a red eye: the disc is only for recording anywhere else.
    follow dot = if(face == rec and not corner, 1, 0)
    follow alarm = if(face == alert, 1, 0)
    follow joy = if(face == happy, 1, 0)
    //  Reading water —the agents' tubes—: each eye a little wave, «~ ~», that
    //  flows while she reads. The wave only runs with that face on.
    prop eyewave = 0 ~240ms
    //  Telling the time: while the note comes out, her eyes turn into the
    //  hands of a clock for a moment and sweep from twelve to the hour.
    prop hands = 0 ~220ms
    prop hand.h = 0 ~lively
    prop hand.m = 0 ~lively
    on change notecard.wants while notecard.wants {
        hands: 1 ~220ms; hands: 0 ~300ms after 1600ms
        hand.h: 0 ~16ms; hand.m: 0 ~16ms
        hand.h: (mod(now.hour, 12) + now.minute / 60) * 30 ~lively after 120ms
        hand.m: now.minute * 6 ~lively after 120ms
    }
    on change notecard.wants while not notecard.wants { hands: 0 ~150ms }
    follow eyewave = if(face == reading, 1, 0)
    prop eyewave.phase = 0
    spin eyewave.phase by if(face == reading, 1.3, 0)
    follow fury = if(face == angry, 1, 0)
    follow red = if(taping, 1, 0)

    // ── living rest ──────────────────────────────────────────────
    //  A brief blink, every 5.2 s. And the gaze, which follows the mouse closely.
    blink lid every 5.2s for 120ms
    //  And now and then, with the mouse far from her —over a window, on the
    //  other monitor—, a glance at where it is, and back. When, the logic says
    //  (`glancing`): every so often, never on a beat. Asleep, she does not look.
    fact glancing = false
    prop mouse.glance = 0 ~gentle
    follow mouse.glance = if(glancing and not asleep, 1, 0)
    let mouse.glance.d = max(length(cursor.x - cx, cursor.y - cy), 1)
    look gaze.x, gaze.y at cx, cy reach 6, 3.5 within 260 rest mouse.glance * 6 * (cursor.x - cx) / mouse.glance.d, mouse.glance * 3.5 * (cursor.y - cy) / mouse.glance.d

    //  Marea's breath. Ambient: any other gesture cuts it off.
    gesture breathe ambient {
        //  The eyes look first: it is what makes it look like hers and not a tic.
        220ms in_out_sine        { look.y: -1.2 }
        //  The body rises two pixels, not one more.
        320ms out_quad           { body.y: -2; look.y: -0.6 }
        //  And she blinks fully while she is up.
        180ms in_out_sine        { lid: 0; body.y: -2 }
        200ms in_out_sine        { lid: 1; body.y: -1.4 }
        //  She settles with a minimal asymmetry, and goes back to neutral.
        380ms out_back           { tilt: 0.012 }
    }
    every 12s..24s { play breathe }

    //  The start: she jumps 8 px without anticipation, with her eyes wide open,
    //  lands elastically and bounces briefly. Marea's numbers, times 46/56.
    gesture startle reflex {
        75ms out_cubic            { eyes: 16.4; sx: 0.90; sy: 1.13; body.y: -2.5 }
        105ms out_quad hold 90ms  { eyes: 16.4; sx: 0.98; sy: 1.04; body.y: -6.6 }
        145ms in_quad             { eyes: 14.8; sx: 0.96; sy: 1.06 }
        100ms out_quad            { eyes: 14.8; sx: 1.10; sy: 0.82; body.y: 3.3 }
        130ms out_quad            { eyes: 14; sx: 0.98; sy: 1.04; body.y: -2.5; tilt: 0.07 }
        120ms                     { eyes: 14; sx: 1.02; sy: 0.96; body.y: 0.8; tilt: 0.05 }
        160ms hold 100ms          { eyes: 14; tilt: 0.05 }
        200ms
    }

    // ── celebrating ──────────────────────────────────────────────
    //  `./marea celebrate`: she comes out, beams —«^ ^»— and hops for joy, and
    //  seven rockets leave her in a fan and burst around her. It is a test of
    //  pleamar's particles as much as a party: nothing here is stored per
    //  spark, every one is worked out on the card.
    event celebrate
    fact celebrating = false
    gesture cheer reflex {
        90ms out_quad            { sx: 1.10; sy: 0.88; body.y: 3 }
        160ms out_quad           { sx: 0.94; sy: 1.10; body.y: -9; eyes: 14 }
        140ms in_quad            { sx: 1.06; sy: 0.92; body.y: 1 }
        150ms out_quad           { sx: 0.97; sy: 1.05; body.y: -6; tilt: 0.06 }
        130ms in_quad            { sx: 1.04; sy: 0.95; body.y: 0.5; tilt: -0.04 }
        180ms out_back
    }
    //  Awake first: asleep, her eyes are two thin strokes, and a face made on
    //  top of them has no eyes.
    on celebrate { celebrating = true; face = happy; asleep = false; play cheer }
    on still celebrating for 4.2s while celebrating { celebrating = false; face = eye }

    // ── the adventure ────────────────────────────────────────────
    //  `./marea adventure`: she lets go of the top edge, falls to the bottom of
    //  the screen, hops along it, grows wings and flies back up home. Her
    //  surface only reaches 680 px down, so the journey happens in a surface of
    //  its own the size of the whole monitor, open only while it lasts; where
    //  she lives, meanwhile, she is `away`. All of it is ONE gesture: a timeline
    //  with its curves —the fall speeds up like gravity, each hop slows at the
    //  top and speeds up coming down—, so it has weight and is written in one
    //  place.
    event adventure
    event adventure_done
    fact adventuring = false
    fact adv_screen = 0
    pose adv.fx = 0                    // across the bottom: −1 left edge, 1 right edge
    pose adv.fy = 0                    // 0 at home, 1 on the bottom edge
    //  The hops are not keyframed one by one: `adv.p` runs linearly from one
    //  hop to the next (1 is the end of the first, 3 of the third) while
    //  `adv.fx` runs linearly across the floor, and each hop's arc, squash and
    //  stretch are worked out from where in its hop she is. Keyframed —up
    //  slowing, down speeding— the curve applied to the sideways movement too,
    //  so she stopped dead at every top and every landing, and it looked like
    //  too few frames.
    pose adv.p = 0                     // which hop and how far into it
    pose hopping = 0                   // 1 while hopping: arcs, squashes and dust
    pose hop.amp = 70                  // how high the hops go
    pose wing = 0                      // 0 none, 1 wings out
    gesture journey state {
        //  Letting go: the water holds her, stretching, and lets go.
        450ms in_out_sine        { adv.fy: 0.02; sx: 0.88; sy: 1.16 }
        //  The fall, speeding up, stretched.
        950ms in_quad            { adv.fy: 1; sx: 0.86; sy: 1.2 }
        //  Splat, back into shape, and a breath.
        120ms out_quad           { adv.fy: 1; sx: 1.3; sy: 0.72 }
        450ms out_back           { adv.fy: 1; hop.amp: 70 }
        300ms                    { adv.fy: 1; hop.amp: 70 }
        //  Three hops to the right, at an even, unhurried pace.
        2400ms linear            { adv.fy: 1; adv.p: 3; adv.fx: 0.72; hopping: 1; hop.amp: 70 }
        //  And a big one to turn back, leaning into it.
        950ms linear             { adv.fy: 1; adv.p: 4; adv.fx: 0.3; hopping: 1; hop.amp: 130; tilt: -0.14 }
        250ms out_quad           { adv.fy: 1; adv.p: 4; adv.fx: 0.3 }
        //  Wings, still on the ground, and a moment to gather herself.
        550ms out_back           { adv.fy: 1; adv.p: 4; adv.fx: 0.3; wing: 1 }
        300ms in_out_sine hold 200ms { adv.fy: 1; adv.p: 4; adv.fx: 0.3; wing: 1; sx: 1.12; sy: 0.88 }
        //  And up, home, gently.
        2600ms in_out_sine       { adv.fy: 0; adv.fx: 0; wing: 1; sx: 0.95; sy: 1.05 }
        450ms out_quad           { adv.fy: 0; adv.fx: 0 }
        30ms emit adventure_done { adv.fy: 0; adv.fx: 0 }
    }
    on adventure {
        //  Its own purpose: `away` for more than 2.5 s with the default one (`shot`)
        //  is a shot whose frame never came, and it brought her back home —while
        //  she was still out on her adventure, so there were two of her—.
        adventuring = true; asleep = false; face = happy; purpose = adventure
        adv_screen = if(hosts.1, 1, 0)
        away: 1 ~16ms
        play journey
    }
    on adventure_done { adventuring = false; face = eye; away: 0 ~16ms }

    // ── angry ────────────────────────────────────────────────────
    //  `./marea rage`: she frowns, reddens, pulls out a pistol and shoots the
    //  screen five times; the glass cracks where each one lands, and the shards
    //  bend what is behind it. Then the glass fades, she puts it away and calms
    //  down. A test of how far a scene can go: angry face, a drawn pistol that
    //  aims and recoils, muzzle flashes and tracers made of particles, and a
    //  shader of its own that breaks the screen.
    event rage
    fact raging = false
    pose kick = 0                      // the pistol's recoil
    gesture recoil reflex {
        40ms out_quad            { kick: 1; body.y: -2.5; sx: 1.06; sy: 0.95 }
        170ms out_quad           { kick: 0 }
        120ms
    }
    prop gun = 0 ~lively
    prop fade = 0 ~900ms               // the broken glass, all of it
    prop flash = 0 ~16ms
    //  The gunslinger's part: the spin as it comes out and goes back —two whole
    //  turns round her finger, slowing into the aim—, the glare before
    //  shooting, and blowing the smoke off the barrel at the end.
    prop gun.twirl = 0 ~800ms
    prop glare = 0 ~200ms
    prop blow = 0 ~350ms
    prop calm = 0 ~16ms
    //  Each shot, a step at its moment; each hole, how far it has cracked.
    prop shot.1 = 0 ~16ms
    prop crack.1 = 0 ~300ms
    prop shot.2 = 0 ~16ms
    prop crack.2 = 0 ~300ms
    prop shot.3 = 0 ~16ms
    prop crack.3 = 0 ~300ms
    prop shot.4 = 0 ~16ms
    prop crack.4 = 0 ~300ms
    prop shot.5 = 0 ~16ms
    prop crack.5 = 0 ~300ms
    on rage {
        raging = true; face = angry; asleep = false
        fade: 1 ~16ms; calm: 0
        shot.1: 0; shot.2: 0; shot.3: 0; shot.4: 0; shot.5: 0
        crack.1: 0 ~16ms; crack.2: 0 ~16ms; crack.3: 0 ~16ms; crack.4: 0 ~16ms; crack.5: 0 ~16ms
        //  Out, spinning into the aim.
        gun.twirl: 0 ~16ms; gun.twirl: 1 ~800ms after 200ms
        gun: 1 ~lively after 200ms
        //  The glare: looking at you, narrowed, before the first shot.
        glare: 1 ~220ms after 1050ms
        glare: 0 ~200ms after 1950ms
        shot.1: 1 after 2000ms
        shot.2: 1 after 2450ms
        shot.3: 1 after 2800ms
        shot.4: 1 after 3350ms
        shot.5: 1 after 3700ms
        //  Blowing the smoke off, and back in, spinning.
        blow: 1 ~350ms after 4250ms
        blow: 0 ~300ms after 5500ms
        gun.twirl: 0 ~700ms after 5650ms
        gun: 0 ~260ms after 6000ms
        calm: 1 after 6350ms
    }
    on change calm > 0.5 while calm > 0.5 and raging { raging = false; face = eye; fade: 0 ~900ms }
    //  The gulp, when the drop reaches her shoulder.
    gesture gulp reflex {
        90ms out_quad   { sx: 1.06; sy: 0.94; body.y: 1 }
        180ms out_back
    }

    //  And with something of hers open she is out, however it was opened.
    //  Only a press on her set `needed`: a card opened from the finder, a
    //  shortcut or the logic came out of a ball that was still sunk for the
    //  face, and her eyes sat 4.5 px low in it.
    follow out = if(hidden and not needed and not open and not tray_open and not celebrating and not reel_open and not raging and not adventuring, 0, 1)

    // ── the photograph ───────────────────────────────────────────
    //  She does not switch off all at once before the screen freezes: she
    //  anticipates for 70 ms, stretches and LEAVES by the top edge in 150. The
    //  numbers are Marea's, times 46/56; the last one rises more than there
    //  because this surface does not hide: here it is she who has to end up
    //  completely outside.
    event snap                         // someone asks for a photo
    event gone ->                      // she is no longer in the frame: the logic freezes NOW
    //  What is photographed. All three come in by keyboard —`pleamar --say marea
    //  "emit shot_region"`— and do the same until there is a photo: what changes
    //  is where the crop comes from.
    fact scope: region | display | active_window = region
    event shot_region                  // Print · SUPER+C
    event shot_screen                  // SHIFT+Print
    event shot_window                  // CTRL+Print
    event frozen                       // the logic: I have the frame, you can come back
    event shot_cancelled               // Esc while framing: there is no photo, and it does not fire
    prop away = 0 ~quick               // 1 while she waits up there, out of sight

    gesture retire state {
        70ms out_quad           { eyes: 14.8; sx: 0.94; sy: 1.12; body.y: -3.3 }
        150ms in_cubic          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
        //  `emit` sounds at the START of its frame, so it goes in one of its own:
        //  the «I'm no longer here» notice has to arrive when she is no longer
        //  there.
        30ms emit gone          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
    }
    //  She leaves the same way for two things, and on reaching the top she does
    //  one or the other.
    fact purpose: shot | nook | travel | adventure | ride = shot
    on shot_region { scope = region; emit snap }
    on shot_screen { scope = display; emit snap }
    on shot_window { scope = active_window; emit snap }
    //  And whatever was open is folded away: a half-closed panel in the photo is
    //  the only thing she can spoil.
    on snap { purpose = shot; open = false; page = none; tray_open = false; searching = false; menu_open = false; play retire }

    //  The shot. The shutter is a pose and the click a gesture: it closes in 80,
    //  holds, opens in 170 —Marea's timings— and gives the face back. And a
    //  minimal recoil of the body on closing, which is not there: a camera that
    //  fires without moving is an icon, not a camera.
    event shoot
    event taken
    gesture click state {
        80ms out_quad hold 10ms  { shut: 1; sx: 1.05; sy: 0.95 }
        170ms out_back           { shut: 0 }
        120ms
        10ms emit taken
    }
    on shoot while face == camera { play click }
    //  And whatever happened, the camera does not stay on her face.
    on still face for 20s while face == camera { face = eye }
    on taken { face = eye }
    //  Once out, she stays out —the gesture puts the pose back at its base, and
    //  without this she would drop back in the same frame— and changes face
    //  where nobody sees her. 200 ms of margin, which is what the compositor
    //  takes to remove the layer: they are measured in Marea, with 90 a ghost of
    //  her came out in the photo.
    //  And she comes back falling with a lively spring, which bounces a hair on
    //  landing: she does not «appear» with the camera on, she returns.
    //
    //  She comes back when the logic says the frame IS ALREADY frozen, not after
    //  220 ms of clock: freezing two monitors takes whatever it takes, and coming
    //  back earlier meant being in the photo. What is framed afterwards is that
    //  photo —it is cropped from it, not from the live desktop—, so while you
    //  choose she can already be in front: nothing she does gets into an image
    //  that already exists.
    on gone while purpose == shot {
        away: 1 ~16ms
        face = camera
    }
    on frozen { away: 0 ~lively }
    on shot_cancelled { away: 0 ~lively; face = eye }
    //  Riding a window, in pleamar-wm's session: she leaves by the top edge the
    //  same way, and the window manager, which knows where every window is on
    //  every frame, draws her on the title bar of the one with the keyboard.
    //  When she comes back —her window closed, put away, shaken, or she was
    //  pressed— it says so, and she drops back into her island.
    event ride_out
    event ride_back ->
    on ride_out { purpose = ride; asleep = false; open = false; page = none; tray_open = false; searching = false; menu_open = false; play retire }
    on gone while purpose == ride { away: 1 ~16ms }
    on ride_back { away: 0 ~lively; face = eye; purpose = shot }
    //  And if the logic did not answer, she does not stay up there forever.
    on still away for 2.5s while away > 0.5 and purpose == shot { away: 0 ~lively; face = eye }

    // ── the journey to the other monitor ─────────────────────────
    //  The leap: she gathers herself —squashed, eyes narrowed—, pushes off and
    //  shoots up through the edge, stretched like a drop. 120 px is more than she needs to be gone even tucked in and
    //  stretched. `gone` in a frame of its own, as in `retire`: the copy swap
    //  has to happen when she is no longer seen.
    gesture leap state {
        110ms out_quad hold 40ms { eyes: 10.5; sx: 1.14; sy: 0.84; body.y: 5 }
        70ms out_quad            { eyes: 14.8; sx: 0.92; sy: 1.14; body.y: -6 }
        180ms in_cubic           { eyes: 13.1; sx: 0.72; sy: 1.40; body.y: -120 }
        30ms emit gone           { eyes: 13.1; sx: 0.72; sy: 1.40; body.y: -120 }
    }
    //  The landing: she squashes on touching, rebounds with her eyes wide open
    //  —where am I?— and settles.
    gesture land reflex {
        70ms out_quad            { eyes: 11; sx: 1.16; sy: 0.82; body.y: 4 }
        150ms out_back           { eyes: 15.5; sx: 0.95; sy: 1.06; body.y: -2 }
        140ms in_out_sine        { eyes: 14; sx: 1.02; sy: 0.98 }
        160ms
    }
    //  She is where she should not be: the copy that shows her is not the one
    //  that hosts her. Not «hosts changed»: the logic sets the two facts one
    //  after the other, sometimes a hundred milliseconds apart, and each one
    //  fired its own leap —the second one waited for the first and she fell
    //  twice—. This fires once, and only when she is not already on her way;
    //  if the focus moved again mid-journey, on landing she is misplaced again
    //  and leaves again, cleanly, instead of changing course in the air.
    //  Whatever she had open is folded away: she cannot carry a card through
    //  the water.
    fact travelling = false
    //  Not while she is in her recording corner: moving the focus mid-recording
    //  must not pull her out of it. She travels when she comes back.
    //  Nor in the middle of a photo —framing it, the pointer may well cross to
    //  the other monitor; leaping then, the click that ends the photo cut her
    //  leap short, and she stayed with the camera on and never travelled
    //  again—, nor while she is out riding a window. She travels afterwards.
    let misplaced = abs(if(hosts.0, 1, 0) - swim.0) + abs(if(hosts.1, 1, 0) - swim.1) > 0.5 and not travelling and not corner and face != camera and purpose != ride
    on change misplaced while misplaced {
        purpose = travel
        travelling = true
        open = false; page = none; tray_open = false; searching = false; menu_open = false
        splashing: 1 ~16ms
        play leap
    }
    //  And if she is still where she should not be a moment later —a leap cut
    //  short by something else, a change that came while she could not go—,
    //  she goes then: a rule that waits for a change never sees one that
    //  stays.
    on still misplaced for 1500ms while misplaced {
        purpose = travel
        travelling = true
        open = false; page = none; tray_open = false; searching = false; menu_open = false
        splashing: 1 ~16ms
        play leap
    }
    //  Gone. The pose snaps back to its base when the gesture ends, so in the
    //  same frame she is sent up there, out of sight, in both copies. The one
    //  she goes to opens now, while she is still above it; the one she left
    //  stays open a moment longer so the water is seen closing over her. Then
    //  she falls, with the spring that overshoots a hair: that overshoot is her
    //  sinking into the landing.
    on gone while purpose == travel {
        drop_in: 1 ~16ms
        impulse bounce -110
        impulse wobble -90
        ripple: 0 ~16ms
        ripple: 1 ~760ms after 30ms
        swim.0: if(hosts.0, 1, swim.0) ~16ms
        swim.1: if(hosts.1, 1, swim.1) ~16ms
        swim.0: if(hosts.0, 1, 0) ~16ms after 60ms
        swim.1: if(hosts.1, 1, 0) ~16ms after 60ms
        drop_in: 0 ~homing after 70ms
        splashing: 0 ~400ms after 1300ms
    }
    //  Coming through the edge: the thread breaks, as when she comes out of her
    //  nook —the surface gives its tug, she shakes round, the ripple runs—.
    on change drop_in < 0.62 while drop_in < 0.62 and travelling {
        impulse bounce -150
        impulse wobble -340
        ripple: 0 ~16ms
        ripple: 1 ~900ms after 30ms
    }
    //  And touching down.
    on change drop_in < 0.04 while drop_in < 0.04 and travelling {
        travelling = false
        play land
    }
    //  A journey takes a second and a half; one that has not landed in four
    //  was cut short, and it is not a journey any more.
    on still travelling for 4s while travelling { travelling = false }

    //  Sunk, she peeks out somewhat less than half; separated, she hangs at her
    //  own height.
    //  How far she tucks in. The contract says «somewhat less than half», and
    //  with that the top edge of the eye fell 1.25 px ABOVE the edge of the
    //  screen: you saw her eye cut off at the bottom. She peeks out 29 of 46,
    //  which is almost two thirds, and you see her face. It is a deliberate
    //  deviation from the contract.
    let rise = if(hidden, (1 - out) * 40, 0)
    //  And on opening the tray she rises 5 px, which is what the contract says.
    let cy_actual = cy + body.y - rise - away * 84 - 5 * tray - 96 * drop_in
    //  The finder: 640 wide —the sheet's 780 times 46/56— and as tall as its list
    //  asks, which is what makes it grow and shrink while you type instead of
    //  leaving a black gap waiting.
    prop finder_h = 150 ~quick
    prop sel_y = 0 ~quick
    prop stagger = 0 ~520ms            // the list's staggering
    fact typing = false
    event list_ready                   // the logic has left another list
    //  Each row comes in a little after the one above, with ONE single spring:
    //  `stagger` goes from 0 to 1 and each one uses it with its index subtracted.
    //  It is the same thing the tray's swell does, and for the same reason: a
    //  list that appears whole all at once is a table, not something arriving.
    on list_ready { stagger: 0 ~16ms; stagger: 1 ~520ms after 30ms }
    let finder.w = 640 * finder
    let finder.h = finder_h * finder
    let finder.x = cx + 6 + finder.w / 2
    let finder.y = cy_actual + finder.h / 2 - 8
    //  How much panel there is out: the card, the tray or the finder. It is what
    //  takes her halo from light to shadow.
    let panel = clamp(max(max(card, tray), finder) * 2, 0, 1)
    //  The capsule, 12 px lower than her: it measures 92 tall and, centred on
    //  her centre, it stuck out through the top edge.
    let capsule.y = cy_actual + 12
    //  And the saved recording's card, a little lower still.
    let reel.y = cy_actual + 16
    //  The menu: 163 wide —the sheet's 248 times 46/70— and as tall as whatever
    //  there is asks. Each entry measures 23 and the first of each group takes
    //  16 more for the name of whoever brings it.
    //  It is born from her centre and slides to the right until it sits 9 px
    //  away, like the time: its half width goes in the sum.
    let menu.x = cx + (23 + 9 + 82) * menu
    let menu.w = 163
    let menu.h = 8 + 92 + 6 + entries.count * 23 + groups * 16
    //  Its first row at the height of her face, and the rest hanging.
    let menu.y0 = cy_actual - 15
    let menu.cy = menu.y0 + menu.h / 2

    //  And she leans towards where she is going. Nobody leads it by the hand: it
    //  comes from the VELOCITY of her own spring, so she leans on setting off,
    //  straightens on arriving, and does it the same going as coming back.
    prop lean = 0 ~quick
    follow lean = clamp(vel(offset) * -2.6, -8, 8)

    //  The neck: minimal at rest and maximal halfway through the separation,
    //  which is a bell. At the end nothing is left and the thread breaks by
    //  itself.
    let neck = 30 * 4 * out * (1 - out) * if(hidden, 1, 0)

    //  And the water is not a still sheet. While it holds her it stretches
    //  towards her, and when the thread breaks the surface goes up all at once
    //  and bounces a couple of times before lying flat. That is what makes it
    //  read as water and not as a curtain with a hole.
    //  A spring of its own, with little braking: the water does not keep still
    //  at the first try. 420 and 13 are a quarter of a second of period and two
    //  bounces you can see.
    //  The return to her place: a spring less braked than the card's, which
    //  arrives overshooting a hair and settles. It is what makes her «come back»
    //  instead of «appear there again».
    spring homing = 165, 16
    spring splash = 420, 13
    prop bounce = 0 ~splash
    //  A bell, like the neck: flat when stuck to the edge, most stretched halfway
    //  through the journey, flat again once it has let her go.
    let tension = 4 * out * (1 - out)
    let sag = max((16 * tension + bounce) * wet, 0.3)
    //  The thread breaks near the end —by then the gap can overcome the neck—,
    //  and that is when the surface gives the tug.
    //  And the ripple that goes away: from the place she came out of, two bumps
    //  come out and run along the sheet, shrinking. The tug is only felt where
    //  she was; this is what tells that the whole surface is water.
    prop ripple = 1 ~900ms
    let ripple.x = 10 + 48 * ripple
    //  It rises in the first span and fades away: a ripple is seen once it has
    //  separated from the place where it was born, not on top of it.
    let ripple.h = 12 * (1 - ripple) * clamp(ripple * 6, 0, 1) * wet
    //  And the drop that stays: when the thread breaks, a little of her does not
    //  go with her. It hangs from the edge for a moment and the water swallows it.
    prop stray_drop = 0 ~520ms
    //  And SHE is the drop. Hanging from the edge she stretches —the surface pulls
    //  at her and sharpens her—, and on letting go she shakes until she is round
    //  again, as a real drop does when it comes loose. This is what is really
    //  seen: it is 46 px wobbling, not 12 of edge.
    prop wobble = 0 ~splash
    let stretch = tension * 0.11 * if(hidden, 1, 0)
    let droop = stretch + wobble * 0.012
    let stray_drop.r = 5.5 * stray_drop * if(hidden, 1, 0)
    on change out > 0.84 while out > 0.84 and hidden {
        impulse bounce -150
        impulse wobble -340
        ripple: 0 ~16ms
        ripple: 1 ~900ms after 30ms
        stray_drop: 1 ~16ms
        stray_drop: 0 ~520ms after 60ms
    }
    //  And the other way round: when she comes back, the water grabs her before
    //  swallowing her. It pulls her upwards —she sharpens— and the surface sinks
    //  around her.
    on change out < 0.84 while out < 0.84 and hidden {
        impulse wobble 190
        impulse bounce 40
    }
    //  And when she has just gone in, the surface **closes over her**: it sinks
    //  for a moment where she was and from there comes the same ripple that comes
    //  out when the thread breaks, running along the sheet. Before, coming back
    //  was the only thing that happened without the water noticing: she came
    //  out with two bounces, a ripple and a drop, and went in silently. Leaving
    //  shows too.
    on change out < 0.06 while out < 0.06 and hidden {
        impulse bounce -110
        impulse wobble -90
        ripple: 0 ~16ms
        ripple: 1 ~760ms after 30ms
    }

    // ── the body ──────────────────────────────────────────────────
    //  The water at the edge and the ball are one single silhouette: the neck is
    //  not drawn, it comes from melting them together. That is why it thins and
    //  breaks without anyone computing it, and why it is concave.
    body {
        color: skin
        rim: 14%
        glass: glassiness
        lens: bends
        //  Her glass catches the light from wherever the mouse is.
        shine: cursor.x, cursor.y
        //  No shadow and no halo when she is alone. What separates her from the
        //  desktop is her own rim, which is light INSIDE her silhouette: it paints
        //  nothing outside her, so there is no black ring or green glow around.
        //  On a dark background it is what draws her, and on a light one nothing
        //  is needed.
        //
        //  A shadow, yes, but only when a panel comes out of her: a 390 × 410
        //  card floating over the windows needs to say it is on top. Everything
        //  about a shadow is a computation, so it appears with the card and goes
        //  away with it.
        shadow: 0, 2 * panel, 12 * panel, 32% * panel, #05070a
        box water { from: cx - 70, -70; size: 140, 70 * wet }
        //  The bulge the water makes around her: it is the same sheet, stretching.
        //  Melted with her and with the ball, so the three are one silhouette and
        //  the neck comes from the distances, not from drawing a neck.
        //  The melting goes away with the bulge: otherwise, a half-pixel bulge kept
        //  bulging the sheet and left a mole on the edge once she was already loose.
        ellipse tether { at: cx, 0; radius: 30; scale: 1, sag / 30; blend: 16 * clamp(sag / 6, 0, 1) }
        ellipse crest.l { at: cx - ripple.x, 0; radius: 9; scale: 1, ripple.h / 9; blend: 8 * clamp(ripple.h / 3, 0, 1) }
        ellipse crest.r { at: cx + ripple.x, 0; radius: 9; scale: 1, ripple.h / 9; blend: 8 * clamp(ripple.h / 3, 0, 1) }
        ellipse drop_behind { at: cx, stray_drop.r * 0.7; radius: stray_drop.r; blend: 7 * clamp(stray_drop.r / 3, 0, 1) }
        ellipse body_shape {
            at: cx, cy_actual
            radius: r
            rotate: tilt + lean
            scale: (sx + press * 0.04) * (1 - droop) * (1 - fall.stretch * 0.5), (sy - press * 0.05) * (1 + droop) * (1 + fall.stretch)
            //  Going through the edge on a journey, she melts with the water:
            //  it swallows her with a neck, and lets her go with one.
            blend: max(neck, 18 * splashing)
        }
        //  The time note, which comes out from BEHIND her: it is born at her
        //  centre with zero width and slides to the right until it sits 14 px
        //  away, with its neck halfway. It is part of the same body, so the shadow
        //  is a single one and so is the edge.
        //  The tray **sprouts from her**: it is not a card that appears beside
        //  her, it is her own body stretched. It goes in this same `body`, so they
        //  share silhouette, shadow and rim, and between the two there is a neck
        //  nobody draws: it comes from melting them, like the one at the water's
        //  edge.
        box tray_box {
            at: tray.x, tray.y
            size: tray.w, tray.h
            corner: 22 * tray
            blend: 30 * 4 * tray * (1 - tray) + 24 * tray
        }
        //  And the control center the same: it sprouts from her with its neck,
        //  and when it is open it stays joined by a fillet. A panel that appears
        //  beside her is a panel; this is her, stretched.
        box card_box {
            at: card.x, card.y
            size: card.w, card.h
            corner: card.corner
            blend: 30 * 4 * card * (1 - card) + 24 * card
        }
        box notecard_box {
            at: notecard.x, cy_actual
            size: notecard.w, notecard.h
            corner: 14 - nc.c
            blend: 16 * (1 - nc.b)
        }
        //  The Haven's capsule, the same: it is what she says when you ask her by
        //  hovering over her, so it comes out from where the time comes out and in
        //  the same way. A capsule that appears beside her would be something
        //  else, put there.
        box capsule_box {
            at: capsule.x, capsule.y
            size: 208 * clamp(capsule * 1.6, 0, 1), 92 * clamp(capsule * 2.4, 0, 1)
            corner: 16
            blend: 18 * 4 * capsule * (1 - capsule)
        }
        //  And the saved recording's card, the same way.
        box reel_box {
            at: reel.x, reel.y
            size: 300 * clamp(reel * 1.6, 0, 1), 96 * clamp(reel * 2.4, 0, 1)
            corner: 16
            blend: 18 * 4 * reel * (1 - reel)
        }
        //  The finder, which also comes out of her: it is the same as always, one
        //  more box in her body with its neck.
        box finder_box {
            at: finder.x, finder.y
            size: finder.w, finder.h
            corner: max(22 * finder, min(finder.w, finder.h) / 2 * (1 - finder))
            blend: 30 * 4 * finder * (1 - finder) + 24 * finder
        }
        //  And her menu, on the same side and from the same box as the time: «in
        //  the same place where the clock note comes out and in the same box».
        box menu_box {
            at: menu.x, menu.cy
            size: menu.w * clamp(menu * 1.6, 0, 1), menu.h * clamp(menu * 2.4, 0, 1)
            corner: 9
            blend: 18 * 4 * menu * (1 - menu)
        }
        //  And the summary on coming back: the last thing the Haven does is give
        //  back what it kept, and it gives it back coming out of her.
        box summary_box {
            at: summary.x, cy_actual
            size: 196 * clamp(summary * 1.6, 0, 1), 40 * clamp(summary * 2.4, 0, 1)
            corner: 20
            blend: 18 * 4 * summary * (1 - summary)
        }
    }

    //  Its sky: the one outside at this hour. Night blue, the warm band of
    //  dawn and dusk, day blue; a sun or a moon crossing a small arc on its
    //  right side, and stars when it is dark. Over the body, clipped to the
    //  card, and only once it is a card.
    //
    //  And the weather where you are (her sky: the logic asks Open-Meteo every
    //  quarter of an hour for the city chosen in the calendar): clouds that
    //  melt into each other and hide the sun, rain slanting, snow drifting,
    //  fog in bands, lightning now and then; the sky greyer the more it is
    //  covered, warmer with heat and paler with cold; and the temperature.
    fact wx.ok = false
    fact wx.temp = 0
    fact wx.hi = 0
    fact wx.lo = 0
    fact wx.cloud = 0
    fact wx.rain = 0
    fact wx.snow = 0
    fact wx.fog = 0
    fact wx.storm = 0
    text wx.place = ""
    text wx.summary = ""
    fact sky.editing = false
    //  A storm there: now and then, lightning in the card.
    prop bolt = 0 ~60ms
    every 6.5s while wx.storm > 0.5 and notecard > 0.9 { bolt: 1 ~40ms; bolt: 0 ~520ms after 90ms }
    let wx.gloom = clamp(max(max(wx.cloud * 0.55, wx.rain * 0.85), max(max(wx.snow * 0.5, wx.fog * 0.7), wx.storm)), 0, 1) * if(wx.ok, 1, 0)
    let wx.heat = clamp((wx.temp - 26) / 10, 0, 1) * if(wx.ok, 1, 0)
    let wx.cold = clamp((6 - wx.temp) / 12, 0, 1) * if(wx.ok, 1, 0)
    let sky.t = now.hour + now.minute / 60
    let sky.day = clamp((sky.t - 6) / 2, 0, 1) * clamp((19 - sky.t) / 2, 0, 1)
    let sky.warm = clamp(1 - abs(sky.t - 7) / 1.5, 0, 1) + clamp(1 - abs(sky.t - 19.5) / 1.5, 0, 1)
    let sky.night = (1 - sky.day) * (1 - clamp(sky.warm, 0, 1))
    let sky.x0 = notecard.x - 52
    let sky.y0 = cy_actual - 28
    //  Where the sun is between 6 and 18, and the moon the other twelve hours.
    let sun.p = clamp((sky.t - 6) / 12, 0, 1)
    let moon.p = mod(sky.t + 6, 24) / 12
    let sun.up = if(sky.t >= 6 and sky.t < 18, 1, 0)
    let orb.p = if(sun.up > 0.5, sun.p, moon.p)
    let orb.x = sky.x0 + 70 + 28 * orb.p
    let orb.y = sky.y0 + 38 - 24 * sin(orb.p * 180)
    group {
        opacity: nc.c * 72%
        clip inset 0 box { at: notecard.x, cy_actual; size: notecard.w, notecard.h; corner: 14 - nc.c }
        body {
            gradient: sky.x0, sky.y0 to sky.x0, sky.y0 + 56, mix(mix(mix(mix(mix(#0d1633, #2f76c9, sky.day), #f08a6a, clamp(sky.warm, 0, 1) * (1 - wx.gloom * 0.7)), mix(#1b1f27, #6d7a89, sky.day), wx.gloom), #f0a060, wx.heat * 0.25), #bfe3ff, wx.cold * 0.2), mix(mix(mix(mix(mix(#1d2c57, #5fa6e0, sky.day), #6a4a9a, clamp(sky.warm, 0, 1) * (1 - wx.gloom * 0.7)), mix(#2a303a, #9aa6b3, sky.day), wx.gloom), #f0a060, wx.heat * 0.2), #d6ecff, wx.cold * 0.25)
            box { at: notecard.x, cy_actual; size: notecard.w, notecard.h; corner: 14 - nc.c }
        }
        repeat k in 0..6 {
            ellipse { at: sky.x0 + 8 + k * 17.5, sky.y0 + 7 + mod(k * 7, 11); radius: 0.8 + mod(k, 2) * 0.4; color: #ffffff; opacity: sky.night * 80% * (1 - wx.gloom) }
        }
        group {
            opacity: 1 - 0.8 * wx.cloud * if(wx.ok, 1, 0)
            group {
                glow: 6, 90%, #ffd36b
                ellipse { at: orb.x, orb.y; radius: 5; color: #ffd36b; show: sun.up > 0.5 }
            }
            ellipse { at: orb.x, orb.y; radius: 4.5; color: #e8ecf5; show: sun.up < 0.5 }
            ellipse { at: orb.x + 2.2, orb.y - 1.4; radius: 3.8; color: mix(#1a2648, #1b1f27, wx.gloom); show: sun.up < 0.5 }
        }
        //  Its clouds: three, each a few drops of cloud melted into one, more of
        //  them the more it is covered, greyer with rain, rocking a little.
        let cl.col = mix(mix(#f4f6f8, #8a94a3, 1 - sky.day), #5d6572, max(wx.rain, wx.storm) * 0.6)
        let cl.a = (34% + 30% * wx.cloud) * if(wx.ok, 1, 0)
        group {
        //  (Soft at the edge, as clouds are; the ones behind the time fainter,
        //  so it still reads.)
        blur: 1.4
        body {
            color: cl.col
            opacity: cl.a * if(wx.cloud > 0.12, 1, 0)
            ellipse { at: sky.x0 + 73 + 2 * sway, sky.y0 + 20; radius: 7 }
            ellipse { at: sky.x0 + 81 + 2 * sway, sky.y0 + 15; radius: 8.5; blend: 5 }
            ellipse { at: sky.x0 + 89 + 2 * sway, sky.y0 + 21; radius: 6.5; blend: 5 }
            box { at: sky.x0 + 81 + 2 * sway, sky.y0 + 24; size: 26, 6; corner: 3; blend: 4 }
        }
        body {
            color: cl.col
            opacity: cl.a * 0.6 * if(wx.cloud > 0.4, 1, 0)
            ellipse { at: sky.x0 + 27 - 1.5 * sway, sky.y0 + 12; radius: 5.5 }
            ellipse { at: sky.x0 + 34 - 1.5 * sway, sky.y0 + 8.5; radius: 6.5; blend: 4 }
            ellipse { at: sky.x0 + 41 - 1.5 * sway, sky.y0 + 13; radius: 5; blend: 4 }
        }
        body {
            color: cl.col
            opacity: cl.a * 0.5 * if(wx.cloud > 0.7, 1, 0)
            ellipse { at: sky.x0 + 53 + 1.5 * sway, sky.y0 + 47; radius: 6 }
            ellipse { at: sky.x0 + 60 + 1.5 * sway, sky.y0 + 43; radius: 7.5; blend: 4 }
            ellipse { at: sky.x0 + 68 + 1.5 * sway, sky.y0 + 48; radius: 5.5; blend: 4 }
        }
        }
        //  Fog: bands of it, drifting.
        group {
            show: wx.fog > 0.01
            blur: 3
            box { at: sky.x0 + 52 + 5 * sway, sky.y0 + 22; size: 124, 7; corner: 3.5; color: #dfe6ee; opacity: wx.fog * 30% }
            box { at: sky.x0 + 52 - 5 * sway, sky.y0 + 39; size: 124, 6; corner: 3; color: #dfe6ee; opacity: wx.fog * 24% }
        }
        //  Rain, slanting; heavy, more of it.
        group {
            show: nc.c > 0.5 and wx.rain > 0.05
            //  (Particles are not clipped: they are born inside and die before the edge.)
            particles { at: notecard.x + 8, sky.y0 + 2; area: 84, 1; count: 26; life: 0.26s .. 0.33s; speed: 130 .. 155
                        direction: 104deg; spread: 3deg; gravity: 0, 0; size: 1, 0.8; colors: #cfe6ff, #a9c8e8; opacity: 70%, 40%; shape: spark }
        }
        group {
            show: nc.c > 0.5 and wx.rain > 0.6
            particles { at: notecard.x + 8, sky.y0 + 2; area: 84, 1; count: 30; life: 0.24s .. 0.3s; speed: 150 .. 175
                        direction: 106deg; spread: 3deg; gravity: 0, 0; size: 1, 0.8; colors: #dbeeff, #a9c8e8; opacity: 70%, 40%; shape: spark }
        }
        //  Snow, drifting down.
        group {
            show: nc.c > 0.5 and wx.snow > 0.05
            particles { at: notecard.x + 2, sky.y0 + 3; area: 86, 1; count: 22; life: 2.2s .. 3s; speed: 9 .. 15
                        direction: 95deg; spread: 30deg; gravity: 0, 3; size: 1.7, 1.1; colors: #ffffff, #e8f2ff; opacity: 90%, 60%; shape: dot }
        }
        //  Lightning: the card lights up, and a bolt.
        box { at: notecard.x, cy_actual; size: notecard.w, notecard.h; color: #e8efff; opacity: bolt * 45% }
        path { at: sky.x0 + 86, sky.y0 + 5; color: #fff3b0; opacity: bolt
               move 2, 0; line -2, 8; line 1.5, 8; line -1.5, 17; line 5, 6; line 1.5, 6; line 4, 0; close }
    }

    //  What it has written on it. The system brings the time; there is no logic
    //  here. Each digit is a column of numbers seen through a window of its own:
    //  when the card appears they roll a whole lap, one after another, and stop
    //  on the hour, like a slot machine; when the minute changes, only those
    //  roll. 24 px between numbers, the same as the window.
    let dg.1 = floor(now.hour / 10)
    let dg.2 = now.hour - floor(now.hour / 10) * 10
    let dg.3 = floor(now.minute / 10)
    let dg.4 = now.minute - floor(now.minute / 10) * 10
    on change nc.c > 0.05 while nc.c > 0.05 and notecard.wants {
        roll.1: 0 ~16ms; roll.2: 0 ~16ms; roll.3: 0 ~16ms; roll.4: 0 ~16ms
        roll.1: 10 + dg.1 ~650ms after 20ms
        roll.2: 10 + dg.2 ~750ms after 90ms
        roll.3: 10 + dg.3 ~850ms after 160ms
        roll.4: 10 + dg.4 ~950ms after 230ms
    }
    on change now.minute while notecard > 0.9 {
        roll.3: 10 + dg.3 ~420ms
        roll.4: 10 + dg.4 ~420ms
    }
    on change now.hour while notecard > 0.9 {
        roll.1: 10 + dg.1 ~420ms
        roll.2: 10 + dg.2 ~420ms
    }
    group {
        opacity: clamp(nc.c * 3 - 1, 0, 1)
        let tx = notecard.x - 39
        let ty = cy_actual - 9
        repeat d in 1..5 {
            prop roll.$d = 0 ~420ms
            let dx = tx + 6.4 + (d - 1) * 12.8 + if(d > 2, 6.2, 0)
            group {
                clip inset 0 box { at: dx, ty; size: 14, 23 }
                repeat n in 0..20 {
                    text number(mod(n, 10), 0) { at: dx, ty + (n - roll.$d) * 24; anchor: center; size: 21; weight: 600; color: #f6f6f5
                                                 opacity: clamp(1 - abs(n - roll.$d) * 1.4, 0, 1) }
                }
            }
        }
        text ":" { at: tx + 28.2, ty - 1; anchor: center; size: 21; weight: 600; color: #f6f6f5 }
        text "{upper(now.date)}" { at: tx, cy_actual + 13; anchor: left center; size: 10; color: #c2c7cc }
        //  And how warm it is there.
        text "{wx.temp, 0}°" { at: notecard.x + 47, cy_actual + 13; anchor: right center; size: 10; weight: 600
                               color: mix(mix(#dfe3e6, #a8d8ff, wx.cold), #ffbb85, wx.heat); show: wx.ok }
    }

    // ── the face ─────────────────────────────────────────────────
    //  Clipped to the body: whatever sticks out of the ball does not exist. It is
    //  what lets the eyes turn into something else without leaving her.
    //
    //  Everything that follows is ONE chain: the usual eye, and each state
    //  pulling at it. It is written like this and not with loose weights because
    //  each line says what that state does, and because two springs halfway
    //  never add up to one. The face is not swapped for another: it bends until
    //  it is something else.
    //
    //  The measurements come from Marea's sheet, which draws the face in a space
    //  of 56; here the ball measures 46, so everything goes times 46/56.

    //  It is a component because she can be in two places: at the top, and
    //  tucked into the corner while recording. The same face, the same springs;
    //  the only thing that changes is where she is and where she can look.
    component Face(x: number, y: number, gx: number, gy: number, sink: number = 0) {
        //  When something else is in charge, the eyelid stops counting: a camera
        //  does not blink and neither does a number.
        let override = clamp(meter + num + cam + dot, 0, 1)
        let eyelid = lid + (1 - lid) * override

        //  1. The eye, and the level laying it down. (Measured in «The level on the
        //  face».)
        let o.w = 5 + 8 * meter
        let o.h = eyes * eyelid * (1 - meter) + 5 * meter
        let o.sep = 6.5 - 4 * meter

        //  2. The countdown. The two eyes go to the centre and round off until
        //  they are ONE drop —they really melt together, that is what they are a
        //  body for—, and then the drop **opens like a diaphragm**: it grows while
        //  its centre is eaten away, it stays as a ring, and inside was the number.
        //  It is not that the eyes hide and a number appears on top; it is that the
        //  number was behind them and the eyes open to show it.
        let merge = clamp(num * 2, 0, 1)
        let aperture = clamp(num * 2 - 1, 0, 1)
        let c.w = o.w + (9 - o.w) * merge
        let c.h = o.h + (9 - o.h) * merge
        let c.sep = o.sep * (1 - merge)
        //  18 and not 30: the ring stays at a little more than half a ball. With
        //  30 it almost filled it, and in 260 ms that is not a diaphragm, it is a
        //  flash.
        let g.w = c.w + 18 * aperture
        let g.h = c.h + 18 * aperture

        //  3. The camera. The left one opens into the lens and the right one
        //  stretches around it until it is the body; both at the centre of the
        //  face. The lens measures 13 on the sheet, and 5 with the shutter closed.
        let eye.l = 10.7 - 5.4 * shut
        let l.w = g.w + (eye.l - g.w) * cam
        let l.h = g.h + (eye.l - g.h) * cam
        let r.w = g.w + (24.6 - g.w) * cam
        let r.h = g.h + (17.3 - g.h) * cam
        //  Searching, both go to the centre: the ring stays there and the handle
        //  comes out of its edge, not from where an eye was.
        //  Padlock, circular arrow and power symbol are ONE figure made with two
        //  eyes, so both go to the centre. The eyelids and the door do not: there
        //  they are still two things, one on each side.
        let sep = c.sep * (1 - cam) * (1 - alarm) * (1 - magnifier) * (1 - padlock) * (1 - turn) * (1 - power)

        //  4. The record disc: the left eye, and only that one. The right one is
        //  still an eye and still follows the pointer, which is what keeps her
        //  alive while it lasts. The disc stays where the eye was, it does not
        //  centre itself.
        let d.w = l.w + (9 - l.w) * dot
        let d.h = l.h + (9 - l.h) * dot

        //  5. The exclamation mark: the stick is the left eye and the dot the
        //  right one, both centred, because an off-centre «!» is not a «!». They
        //  go to the middle, and one stretches while the other becomes a dot.
        let a.w = d.w + (4.1 - d.w) * alarm
        let a.h = d.h + (12.3 - d.h) * alarm
        let a.rw = r.w + (4.1 - r.w) * alarm
        let a.rh = r.h + (4.1 - r.h) * alarm

        //  6. In the Haven the eyes drop to two relaxed strokes. They do not close:
        //  she is still here, attentive. Closing them would be sleeping, which is
        //  something else.
        let z.w = a.w + (7.4 - a.w) * calmness
        let z.h = a.h + (2.5 - a.h) * calmness
        let z.rw = a.rw + (7.4 - a.rw) * calmness
        let z.rh = a.rh + (2.5 - a.rh) * calmness
        //  And the one beside the pearl opens round to look at it. Only that one:
        //  the other stays in its stroke, because nothing else has happened.
        let z.rw2 = z.rw + (9.5 - z.rw) * glance
        let z.rh2 = z.rh + (9.5 - z.rh) * glance

        //  8. Searching: the eyes turn into **a magnifying glass**. The left one
        //  opens into the ring —a disc whose centre is eaten by another one the
        //  colour of the body, just like the countdown's diaphragm— and the right
        //  one stretches into the handle, down to the right and diagonally. It is
        //  the same chain: the face is not swapped for another, it bends until it
        //  is something else.

        //  7. Asleep: two little lines. It is not the Haven's stroke —there she is
        //  still looking, here there is nobody—: they are thinner and droop a
        //  little, like an eyelid that has already given up.
        let s.w = z.w + (7.8 - z.w) * drowsy
        let s.h = z.h + (1.5 - z.h) * drowsy
        let s.rw = z.rw2 + (7.8 - z.rw2) * drowsy
        let s.rh = z.rh2 + (1.5 - z.rh2) * drowsy
        //  And asleep she opens ONLY the right one towards the drop that has sunk
        //  into her: 280 ms, open 700, and back to sleep. The left one does not
        //  even notice, which is what keeps it from looking as if she has woken up.
        let s.rw2 = s.rw + (8.6 - s.rw) * eye.r
        let s.rh2 = s.rh + (8.6 - s.rh) * eye.r
        //  And the magnifying glass, at the end of the chain: the ring and the
        //  handle.
        let u.w = s.w + (17.4 - s.w) * magnifier
        let u.h = s.h + (17.4 - s.h) * magnifier
        let u.rw = s.rw2 + (4.4 - s.rw2) * magnifier
        let u.rh = s.rh2 + (11.6 - s.rh2) * magnifier

        //  9. And the session's gestures, which are five and follow the sheet to
        //  the letter: «one capsule forms the padlock's shackle and the other its
        //  body», «the eyes narrow and end up as two curved eyelids», «one eye
        //  draws a door frame and the other an arrow going out», «the two curved
        //  strokes join into a circular arrow», «one eye forms the open ring and
        //  the other the vertical stroke». Five more links of the same chain: the
        //  face does not change, it bends.
        let k.w = u.w + (12.6 - u.w) * padlock
        let k.h = u.h + (12.6 - u.h) * padlock
        let k.rw = u.rw + (15.5 - u.rw) * padlock
        let k.rh = u.rh + (11.5 - u.rh) * padlock
        let p.w = k.w + (8.8 - k.w) * lids
        let p.h = k.h + (2.6 - k.h) * lids
        let p.rw = k.rw + (8.8 - k.rw) * lids
        let p.rh = k.rh + (2.6 - k.rh) * lids
        let q.w = p.w + (12.6 - p.w) * door
        let q.h = p.h + (16.4 - p.h) * door
        let q.rw = p.rw + (8.4 - p.rw) * door
        let q.rh = p.rh + (2.4 - p.rh) * door
        //  Reboot leaves the right one at nothing: the arrow's tip is a path of
        //  its own, because a tip is a triangle and not a capsule.
        let j.w = q.w + (16.4 - q.w) * turn
        let j.h = q.h + (16.4 - q.h) * turn
        let j.rw = q.rw + (0.1 - q.rw) * turn
        let j.rh = q.rh + (0.1 - q.rh) * turn
        let w.w = j.w + (17 - j.w) * power
        let w.h = j.h + (17 - j.h) * power
        let w.rw = j.rw + (2.8 - j.rw) * power
        let w.rh = j.rh + (11 - j.rh) * power
        //  And the ending, which is the only gesture in the whole scene made AFTER
        //  deciding: «the symbol may contract down to a small point of light and
        //  disappear». It shrinks whole, gaps included, or the hole would eat the
        //  ring before the ring goes.
        let shrink = 1 - powerdown
        let v.w = w.w * shrink
        let v.h = w.h * shrink * (1 - joy) * (1 - clamp(eyewave, 0, 1)) * (1 - clamp(hands, 0, 1)) * (1 - clamp(sign, 0, 1)) * (1 - 0.35 * fury - 0.25 * glare)
        let v.rw = w.rw * shrink
        let v.rh = w.rh * shrink * (1 - joy) * (1 - clamp(eyewave, 0, 1)) * (1 - clamp(hands, 0, 1)) * (1 - clamp(sign, 0, 1)) * (1 - 0.35 * fury - 0.25 * glare)

        //  The magnifying glass is centred as a whole, not by its ring: the ring
        //  sat where the eyes do and the handle hung off it down to the right,
        //  so the glass as a figure was 3 px right and 5 low. Its box runs from
        //  the ring's edge (−8.7) to the handle's tip (+14.5) on both axes.
        //  At her centre: the eyes and whatever figure they turn into. They used
        //  to sit 2.5 below it, which on two pills reads as a face but every
        //  symbol —the count, the padlock, the arrows— inherited it and came out
        //  low in the ball. Measured against a circle fitted to her edge.
        //  The camera carries its viewfinder on top, so its body goes a little
        //  lower for the camera as a whole to be centred.
        let eye.y = y + drowsy * 1.4 - 2.9 * magnifier + 2.4 * cam
        let l.x = x - sep - 1.9 * magnifier
        let r.x = x + sep - 1.9 * magnifier
        //  Round when it is round: half of the short side gives a standing pill,
        //  a lying pill, drop, lens and disc without saying it five times. The
        //  camera's body is the only one that departs from it, because it has a
        //  corner of its own.
        let l.corner = min(v.w, v.h) / 2
        let r.corner = min(v.rw, v.rh) / 2 + (4.9 - min(v.rw, v.rh) / 2) * cam
        //  And the bridge between the two: a bell, like the meniscus one. Maximum
        //  just when they touch —halfway through the level's journey, and on
        //  joining into the drop— and nothing at the ends.
        let eye.fusion = 6 * 4 * meter * (1 - meter) + 7 * merge * (1 - cam)

        group {
            clip inset 1 ellipse { at: x, y; radius: 23 }
            //  A symbol does not look around: turned into the magnifying glass,
            //  the gaze no longer carries it off the centre.
            move: gx * (1 - magnifier), gy * (1 - magnifier) + look.y + sink

            //  The eyes, which here are everything: the level's track, the
            //  countdown's drop, the camera's lens and body, and the red disc's
            //  place. They darken when lying down because a white track with mint
            //  on top does not read as a level; and they go away when the drop
            //  opens.
            body {
                color: mix(ink, #34373a, meter)
                box { at: l.x, eye.y - 2.8 * alarm - 5.2 * padlock; size: v.w, v.h; corner: l.corner; blend: eye.fusion }
                box { at: r.x + 8.8 * magnifier, eye.y + 6.2 * alarm + 8.8 * magnifier + 5.4 * padlock - 3.4 * power
                      size: v.rw, v.rh; corner: r.corner; rotate: 45deg * magnifier; blend: eye.fusion }
            }
            //  Happy: the pills flatten into nothing and two arches rise in their
            //  place —«^ ^»—. The same eyes, bent once more; the arch grows from a
            //  point as the pill goes, so there is never a face with none.
            arc { at: l.x, eye.y + 2; radius: 4.2; span: 170deg * joy; width: 2.4; color: ink; opacity: min(joy * 3, 1) }
            arc { at: r.x, eye.y + 2; radius: 4.2; span: 170deg * joy; width: 2.4; color: ink; opacity: min(joy * 3, 1) }
            //  The clock: the pills flatten and two hands grow from her centre,
            //  the hour's short and thick, the minute's long.
            line { from: x, eye.y; to: x + 5.5 * sin(hand.h) * hands, eye.y - 5.5 * cos(hand.h) * hands; width: 2.8; color: ink; opacity: min(hands * 3, 1) }
            line { from: x, eye.y; to: x + 9 * sin(hand.m) * hands, eye.y - 9 * cos(hand.m) * hands; width: 2; color: ink; opacity: min(hands * 3, 1) }
            ellipse { at: x, eye.y; radius: 1.9 * hands; color: ink; opacity: min(hands * 3, 1) }
            //  What has just arrived, in her eyes for a moment: the pills flatten
            //  and the symbol of its kind grows in their place. A speech bubble
            //  for messages, an envelope for work, a calendar page, a gear for
            //  the system.
            group {
                opacity: min(sign * 3, 1)
                pivot: x, eye.y
                scale: sign, sign
                group {
                    show: reading_cat == 1
                    box { at: x, eye.y - 1; size: 17, 12; corner: 4.5; stroke: 1.9; color: ink }
                    path { at: x - 4, eye.y + 4.5; color: ink; move 0, 0; line 5, 0; line -1.5, 4.5; close }
                }
                group {
                    show: reading_cat == 2
                    box { at: x, eye.y; size: 18, 12; corner: 1.8; stroke: 1.8; color: ink }
                    line { from: x - 8, eye.y - 5; to: x, eye.y + 1; width: 1.6; color: ink }
                    line { from: x + 8, eye.y - 5; to: x, eye.y + 1; width: 1.6; color: ink }
                }
                group {
                    show: reading_cat == 3
                    box { at: x, eye.y + 0.5; size: 15, 13; corner: 2; stroke: 1.8; color: ink }
                    box { at: x, eye.y - 4; size: 15, 4; corner: 1; color: ink }
                    line { from: x - 3.5, eye.y - 8.5; to: x - 3.5, eye.y - 5; width: 1.6; color: ink }
                    line { from: x + 3.5, eye.y - 8.5; to: x + 3.5, eye.y - 5; width: 1.6; color: ink }
                }
                group {
                    show: reading_cat == 4
                    ellipse { at: x, eye.y; radius: 5; stroke: 2.2; color: ink }
                    repeat t in 0..6 {
                        box { at: x + 7 * cos(t * 60), eye.y + 7 * sin(t * 60); size: 3.2, 3.2; corner: 0.8; rotate: t * 60deg; color: ink }
                    }
                }
            }
            //  Reading water: the pills flatten the same way and a little wave
            //  grows in each place, a ∩ and a ∪ side by side, rocking.
            repeat e in 0..2 {
                let ex = if(e == 0, l.x, r.x)
                let bob = 1.2 * sin(eyewave.phase * 360 + e * 120)
                let tw = clamp(eyewave, 0, 1)
                arc { at: ex - 3.1, eye.y + bob; radius: 3.1; span: 180deg * tw; width: 2.4; color: ink; opacity: min(tw * 3, 1) }
                arc { at: ex + 3.1, eye.y + bob; radius: 3.1; span: 180deg * tw; width: 2.4; rotate: 180deg; color: ink; opacity: min(tw * 3, 1) }
            }
            //  Angry: two brows sloping down to the middle, «\ /», and the eyes
            //  narrowed under them.
            line { from: l.x - 5.5, eye.y - 11 + 2 * (1 - fury); to: l.x + 4, eye.y - 6.5; width: 2.2; color: ink; opacity: fury }
            line { from: r.x + 5.5, eye.y - 11 + 2 * (1 - fury); to: r.x - 4, eye.y - 6.5; width: 2.2; color: ink; opacity: fury }
            //  Blowing: a little «o» of a mouth.
            ellipse { at: x + 6 * side, eye.y + 10; radius: 2.6 * blow; stroke: 1.5; color: ink; opacity: blow }

            //  The level's filled part is **the same track**, painted again and
            //  clipped from the left. That way the mint has the exact shape of the
            //  bar —with its tips— without drawing a single extra geometry. In its
            //  own group: a clip reaches to the end of the group where it lives.
            group {
                clip inset 0 box { from: x - 9, eye.y - 4; size: 18 * vol_level, 8 }
                body {
                    color: mix(mint, #6b7280, sound.muted)
                    opacity: meter
                    box { at: l.x, eye.y - 2.8 * alarm - 5.2 * padlock; size: v.w, v.h; corner: l.corner; blend: eye.fusion }
                    box { at: r.x + 8.8 * magnifier, eye.y + 6.2 * alarm + 8.8 * magnifier + 5.4 * padlock - 3.4 * power
                      size: v.rw, v.rh; corner: r.corner; rotate: 45deg * magnifier; blend: eye.fusion }
                }
            }

            //  The hole of the magnifying glass's ring, the colour of the body:
            //  here everything is distances, so a hole is one more shape. It is
            //  the same trick as the diaphragm down here.
            body {
                color: skin
                ellipse { at: l.x, eye.y; radius: 6.4 * magnifier * shrink }
                //  The padlock's shackle: a ring whose lower half is covered,
                //  which is where the body fits.
                ellipse { at: l.x, eye.y - 5.2 * padlock; radius: 4.1 * padlock * shrink }
                box { at: l.x, eye.y - 1 * padlock; size: 13 * padlock * shrink, 7 * padlock * shrink }
                //  The door frame, hollow inside.
                box { at: l.x - 1.1 * door, eye.y; size: 8 * door * shrink, 12 * door * shrink; corner: 1 }
                //  The two rings, the reboot one and the power-off one, with their
                //  opening.
                ellipse { at: l.x, eye.y; radius: 5.6 * turn * shrink }
                box { at: l.x + 5.6 * turn, eye.y - 5.6 * turn; size: 7 * turn * shrink, 7 * turn * shrink; rotate: 45deg }
                ellipse { at: l.x, eye.y; radius: 5.7 * power * shrink }
                box { at: l.x, eye.y - 8.5 * power; size: 5.4 * power * shrink, 6 * power * shrink }
            }
            //  The power symbol's stroke, again on top: the ring's hollow and its
            //  opening were cut after it and ate it whole, so the power-off face
            //  was a ring alone.
            box { at: l.x, eye.y - 4.3 * power; size: 2.6 * power * shrink, 9.6 * power * shrink; corner: 1.3; color: ink; opacity: min(power * 3, 1) }
            //  And what is not a bent capsule: the door's handle, the arrow going
            //  out through it and the tip of the circular arrow. The turn is a
            //  single one —«do not spin endlessly for decoration»— and is made
            //  whole every time you point at it.
            group {
                opacity: door * shrink
                ellipse { at: l.x + 1.6, eye.y + 1.4; radius: 1.1; color: mint }
                path { at: r.x + 5.2, eye.y; color: ink; stroke: 1.7
                       move 0, -3.1; line 3.1, 0; line 0, 3.1 }
            }
            group {
                opacity: turn * shrink
                pivot: l.x, eye.y
                rotate: twirl * 360deg
                path { at: l.x + 7.4, eye.y - 7.4; color: ink
                       move -3.4, -2.2; line 3.4, 0.4; line -1.4, 3.6; close }
            }

            //  The diaphragm. The drop does not fade: its centre is eaten by a
            //  shape the colour of the ball, so what is left is a ring that grows
            //  until there is no ring any more. A white number on a white drop
            //  that fades comes out grey and murky; this comes out clean, and it is
            //  also the same sum as always: here everything is distances, and a
            //  hole is one more shape.
            body {
                color: skin
                ellipse { at: x, eye.y; radius: g.w / 2 * aperture * 1.25 }
            }

            //  The camera's hollow. The body is not drawn with an outline: its
            //  centre is eaten by a shape the colour of the ball, which is how a
            //  hole is made when everything is distances. It grows from nothing, so
            //  the eye empties instead of being swapped for a frame.
            body {
                color: skin
                box { at: x, eye.y; size: 21.3 * cam, 14 * cam; corner: 3.3 }
            }

            //  And the lens on top of the hollow, which is the only thing the
            //  hollow took with it. Same shape and same place as the eye below, so
            //  no crossing is seen: you see an eye emptying around it.
            body {
                color: ink
                opacity: cam
                ellipse { at: x, eye.y; radius: eye.l / 2 }
            }

            //  The viewfinder. This one cannot be an eye —both have been used— so
            //  it is a separate mark, detached from the outline so they do not join
            //  in a seam, and it comes and goes with the rest.
            box {
                at: x - 6.2, eye.y - 11.6
                size: 5.7 * cam, 2.9 * cam
                corner: 1.2
                color: ink
            }

            //  The record disc, right on top of the left eye and its size: it is
            //  not a shape that arrives, it is the eye turning red. And the red
            //  lights up with `taping`, not with the press: the disc says the
            //  recorder IS running, not that it has been asked to.
            body {
                color: mix(#34373a, #fc6753, red)
                opacity: dot
                ellipse { at: l.x, eye.y; radius: d.w / 2 }
            }

            //  The level's percentage, on the forehead. It rises the last three
            //  pixels while it appears: it comes in with the bar instead of
            //  switching on on top.
            text number(sound.volume * 100, 0, " %") {
                at: x, y - 9 + (1 - meter) * 3
                anchor: center
                size: 9
                weight: 600
                color: ink
                opacity: meter
            }

            //  The countdown's number, where her eyes were. Big so it can be read
            //  from the other side of the desk, which is the whole reason it is
            //  here and not on a separate label: what is about to start, she does.
            group {
                pivot: x, eye.y
                scale: 1 + pop, 1 + pop
                text number(max(left, 1), 0) {
                    //  A digit's ink sits lower than its line's middle: raised so
                    //  the number is centred, not its box.
                    at: x, eye.y - 1.8
                    anchor: center
                    size: 24.6
                    weight: 300
                    color: ink
                    //  It comes in before the ring is completely gone: by the time
                    //  the hole shows it, it is already there. If it came in later,
                    //  the diaphragm would open over nothing.
                    opacity: clamp(aperture * 1.7, 0, 1)
                }
            }
        }
    }

    //  Sunk into the edge, her centre falls almost on the water's surface, so
    //  eyes centred on it come out with the crown cut off by the edge of the
    //  screen: you saw two little lines. Lowering them inside the face shows them
    //  whole without having to show more of her. They are Marea's 7 of 56, times
    //  46/56, and somewhat less now that she peeks out more.
    //  Where her face is, said ONCE: the face and whatever sticks to it use it.
    //  Written twice, a pair of glasses stays looking the other way as soon as
    //  someone touches one of the two places.
    let face.dx = (gaze.x + (4 - gaze.x) * attentive) * (1 - glare)
    let face.dy = gaze.y * (1 - attentive) * (1 - glare)
    let face.sink = (1 - out) * 4.5 * if(hidden, 1, 0)
    Face(cx, cy_actual, face.dx, face.dy, face.sink)

    // ── the Haven's capsule ──────────────────────────────────────
    //  The whole —her and the capsule—, for the grace on leaving. And it goes
    //  BELOW what it holds inside, like the panel's: the press belongs to the
    //  topmost zone, and declared at the end it kept the click on «End». It is
    //  the fourth time this happens; it is no longer a slip, it is a shape of
    //  the scene, and that is why it is written here and not only there.
    zone box capsule_area { at: cx + 70, cy_actual + 8; size: 260, 136; corner: 30; active: capsule > 0.01 }
    on away capsule_area for 300ms { note = false }

    //  On hovering, what needs to be known: what she is in, how long she has
    //  left, how many she has kept, and how to get out. Nothing more: if you had
    //  to open something to find out, it would be of no use.
    let capsule.reveal = clamp(capsule * 2.2 - 1.2, 0, 1)
    group {
        opacity: capsule.reveal
        move: (1 - capsule.reveal) * -8, 0
        arc { at: capsule.x - 76, capsule.y - 22; radius: 7.5; span: 210deg; width: 5; rotate: 145deg; color: #8fa2e8 }
        text "Do not disturb · {remaining, 0} min" { at: capsule.x - 60, capsule.y - 26; anchor: left center; size: 12; weight: 500; color: ink }
        text "{pending, 0} notices kept" { at: capsule.x - 60, capsule.y - 9; anchor: left center; size: 10.5; color: #8b8f95 }
        prop end_haven.glow = 0 ~140ms
        prop rules.glow = 0 ~140ms
        box { at: capsule.x - 52, capsule.y + 22; size: 96, 30; corner: 10; color: mix(#2a1b1b, #3a2424, end_haven.glow) }
        box { at: capsule.x - 84, capsule.y + 22; size: 11, 11; corner: 3; color: #e0655a }
        text "End" { at: capsule.x - 44, capsule.y + 22; anchor: center; size: 11.5; weight: 500; color: ink }
        box { at: capsule.x + 52, capsule.y + 22; size: 96, 30; corner: 10; color: mix(#1b1b1c, #232425, rules.glow) }
        text "View rules" { at: capsule.x + 52, capsule.y + 22; anchor: center; size: 11.5; color: #8b8f95 }
        zone box end_haven { at: capsule.x - 52, capsule.y + 22; size: 96, 30; corner: 10; cursor: pointer; active: capsule > 0.8 }
        zone box rules { at: capsule.x + 52, capsule.y + 22; size: 96, 30; corner: 10; cursor: pointer; active: capsule > 0.8 }
        on enter end_haven { end_haven.glow: 1 }
        on leave end_haven { end_haven.glow: 0 }
        on enter rules { rules.glow: 1 }
        on leave rules { rules.glow: 0 }
        on press end_haven { emit leave_haven }
        on press rules { emit view_rules }
    }
    // ── the saved recording's card ───────────────────────────────
    //  Its grace zone first, below what it holds: the press belongs to the
    //  zone declared last.
    zone box reel_area { at: reel.x - 20, reel.y; size: 350, 120; corner: 24; active: reel > 0.01 }
    on enter reel_area { reel_hovered = true }
    on leave reel_area { reel_hovered = false; reel_clock: if(reel_hovered, 0, 1) after 6s }
    let reel.reveal = clamp(reel * 2.2 - 1.2, 0, 1)
    group {
        opacity: reel.reveal
        move: (1 - reel.reveal) * -8, 0
        //  A mint tick: done, and kept.
        ellipse { at: reel.x - 130, reel.y - 26; radius: 8; color: mint; opacity: 18% }
        path { at: reel.x - 134, reel.y - 27; color: mint; stroke: 1.8
               move 0, 0; line 3, 3; line 8, -3 }
        text "Recording saved" { at: reel.x - 116, reel.y - 29; anchor: left center; size: 12; weight: 500; color: ink }
        text reel.name { at: reel.x - 116, reel.y - 13; anchor: left center; size: 10.5; width: 230; lines: 1; color: #8b8f95 }
        prop reel_x.glow = 0 ~140ms
        line { from: reel.x + 126, reel.y - 33; to: reel.x + 134, reel.y - 25; width: 1.6; color: ink; opacity: 45% + reel_x.glow * 55% }
        line { from: reel.x + 134, reel.y - 33; to: reel.x + 126, reel.y - 25; width: 1.6; color: ink; opacity: 45% + reel_x.glow * 55% }
        zone box reel_close { at: reel.x + 130, reel.y - 29; size: 26, 26; corner: 13; cursor: pointer; active: reel > 0.8 }
        on enter reel_close { reel_x.glow: 1 }
        on leave reel_close { reel_x.glow: 0 }
        on press reel_close { reel_open = false }
        //  Three choices, the first one lit: watching it is what one wants most.
        repeat b in 0..3 {
            let bx = reel.x - 94 + b * 94
            prop reel_b.glow.$b = 0 ~140ms
            box { at: bx, reel.y + 22; size: 88, 30; corner: 10
                  color: mix(mix(#1b1b1c, #242526, reel_b.glow.$b), mix(#1f3a34, #25483f, reel_b.glow.$b), b == 0) }
            text "Watch" { at: bx, reel.y + 22; anchor: center; size: 11.5; weight: 500; color: mint; show: b == 0 }
            text "Folder" { at: bx, reel.y + 22; anchor: center; size: 11.5; color: ink; show: b == 1 }
            text "Copy path" { at: bx, reel.y + 22; anchor: center; size: 11.5; color: ink; show: b == 2 }
            zone box reel_b.$b { at: bx, reel.y + 22; size: 88, 30; corner: 10; cursor: pointer; active: reel > 0.8 }
            on enter reel_b.$b { reel_b.glow.$b: 1 }
            on leave reel_b.$b { reel_b.glow.$b: 0 }
        }
        on press reel_b.0 { emit reel_watch; reel_open = false }
        on press reel_b.1 { emit reel_folder; reel_open = false }
        on press reel_b.2 { emit reel_copy; reel_open = false }
    }

    //  On coming back, a single summary. The normal drops stay hidden while it is
    //  there: releasing the whole queue at once would be the opposite of what
    //  the Haven came to do.
    let summary.reveal = clamp(summary * 2 - 1, 0, 1)
    group {
        opacity: summary.reveal
        move: (1 - summary.reveal) * -10, 0
        ellipse { at: summary.x - 78, cy_actual; radius: 8; color: blue }
        text "{pending, 0} important updates" { at: summary.x - 62, cy_actual; anchor: left center; size: 11.5; color: ink }
        path { at: summary.x + 86, cy_actual - 5; color: #8b8f95; stroke: 1.6; move 0, 0; line 5, 5; line 0, 10 }
    }

    // ── the Haven's membrane ─────────────────────────────────────
    //  All of this lives INSIDE her silhouette: going into the Haven does not
    //  enlarge her. The water is drawn clipped to the ball, so the line is cut
    //  where she ends and there is no need to compute where.
    let water.y = cy_actual + 7
    let water.tilt = tide * 0.10
    group {
        clip inset 0 ellipse { at: cx, cy_actual; radius: r }
        opacity: calmness
        //  What is below the waterline: a little lighter than her, like water
        //  seen from outside.
        box { at: cx, water.y + 22; size: 70, 44; color: #1d2b2c; rotate: water.tilt }
        //  And the line, which is the only thing that moves: the tide changes its
        //  slope slowly, without moving the body or the pearls.
        box { at: cx, water.y; size: 70, 1.4; color: #7fd6c4; rotate: water.tilt; opacity: 75% }
        //  The pearls: one per category, kept under the water. They appear when
        //  the first one is kept, grow a little with what keeps being kept —up
        //  to three, and there it stays: a pearl that grows without limit is a
        //  count, and the count is already in the capsule— and they beat when
        //  another one falls. That is all that happens in here, and it happens
        //  slowly.
        repeat k in 1..5 {
            let px = cx - 13.5 + (k - 1) * 9
            let pearl.r = (2.8 + 0.6 * min(n.$k, 3)) * (1 + beat.$k * 0.5)
            ellipse { at: px, water.y + 9; radius: pearl.r * pearl.$k
                      color: mix(mix(mix(blue, lilac, k > 1.5), green, k > 2.5), amber, k > 3.5)
                      opacity: pearl.$k * 85% }
        }
    }
    //  The amber pearl of an allowed urgency: over the membrane, not under the
    //  water. What is kept goes below; what happens, above.
    //  At three o'clock on her membrane, far from the moon: together they read
    //  as one single strange thing on the edge.
    ellipse { at: cx + 20, cy_actual - 11.5; radius: 4.2; color: #e2b25a; opacity: glance }

    //  The membrane, of the same diameter as her. It is drawn by a wave that
    //  runs around it once on entering: the arc grows from nothing to whole.
    arc { at: cx, cy_actual; radius: r; span: 360deg * drawing; width: 1.3; color: #7fd6c4; opacity: calmness * 85% }

    //  The moon, in the upper right quadrant and outside her. It is a path of two
    //  curves —the outer edge and the inner one—, which is how a crescent is
    //  drawn when you cannot subtract one shape from another.
    let moon.x = cx + 22
    let moon.y = cy_actual - 31
    //  A crescent is a fat arc, so that is what it is: 210° of 5.5 thickness,
    //  rotated so it opens downwards and to the left. With two curves it came
    //  out as a hook; this is what the shape really is.
    arc { at: moon.x, moon.y; radius: 7.5; span: 210deg; width: 5.5; rotate: 145deg; color: #8fa2e8; opacity: calmness }



    // ── the drops ────────────────────────────────────────────────
    //  And their two grace zones go IN FRONT, which in zones means below: the
    //  press —and the cursor— belong to the last one declared, so written after
    //  they took away each drop's little hand and there was no way to know they
    //  could be pressed. They go sixth.
    zone box notecard_area { from: cx - 30, cy_actual - 40; size: 200, 80; active: note and not haven }
    zone box fan_area { at: cx, cy_actual + 40; size: 260, 180; corner: 30; active: fan > 0.01 }

    //  Up to four, one per category and **the most recent first**, going down
    //  her right side from the shoulder. Nothing sticks out above her head: up
    //  there is the edge of the screen. Each one's place is how many there are
    //  more recent than it, and it travels to it with a spring ALONG THE ARC
    //  —the angle is what is animated, not x and y—, so when a new one arrives
    //  the others shift down the shoulder without cutting through her.
    repeat k in 1..5 {
        prop slot.$k = 0 ~calm
        prop shown.$k = 0 ~240ms
        //  Coming close to a drop wobbles it like what it is: a little water. It
        //  is not a highlight that switches on, it is a push to a spring with
        //  little braking, so it squashes, bounces and keeps still by itself.
        prop touch.drop.$k = 0 ~splash
        //  And it grows while the mouse is over it: the wobble is the greeting,
        //  this is «I'm looking at you». Without it, it does not read as
        //  something you press.
        prop near.drop.$k = 0 ~140ms
        //  «The amber drop rises and stays up while it lasts»: the one of the
        //  category with something urgent goes to slot 0 —the top of the
        //  shoulder— and the others drop one to leave it to it. On resolving it,
        //  each one goes back to its slot by recency, without anyone
        //  rearranging them.
        //  And the one with something urgent goes first. The others count how
        //  many there are more recent **without counting the urgent one**, and
        //  add its slot to that: counting it twice left a gap in the fan and the
        //  top one looked detached from the others.
        follow slot.$k = (1 - cat_urgent.$k) * (if(n.1 > 0 and last.1 > last.$k, 1, 0) * (1 - cat_urgent.1) + if(n.2 > 0 and last.2 > last.$k, 1, 0) * (1 - cat_urgent.2) + if(n.3 > 0 and last.3 > last.$k, 1, 0) * (1 - cat_urgent.3) + if(n.4 > 0 and last.4 > last.$k, 1, 0) * (1 - cat_urgent.4) + clamp(cat_urgent.any, 0, 1))
        //  In the Haven the shoulder drops are gathered in: down there they are
        //  pearls.
        follow shown.$k = if(n.$k > 0 and not open, 1, 0) * (1 - calmness) * (1 - summary)
        //  From the shoulder to the fan **along the arc**: what is animated is the
        //  angle, so the drops go down around her and do not cut through her.
        //  The whole fan turns 76° and moves 10 away: each one's slot inside it
        //  is still its own.
        //  Open, they spread a little more —30° instead of 26— so they do not
        //  touch, and the fan stays centred below her.
        //  And sunk, the whole fan drops 30°: up there is the edge of the screen,
        //  and the first drop —which is now the urgent one's, which rises to slot
        //  0— stuck out through it and could not be seen. «Nothing sticks out
        //  above her head» also holds when the head is half tucked in.
        let ang.$k = -24 + 30 * (1 - out) + (26 + 4 * fan) * slot.$k + 69 * fan
        let rad.$k = 31.7 + 10.3 * fan
        let gx.$k = cx + rad.$k * cos(ang.$k)
        let gy.$k = cy_actual + rad.$k * sin(ang.$k)
        //  And in amber while it lasts, like its row in the tray: what matters
        //  about that drop is no longer whose it is, it is that it is urgent.
        let color.$k = mix(mix(mix(mix(blue, lilac, k > 1.5), green, k > 2.5), amber, k > 3.5), #e2b25a, cat_urgent.$k)
        //  The beat goes in both at once —it grows whole—; the wobble of coming
        //  close goes the other way on each axis, which is what makes it look like
        //  water and not a balloon: it squashes on one side while it stretches on
        //  the other, and the spring with little braking leaves it trembling for a
        //  moment.
        //  It fattens a little and wobbles: 5 % on both and 12 % the other way on
        //  each axis. The push goes to a spring with little braking —the water
        //  splash's one—, so it bounces a couple of times and keeps still by
        //  itself.
        let wide.$k = shown.$k * (1 + beat.$k + near.drop.$k * 0.16 + touch.drop.$k * 0.17)
        let tall.$k = shown.$k * (1 + beat.$k + near.drop.$k * 0.16 - touch.drop.$k * 0.07)
        group {
            pivot: gx.$k, gy.$k
            scale: wide.$k, tall.$k
            opacity: shown.$k
            ellipse { at: gx.$k, gy.$k; radius: 7 + 3 * fan; color: color.$k }
            //  Gathered, it shows its count; open, its category's icon. What it
            //  says changes because what you ask is something else: gathered, how
            //  many there are; open, from whom.
            group {
                opacity: 1 - fan
                text number(n.$k, 0) { at: gx.$k, gy.$k + 0.5; anchor: center; size: 8.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 1, 0) }
                text "9+" { at: gx.$k, gy.$k + 0.5; anchor: center; size: 7.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 0, 1) }
            }
            group {
                opacity: clamp(fan * 2 - 1, 0, 1)
                //  Messages: a speech bubble. Work: a briefcase. Calendar: a sheet
                //  with its rings. System: the usual gear.
                box { at: gx.$k, gy.$k - 1; size: 11, 8; corner: 2.5; color: #0a0c10; show: k == 1 }
                path { at: gx.$k - 3.5, gy.$k + 3; color: #0a0c10; show: k == 1
                       move 0, 0; line 4, 0; line 1, 3.5; close }
                box { at: gx.$k, gy.$k + 1; size: 11, 8; corner: 1.5; color: #0a0c10; show: k == 2 }
                box { at: gx.$k, gy.$k - 4; size: 5, 3; corner: 1; color: #0a0c10; show: k == 2 }
                box { at: gx.$k, gy.$k + 1; size: 10, 9; corner: 1.5; color: #0a0c10; show: k == 3 }
                box { at: gx.$k - 2.5, gy.$k - 5; size: 1.6, 3; corner: 0.8; color: #0a0c10; show: k == 3 }
                box { at: gx.$k + 2.5, gy.$k - 5; size: 1.6, 3; corner: 0.8; color: #0a0c10; show: k == 3 }
                arc { at: gx.$k, gy.$k; radius: 4.6; span: 300deg; width: 1.6; color: #0a0c10; show: k == 4 }
                ellipse { at: gx.$k, gy.$k; radius: 1.7; color: #0a0c10; show: k == 4 }
            }
        }
        //  Pressing a drop opens the swell: it is one of the four ways the
        //  contract names, and the most direct —you are already looking there—.
        //  The zone grows with it: gathered it measures 14 and open 20, so a fixed
        //  box of 24 left out half an open drop.
        zone box drop_zone.$k { at: gx.$k, gy.$k; size: 26 + 10 * fan, 26 + 10 * fan
                               corner: 13 + 5 * fan; cursor: pointer
                               active: shown.$k > 0.5 and not tray_open and not open }
        on enter drop_zone.$k { impulse touch.drop.$k 9; near.drop.$k: 1 }
        on leave drop_zone.$k { near.drop.$k: 0 }
        //  And pressing it opens the swell **with its own**: if you ask about the
        //  blue drop, what you want to see are the messages, not everything there
        //  is.
        on press drop_zone.$k { cat = k; filter = k; emit open_tray }
        //  The drop where something falls beats once, and its number with it.
        //  Nothing looping.
        on landed while reading_cat == k { n.$k = n.$k + burst; last.$k = max(last.$k, arrival_seq); impulse beat.$k 5 }
        on direct while cat == k { n.$k = n.$k + 1; last.$k = seq; impulse beat.$k 5 }
    }

    // ── the stones: windows put away ─────────────────────────────
    //  A window put away (minimized, in pleamar-wm's session) melts into a
    //  drop of her own skin that falls into her island, at her left —the
    //  drops are on her right—; where it lands, the drop becomes its
    //  application's face: a little drop of Marea with the icon inside.
    //  The newest sits next to her and the others make room further left.
    //  Hovering one, the water in it stirs —it wobbles and rings spread from
    //  it— and it says which window it is; pressing it brings the window
    //  back out of her.
    model stones max 6 { title: text; icon: image 18, 18; letter: text; present: bool = false; seq: number = 0 }
    event restore_stone ->             // (k): the logic brings that one back
    spring pebble = 300, 13
    //  Landed: the window manager's drop takes a moment to get here, and
    //  the stone is born when it arrives, not when the window is put away.
    repeat k in 0..6 {
        prop due.$k = 0 ~0ms
        on change stones.$k.present while stones.$k.present {
            due.$k: 0
            due.$k: 1 after 420ms
        }
    }
    repeat k in 0..6 {
        let landed.$k = stones.$k.present and due.$k > 0.5
        //  Its place: how many landed ones are newer than it.
        let rank.$k = (stones.0.present and due.0 > 0.5 and stones.0.seq > stones.$k.seq) + (stones.1.present and due.1 > 0.5 and stones.1.seq > stones.$k.seq) + (stones.2.present and due.2 > 0.5 and stones.2.seq > stones.$k.seq) + (stones.3.present and due.3 > 0.5 and stones.3.seq > stones.$k.seq) + (stones.4.present and due.4 > 0.5 and stones.4.seq > stones.$k.seq) + (stones.5.present and due.5 > 0.5 and stones.5.seq > stones.$k.seq)
        prop stone.$k = 0 ~pebble
        follow stone.$k = if(landed.$k and not open and not searching and not tray_open, 1, 0)
        prop place.stone.$k = 0 ~calm
        follow place.stone.$k = rank.$k
        prop near.stone.$k = 0 ~140ms
        prop touch.stone.$k = 0 ~splash
        let sx.$k = cx - r - 24 - place.stone.$k * 34
        //  (Tucked in, she hides most of herself; the stones only a little:
        //  they must stay reachable. That is also where the drops fall.)
        let sy.$k = cy_actual + rise * 0.6
        //  The water stirring while the mouse is on it: a slow wobble.
        let stir.$k = near.stone.$k * sin(time * 300 + k * 60)
        group {
            show: stone.$k > 0.01
            opacity: clamp(stone.$k * 2, 0, 1)
            pivot: sx.$k, sy.$k
            //  (Born from the size of the drop that falls in: 0.75 of it.)
            scale: (0.75 + 0.25 * stone.$k) * (1 + near.stone.$k * 0.1 + touch.stone.$k * 0.12 + 0.05 * stir.$k), (0.75 + 0.25 * stone.$k) * (1 + near.stone.$k * 0.1 - touch.stone.$k * 0.06 - 0.05 * stir.$k)
            body {
                color: coal
                rim: 14% + 10% * near.stone.$k
                shadow: 0, 3 + 3 * near.stone.$k, 9, 45%
                ellipse { at: sx.$k, sy.$k; radius: 14 }
            }
            //  The light on the water moves round as it stirs.
            ellipse { at: sx.$k - 5 + 2 * stir.$k, sy.$k - 7; radius: 3; scale: 1.4, 0.7; color: ink; opacity: 14% + 18% * near.stone.$k }
            //  An image's `at` is its corner.
            image stones.$k.icon { at: sx.$k - 9, sy.$k - 9 + 1.2 * stir.$k; size: 18, 18 }
            text stones.$k.letter { at: sx.$k, sy.$k + 0.5 + 1.2 * stir.$k; anchor: center; size: 12; weight: 700; color: ink }
        }
        //  The rings, spreading out of it while the mouse is on it.
        group {
            show: near.stone.$k > 0.01 and stone.$k > 0.5
            opacity: near.stone.$k
            ellipse { at: sx.$k, sy.$k; radius: 15 + 10 * fract(time * 0.9); stroke: 1.2; color: mint; opacity: 50% * (1 - fract(time * 0.9)) }
            ellipse { at: sx.$k, sy.$k; radius: 15 + 10 * fract(time * 0.9 + 0.5); stroke: 1.2; color: mint; opacity: 50% * (1 - fract(time * 0.9 + 0.5)) }
        }
        //  Its window's title, under it, while the mouse is on it.
        group {
            show: near.stone.$k > 0.01 and stone.$k > 0.5
            opacity: near.stone.$k
            move: 0, 5 * (1 - near.stone.$k)
            body {
                color: #0f1214
                shadow: 0, 6, 16, 40%
                box { at: sx.$k, sy.$k + 34; size: 180, 24; corner: 12; opacity: 94% }
            }
            text stones.$k.title { at: sx.$k, sy.$k + 34.5; anchor: center; size: 11.5; weight: 500; width: 164; lines: 1; color: ink }
        }
        zone ellipse stone_zone.$k { at: sx.$k, sy.$k; radius: 16; cursor: pointer; active: stone.$k > 0.6 }
        on enter stone_zone.$k { impulse touch.stone.$k 9; near.stone.$k: 1 }
        on leave stone_zone.$k { near.stone.$k: 0 }
        on press stone_zone.$k {
            near.stone.$k: 0
            emit restore_stone(k)
        }
    }

    // ── the preview ──────────────────────────────────────────────
    //  Below the fan, the most recent: who and the first line. It is what answers
    //  the question without opening anything, which is what hovering is for. It
    //  comes in a little after the drops, once they are in place.
    let preview.x = cx
    let preview.y = cy_actual + 82
    let preview.reveal = clamp(fan * 2 - 1, 0, 1)
    body {
        color: #0c0f12
        rim: 4%
        shadow: 0, 6, 14, 30%
        opacity: preview.reveal
        box { at: preview.x, preview.y; size: 250 * preview.reveal, 46 * preview.reveal; corner: 14 }
    }
    group {
        opacity: clamp(fan * 3 - 2, 0, 1)
        move: 0, (1 - preview.reveal) * 6
        box { at: preview.x - 116, preview.y; size: 3, 26; corner: 1.5; color: hue }
        text who { at: preview.x - 106, preview.y - 8; anchor: left center; size: 11.5; weight: 600; width: 200; lines: 1; color: #f6f6f5 }
        text line { at: preview.x - 106, preview.y + 8; anchor: left center; size: 10.5; width: 200; lines: 1; color: #a9adb3 }
    }
    //  The whole —her, the fan and the preview— for the grace on leaving: the gap
    //  between the three is real and must not be lost while crossing it.

    // ── the notice that arrives ──────────────────────────────────
    //  From the centre of the card to the shoulder along two different curves:
    //  sideways at a constant pace, and upwards quickly. The path bends.
    //
    //  And if several arrive, they stack: three in sight and «+N more». They fly
    //  together, each one a little after the previous one, and the boing is ONE,
    //  however many arrive. A mascot that jumps for every message in a group is
    //  a mascot that ends up switched off.
    let hue = mix(mix(mix(blue, lilac, reading_cat > 1.5), green, reading_cat > 2.5), amber, reading_cat > 3.5)
    let arrival.x0 = cx + 23 + 14 + 125
    let arrival.dx = cx + 31.7 * cos(-24) - arrival.x0
    let arrival.dy = 31.7 * sin(-24)

    //  It arrives as a drop: it falls from the top edge of the screen —her
    //  water's surface—, splashes beside her and unfolds into the card (land:
    //  falling a, splash b, unfolding c). With several, the pile is a fan of
    //  cards held in a hand, which opens under the pointer.
    let land.a = clamp(land / 0.45, 0, 1)
    let land.b = clamp((land - 0.45) / 0.25, 0, 1)
    let land.c = clamp((land - 0.55) / 0.45, 0, 1)
    repeat j in 0..3 {
        //  `behind` is how many it has on top: 0 is the front one.
        let behind = 2 - j
        let flight = fly.$j
        let front = if(behind == 0, 1, 0)
        let aw = (250 - behind * 22) + (8.3 - 250 + behind * 22) * flight
        let ah.rest = 44 + 30 * chips * front
        let ah = ah.rest + (8.3 - ah.rest) * flight
        //  Under the pointer the ones behind slide out to the right and turn,
        //  like cards held in a hand: they peek out beside the front one instead
        //  of hiding under it. Not upwards: she lives at the screen's top edge.
        let ax = arrival.x0 + arrival.dx * flight + (1 - arrive) * 30 + behind * 26 * pile.open * (1 - flight)
        let ay = cy_actual + 15 * chips * front + arrival.dy * (1 - (1 - flight) * (1 - flight)) + behind * (8 + 10 * pile.open) * (1 - flight)
        //  Only the front one falls: the others were already there.
        let fall.y = -12 + (ay + 12) * land.a * land.a
        let at.y = if(front > 0.5, fall.y, ay)
        let unf = if(front > 0.5, land.c, 1)
        let w = 10 + (aw - 10) * unf
        let h = 10 + (ah - 10) * unf
        body {
            //  The ones behind do not carry their colour until they fly: while
            //  they wait they are stacked paper, and the colour belongs to the one
            //  being read. Falling, it is water: its colour.
            color: mix(mix(mix(#0c0f12, #1f252a, behind > 0), hue, flight), hue, (1 - unf) * front)
            opacity: arrive
            shadow: 0, 6, 14, 30% * unf
            show: burst > behind
            box { at: ax, at.y; size: w, h; corner: min(h / 2, 14 + (h / 2 - 14) * flight)
                  rotate: behind * (2 + 5 * pile.open) * (1 - flight) * 1deg }
        }
        //  Flying to its count, it leaves a trail of drops.
        particles { at: ax, ay; count: 60; life: 0.2s .. 0.45s; speed: 5 .. 30; spread: 360deg; gravity: 0, 200
                    size: 2.6, 0.8; colors: hue, #ffffff; opacity: 80%, 0%; emit: flight > 0.04 and flight < 0.95 and burst > behind }
    }
    //  The splash where it lands, and the ring it leaves on the water.
    particles { at: arrival.x0 + (1 - arrive) * 30, cy_actual; area: 8, 0; count: 140; life: 0.25s .. 0.55s; speed: 40 .. 130
                direction: -90deg; spread: 150deg; gravity: 0, 520; size: 3, 1; colors: hue, #ffffff; opacity: 90%, 0%
                emit: land > 0.43 and land < 0.52 and arrive > 0.5 }
    ellipse { at: arrival.x0 + (1 - arrive) * 30, cy_actual; radius: 6 + 40 * land.b; stroke: 1.5; color: hue
              opacity: (1 - land.b) * 70% * if(land > 0.44, 1, 0) * arrive }

    //  The front card, once it is a card: who in a bubble, the words written by
    //  a wave, its reading as a water line that drains, and under the pointer
    //  what can be done with it.
    let f.x = arrival.x0 + (1 - arrive) * 30
    let f.h = 44 + 30 * chips
    let f.top = cy_actual + 15 * chips - f.h / 2
    let f.left = f.x - 125
    //  The chips' places: 0 Open, 1 Done, 4 «All» (only with a pile), 2 and 3
    //  its own actions after them —one fewer when «All» takes a place—.
    let pile.many = if(burst > 1, 1, 0)
    let chip.slot.0 = 0
    let chip.slot.1 = 1
    let chip.slot.4 = 2
    let chip.slot.2 = 2 + pile.many
    let chip.slot.3 = 3 + pile.many
    let chip.on.0 = 1
    let chip.on.1 = 1
    let chip.on.4 = pile.many
    let chip.on.2 = if(acts > 0, 1, 0)
    let chip.on.3 = if(acts > 1 and pile.many < 0.5, 1, 0)
    let f.show = arrive * clamp(land.c * 3 - 2, 0, 1)
    //  Urgent: a coral edge that beats.
    box { at: f.x, f.top + f.h / 2; size: 250, f.h; corner: 14; stroke: 1.6; color: #ef7a66
          opacity: f.show * (1 - clamp(fly.2 * 5, 0, 1)) * if(reading_urgent, 0.45 + 0.4 * sin(urgent.beat * 360), 0) }
    group {
        opacity: f.show * (1 - clamp(fly.2 * 5, 0, 1))
        //  Who: its icon in a bubble of glass with a halo of its colour; without
        //  one, a drop of that colour.
        group {
            glow: 8, 60%, hue
            ellipse { at: f.left + 21, f.top + 22; radius: 13; color: mix(#0c0f12, hue, 0.28) }
        }
        ellipse { at: f.left + 21, f.top + 22; radius: 13; stroke: 1.2; color: hue; opacity: 75% }
        ellipse { at: f.left + 17, f.top + 17; radius: 4; color: #ffffff; opacity: 14% }
        //  Under it always: if the icon does not load, the drop is there.
        ellipse { at: f.left + 21, f.top + 22; radius: 4; color: hue }
        component NoticeIcon(i: record) {
            size: 18, 18
            image i.icon { at: 0, 0; size: 18, 18 }
        }
        column notice_icon {
            at: f.left + 12, f.top + 13
            show: notice.icon
            for i in notice_face { NoticeIcon(i) }
        }
        //  The words, written by a wave passing left to right: each letter rises
        //  into its place as it arrives.
        text who { at: f.left + 42, f.top + 14; anchor: left center; size: 11.5; weight: 600; width: 160; lines: 1; color: #f6f6f5
                   letter_opacity: clamp(write * (letters + 8) - letter, 0, 1)
                   letter_move: 0, (1 - clamp(write * (letters + 8) - letter, 0, 1)) * 6 }
        text line { at: f.left + 42, f.top + 30; anchor: left center; size: 10.5; width: 196; lines: 1; color: #a9adb3
                    letter_opacity: clamp((write * 1.4 - 0.4) * (letters + 8) - letter, 0, 1)
                    letter_move: 0, (1 - clamp((write * 1.4 - 0.4) * (letters + 8) - letter, 0, 1)) * 6 }
        text "now" { at: f.left + 238, f.top + 14; anchor: right center; size: 9.5; color: #8b8f95; opacity: 1 - chips }
        //  Under the pointer, two small drops take its place: «later», a clock
        //  that brings it back in a while, and «mute», a bell that is crossed
        //  out, for the app that sent it.
        group {
            opacity: clamp(chips * 2 - 1, 0, 1)
            prop later.glow = 0 ~140ms
            prop hush.glow = 0 ~140ms
            ellipse { at: f.left + 208, f.top + 15; radius: 10; color: #ffffff; opacity: 7% + later.glow * 12% }
            ellipse { at: f.left + 208, f.top + 15; radius: 5; stroke: 1.3; color: mix(#a9adb3, #f6f6f5, later.glow) }
            line { from: f.left + 208, f.top + 15; to: f.left + 208, f.top + 12; width: 1.3; color: mix(#a9adb3, #f6f6f5, later.glow) }
            line { from: f.left + 208, f.top + 15; to: f.left + 210.5, f.top + 16.5; width: 1.3; color: mix(#a9adb3, #f6f6f5, later.glow) }
            ellipse { at: f.left + 232, f.top + 15; radius: 10; color: #ffffff; opacity: 7% + hush.glow * 12% }
            path { at: f.left + 232, f.top + 15; color: mix(#a9adb3, #f6f6f5, hush.glow)
                   move -4.5, 3; line -3.5, 1.5; line -3.5, -1.5; curve 0, -5.5 via -3.5, -5.5; curve 3.5, -1.5 via 3.5, -5.5; line 3.5, 1.5; line 4.5, 3; close }
            ellipse { at: f.left + 232, f.top + 19.5; radius: 1.3; color: mix(#a9adb3, #f6f6f5, hush.glow) }
            line { from: f.left + 227, f.top + 10; to: f.left + 237, f.top + 20; width: 1.4; color: #ef7a66; opacity: 60% + 40% * hush.glow }
        }
        //  Its reading, as water draining: when the line runs out it goes. The
        //  pointer over it stops it.
        box { from: f.left + 14, f.top + f.h - 6; size: 222 * clamp(1 - read.t, 0, 1), 2.4; corner: 1.2; color: hue; opacity: 80% }
        ellipse { at: f.left + 14 + 222 * clamp(1 - read.t, 0, 1), f.top + f.h - 4.8; radius: 2.3; color: hue; opacity: 90% * if(read.t < 0.99, 1, 0) }
        //  What can be done with it, like little drops: open it, done with it,
        //  and its own actions.
        group {
            opacity: clamp(chips * 2 - 1, 0, 1)
            repeat i in 0..5 {
                prop chip.glow.$i = 0 ~140ms
                let cx.i = f.left + 41 + chip.slot.$i * 58
                group {
                    show: chip.on.$i
                    box { at: cx.i, f.top + 58; size: 54, 22; corner: 11; color: #ffffff; opacity: 9% + chip.glow.$i * 12% }
                    text "Open" { at: cx.i, f.top + 58; anchor: center; size: 10.5; weight: 500; color: #f6f6f5; show: i == 0 }
                    text "Done" { at: cx.i, f.top + 58; anchor: center; size: 10.5; weight: 500; color: #f6f6f5; show: i == 1 }
                    text act.1 { at: cx.i, f.top + 58; anchor: center; size: 10.5; weight: 500; width: 48; lines: 1; color: #f6f6f5; show: i == 2 }
                    text act.2 { at: cx.i, f.top + 58; anchor: center; size: 10.5; weight: 500; width: 48; lines: 1; color: #f6f6f5; show: i == 3 }
                    text "All" { at: cx.i, f.top + 58; anchor: center; size: 10.5; weight: 500; color: #f6f6f5; show: i == 4 }
                }
            }
        }
        //  The one in front, done: a puff where it was.
        particles { at: f.x, cy_actual; area: 200, 20; count: 90; life: 0.3s .. 0.6s; speed: 10 .. 50; spread: 360deg
                    gravity: 0, -60; size: 3, 0.5; colors: #ffffff, hue; opacity: 60%, 0%; burst: notice_puff }
    }
    //  And the ones that do not fit, said and not drawn: «+N more» below the pile.
    text "+{burst - 3, 0} more" {
        at: arrival.x0 + 113, cy_actual + 40
        anchor: right center
        size: 9.5
        weight: 600
        color: #8b8f95
        opacity: arrive * (1 - clamp(fly.2 * 5, 0, 1))
        show: burst > 3
    }


    // ── the tray: the swell ──────────────────────────────────────
    //  Its place and its size. The shape is set by her body, further up; here go
    //  the measurements and what it has written on it.
    let tray.w = 520 * tray
    let tray.h = 460 * tray
    //  Stuck to her, not beside her: they overlap 17 px, and with that the
    //  melting makes a real neck. With the 40 gap the other card has there was
    //  nothing to melt and they stayed as two things side by side.
    let tray.x = cx + 6 + tray.w / 2
    let tray.y = cy_actual + tray.h / 2 - 8

    //  The grace zone goes BELOW the rows: the press belongs to the topmost
    //  zone, and declared at the end it kept every row's click.
    //  It closes on leaving the whole —her and the tray—, with the same 320 ms
    //  as the note: the gap between the two is real.
    zone box tray_area { at: cx + tray.w / 2, cy_actual + tray.h / 2 - 8; size: 2 * r + 40 + tray.w, 2 * r + 40 + tray.h; corner: 30; active: tray_open }
    //  Like the card: Esc or a click outside, not leaving it.

    group {
        opacity: clamp(tray * 2.6 - 1.6, 0, 1)
        let tx0 = tray.x - 232
        let ty0 = tray.y - 198

        text "SWELL" { at: tx0, ty0; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 35% }
        // ── the header, by columns ───────────────────────────────
        //  The title on the left, the lane of pills in the middle and «View all»
        //  on the right. The three places come from ONE sum, from the right edge
        //  inwards, so there is no way they can overlap: by hand, the fourth pill
        //  landed right on top of the button.
        let header.right = tray.x + 232
        let header.button = header.right - 39
        let header.lane = header.button - 39 - 22
        //  And what is being shown: «Now» is everything, and with a filter, the
        //  name of its category. You asked about the blue drop; it answers the
        //  question you asked.
        text "Now" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink; show: filter < 0.5 }
        text "Messages" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink; show: filter == 1 }
        text "Work" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink; show: filter == 2 }
        text "Calendar" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink; show: filter == 3 }
        text "System" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink; show: filter == 4 }
        //  And how to see everything again, or else it is a dead end.
        box { at: header.button, ty0 + 24; size: 78, 26; corner: 13; color: #202021; opacity: if(filter > 0.5, 1, 0) }
        text "View all" { at: header.button, ty0 + 24; anchor: center; size: 11.5; color: #8b8f95; show: filter > 0.5 }
        zone box show_all { at: header.button, ty0 + 24; size: 78, 26; corner: 13; cursor: pointer; active: tray > 0.9 and filter > 0.5 }
        on press show_all { filter = 0 }

        //  The lane: the drops go from her shoulder to the tray's header, and
        //  there they stay as pills with their count. The journey is along the
        //  arc —what is animated is the angle—, so they come out going around
        //  her and not cutting through.
        repeat k in 1..5 {
            let ang = -24 + 26 * slot.$k
            let gx = cx + 31.7 * cos(ang)
            let gy = cy_actual + 31.7 * sin(ang)
            //  Packed to the end of the lane and in their order —the same as on
            //  her shoulder—, not by their category's number: if one is missing,
            //  the others close up instead of leaving its gap.
            let rx = header.lane - slot.$k * 40
            let ry = ty0 + 24
            let px = gx + (rx - gx) * lane
            let py = gy + (ry - gy) * (1 - (1 - lane) * (1 - lane))
            group {
                opacity: shown.$k
                ellipse { at: px, py; radius: 7 + 4 * lane; color: mix(mix(mix(blue, lilac, k > 1.5), green, k > 2.5), amber, k > 3.5) }
                text number(n.$k, 0) { at: px, py + 0.5; anchor: center; size: 8.5 + 2 * lane; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 1, 0) }
            }
        }

        //  The rows. Each one arrives a little after the one above: that is the
        //  swell, and that is why they do not all come in at once like a list.
        //
        //  And they are clipped to the tray itself: dragging one to a side it
        //  came out of the panel and was seen floating over the desktop, which is
        //  exactly what a panel does not do. The clip goes inside its group,
        //  which is where it ends.
        group {
        clip inset 3 box { at: tray.x, tray.y; size: tray.w, tray.h; corner: 22 * tray }
        repeat k in 1..6 {
            let fy = ty0 + 76 + above.$k * 66 + (1 - rise.$k) * 26
            //  Where it rests, and where it is now. What is uncovered goes in the
            //  resting place —the gap it leaves— and not following it, or it
            //  would stay underneath it and never be seen.
            let fx0 = tx0 + 232
            let fx = fx0 + flung.$k * 520 + pull.$k
            //  How much it is being stretched: how far the finger has dragged it,
            //  with a cap so the corner does not eat the row.
            let stretch.$k = clamp(abs(pull.$k) + abs(flung.$k) * 120, 0, 150)
            //  The colour is that of ITS CATEGORY, not of its place in the list.
            //  It came from `k` —the row— and with five sample rows, one per
            //  category and in that order, it did not show: two Telegram notices
            //  in a row came out in different colours as soon as they arrived for
            //  real. It is what the demo mode uncovered.
            //
            //  And the amber of an urgent one overrides its category's: what
            //  matters about that row is no longer whose it is, it is that it is
            //  urgent.
            let color.$k = mix(mix(mix(mix(blue, lilac, row_cat.$k > 1.5), green, row_cat.$k > 2.5), amber, row_cat.$k > 3.5), #e2b25a, if(row_urgent.$k, 1, 0))
            group {
                opacity: rise.$k * (1 - flung.$k)
                show: visible.$k > 0.5
                //  What it uncovers when slid, to one side and the other: to the
                //  right, «Done»; to the left, «Dismiss». And they are two
                //  different things: what is done sends its drop back, **what is
                //  dismissed does not**, because what is dismissed does not come
                //  back.
                group {
                    opacity: clamp((pull.$k + flung.$k * 520) / 40, 0, 1)
                    box { at: fx0 - 160, fy; size: 130, 58; corner: 14; color: #1b2a22 }
                    text "Done" { at: fx0 - 160, fy; anchor: center; size: 12; weight: 600; color: mint }
                }
                group {
                    opacity: clamp((0 - pull.$k - flung.$k * 520) / 40, 0, 1)
                    box { at: fx0 + 160, fy; size: 130, 58; corner: 14; color: #2a1b1b }
                    text "Dismiss" { at: fx0 + 160, fy; anchor: center; size: 12; weight: 600; color: #e0655a }
                }
                //  Pulling a row stretches it: it lengthens where you pull, thins a
                //  little and rounds off, like a drop you are stretching. On
                //  letting go it comes back by itself with its spring, and the
                //  stretch undoes itself with it without anyone animating it
                //  separately.
                box { at: fx, fy; size: 456 + stretch.$k * 0.12, 58 - stretch.$k * 0.045
                      corner: 14 + stretch.$k * 0.10
                      color: mix(mix(#171717, #1d1d1e, touch.$k), #241f16, if(row_urgent.$k, 1, 0)) }
                //  Its category's bar, on the left: it is where the drop will come
                //  out of when it is resolved.
                box { at: fx - 214, fy; size: 4, if(row_urgent.$k, 46, 34); corner: 2; color: color.$k }
                text row.$k.app { at: fx - 200, fy - 18; anchor: left center; size: 8.5; weight: 700; color: color.$k }
                text row.$k.title { at: fx - 200, fy - 1; anchor: left center; size: 12.5; weight: 500; width: 300; lines: 1; color: ink }
                text row.$k.detail { at: fx - 200, fy + 17; anchor: left center; size: 10.5; width: 300; lines: 1; color: #8b8f95 }
                text row.$k.age { at: fx + 208, fy - 18; anchor: right center; size: 9.5; color: #8b8f95 }
            }
            zone box row_zone.$k { at: fx, fy; size: 456, 58; corner: 14; cursor: pointer; active: tray > 0.9 and visible.$k > 0.5 }
            on enter row_zone.$k { touch.$k: 1 }
            on leave row_zone.$k { touch.$k: 0 }
            on press row_zone.$k { emit resolve(k) }

            //  And the drop that comes back. It is born STUCK to its row's colour
            //  bar —melted with it— and comes loose on leaving: the pinch is not
            //  drawn, it comes from the distances, like the one at the water's edge.
            let vx = fx - 214 + (cx + 31.7 * cos(-24) - fx + 214) * freed.$k
            let vy = fy + (cy_actual + 31.7 * sin(-24) - fy) * (1 - (1 - freed.$k) * (1 - freed.$k))
            body {
                color: color.$k
                opacity: clamp(freed.$k * 8, 0, 1) * (1 - clamp(freed.$k * 8 - 7, 0, 1))
                box { at: fx - 214, fy; size: 4, 34 * (1 - freed.$k); corner: 2; blend: 14 * 4 * freed.$k * (1 - freed.$k) }
                ellipse { at: vx, vy; radius: 4 + 3 * freed.$k; blend: 14 * 4 * freed.$k * (1 - freed.$k) }
            }
        }

        }

        //  The footer: what has arrived, and its settings. While it can be undone
        //  its place belongs to the fuse, which is more urgent than a link.
        group {
            show: not undoable
            text "History" { at: tx0, tray.y + 198; anchor: left center; size: 11.5; color: mix(#8b8f95, ink, hist_link.glow) }
            zone box hist_link { from: tx0 - 6, tray.y + 186; size: 80, 24; corner: 8; cursor: pointer; active: tray > 0.9 and not undoable }
            text "Settings" { at: tray.x + 232, tray.y + 198; anchor: right center; size: 11.5; color: #8b8f95 }
        }

        // ── undo, with its fuse ──────────────────────────────────
        //  Five seconds, and you can see how many are left: the fuse burns from
        //  left to right at a constant pace. Seeing the time go is what makes it
        //  unnecessary to read «5 s» anywhere.
        group {
            show: undoable
            let undo.y = tray.y + 198
            prop undo.glow = 0 ~140ms
            box { at: tray.x, undo.y; size: 456, 40; corner: 12; color: mix(#1b1b1c, #232425, undo.glow) }
            //  The fuse, stuck to the bottom edge of its pill.
            box { from: tray.x - 228, undo.y + 16; size: 456 * fuse, 4; corner: 2; color: mint }
            text "Done. Undo it?" { at: tray.x - 208, undo.y - 3; anchor: left center; size: 11.5; color: #8b8f95 }
            text "Undo" { at: tray.x + 192, undo.y - 3; anchor: right center; size: 12; weight: 600; color: mint }
            zone box undo_zone { at: tray.x, undo.y; size: 456, 40; corner: 12; cursor: pointer; active: undoable }
            on enter undo_zone { undo.glow: 1 }
            on leave undo_zone { undo.glow: 0 }
        }
    }

    //  The panel's grace zone goes BELOW what it holds inside: the press belongs
    //  to the topmost zone, and declared at the end it kept ALL the card's
    //  clicks. It is the third time.
    //  It no longer closes on leaving: a card is closed with Esc, a click
    //  outside (the catcher) or its ×. Closing on leaving it took away the
    //  page you were reading as soon as the mouse went to write something.
    zone box card_area { at: cx + card * 300, cy_actual + card.h / 2 - 8; size: 200 + card.w + 80, 2 * r + 30 + card.h; corner: 30; active: open }


    //  And the grace zone —her and the menu— goes BELOW the rows, like all the
    //  others: declared after, it kept their clicks. That makes five.
    zone box menu_area { at: cx + 60, menu.cy; size: 300, menu.h + 90; corner: 24; active: menu > 0.01 }

    // ── the notice that arrives while she sleeps ─────────────────
    //  The drop forms hanging from the top edge —from the same place she hangs
    //  from when she is sunk, because it is the same water—, lets go and sinks
    //  into her. And from where it has fallen a ripple of its colour spreads.
    let drip.t = clamp(droplet, 0, 1)
    let drip.fall = clamp(droplet - 1, 0, 1)
    let drip.y = 5 + drip.fall * (cy_actual - 5)
    let drip.r = 4.6 * drip.t
    //  A real drop: the tip up while it hangs, round as it falls.
    path { at: cx, drip.y; color: hue; opacity: drip.t * (1 - drip.fall * drip.fall)
           move 0, -6 + drip.fall * 2.4; curve 4.2, 1.8 via 4.2, -2.4; curve 0, 5.8 via 4.2, 4.8
           curve -4.2, 1.8 via -4.2, 4.8; curve 0, -6 + drip.fall * 2.4 via -4.2, -2.4; close }
    //  And the ripple: a ring of its colour that comes out of her and dissolves.
    arc { at: cx, cy_actual; radius: 21 + ripple.drip * 26; span: 360deg; width: 2.4 * (1 - ripple.drip)
          color: hue; opacity: (1 - ripple.drip) * 70% * clamp(ripple.drip * 8, 0, 1) }

    // ── the asleep «z» ───────────────────────────────────────────
    //  A single one, discreet: it rises, opens a little and dissolves. No three
    //  z's in a row, which is what turns a mascot into a sticker.
    //  And it goes beside her, not on top: up there is the edge of the screen,
    //  which is the same reason the drops go down her shoulder. Over her head the
    //  «z» came out half cut off and could not be seen.
    text "z" { at: cx + 26 + zee * 7, cy_actual - 6 - zee * 15; anchor: center
               size: 10 + zee * 7; weight: 600; color: #dfe6e2
               opacity: drowsy * clamp(zee * 6, 0, 1) * (1 - zee * 0.9) * 95% }

    // ── the sweat drop ───────────────────────────────────────────
    //  «On her, an exclamation mark on the face, a drop of sweat and a short
    //  jump.» It appears with the exclamation mark, slips a little and goes: it
    //  is a reaction, not a state, and that is why it does not last as long as
    //  the urgency —that is what the amber drop on her shoulder does—. It goes on
    //  her left because the tray comes out on her right, which is what the
    //  urgent one has just opened.
    prop sweat = 0 ~180ms
    prop slip = 0 ~900ms
    on change face == alert while face == alert {
        sweat: 1
        slip: 0 ~16ms
        slip: 1 ~900ms after 60ms
        sweat: 0 ~300ms after 1100ms
    }
    //  A real drop: the tip up and the fat body down, which is what makes it
    //  read as a drop and not as an oval.
    path { at: cx - 19, cy_actual - 18 + slip * 9; color: #bfe6f2; opacity: sweat * 88%
           move 0, -5.5; curve 3.6, 1.6 via 3.6, -2.2; curve 0, 5.4 via 3.6, 4.4
           curve -3.6, 1.6 via -3.6, 4.4; curve 0, -5.5 via -3.6, -2.2; close }

    // ── the wardrobe ─────────────────────────────────────────────
    //  The pieces are SVG: they are drawn in an editor, dropped into `wardrobe/`
    //  and they are ready. Each layer is a real path —not a stamp—, so it is
    //  tinted, melts and turns on its pivot, and the physics is given by the
    //  SPOT: the hat rests, the glasses are stuck on, the mug keeps her company.
    figure hat = file "wardrobe/hat.svg"
    figure glasses = file "wardrobe/glasses.svg"
    figure mug = file "wardrobe/mug.svg"
    figure phones = file "wardrobe/phones.svg"

    fact wears.hat = false
    fact wears.glasses = false
    fact wears.mug = false
    fact wears.phones = false
    //  Putting it on is not switching it on: it falls on top with its spring, and
    //  on taking it off it leaves the way it came.
    repeat k in 1..5 {
        prop worn.$k = 0 ~lively
    }
    follow worn.1 = if(wears.hat, 1, 0)
    follow worn.2 = if(wears.glasses, 1, 0)
    follow worn.3 = if(wears.mug, 1, 0)
    follow worn.4 = if(wears.phones, 1, 0)
    //  The headphones' light: mint at rest, and on air —coral, breathing—
    //  while the screen is shared.
    prop on_air = 0 ~180ms
    follow on_air = if(sharing, 1, 0)
    prop air_glow = 0
    wave air_glow = 1 at 0.6
    //  The sway of what keeps her company: it floats even if she keeps still.
    prop sway = 0
    wave sway = 1 at 0.9

    //  On top: it rests on her head, arrives late and tilts from the lag.
    Perched(cx, cy_actual, gaze.x, worn.1, lift: 30) {
        figure hat.brim     { at: 0, 0; size: 58, 43 }
        figure hat.crown    { at: 0, 0; size: 58, 43 }
        figure hat.pompom   { at: 0, 0; size: 58, 43 }
    }
    //  On her face: it chases nothing, it inherits what is hers. What is passed
    //  to it is **her** turn and squash, with her centre as pivot, and the piece
    //  is placed inside: that way the squash squashes it as it squashes the
    //  face, and not around itself.
    //
    //  And they go where her eyes are: 2.5 px below her centre, with the same
    //  gaze as them. Before they were 2 px ABOVE and with half the gaze, so they
    //  stayed on her forehead and looked the other way.
    Pinned(cx, cy_actual, tilt + lean, sx, sy, worn.2) {
        figure glasses { at: face.dx, 2.5 + face.dy + look.y + face.sink; size: 44, 24 }
    }
    //  Over her head and round it, stuck on as the glasses are: they squash and
    //  turn with her. They do not follow her gaze: they are on her head, not on
    //  her eyes.
    Pinned(cx, cy_actual, tilt + lean, sx, sy, worn.4) {
        figure phones.band   { at: 0, 0; size: 64, 64 }
        figure phones.cups   { at: 0, 0; size: 64, 64 }
        figure phones.accent { at: 0, 0; size: 64, 64 }
        figure phones.boom   { at: 0, 0; size: 64, 64 }
        ellipse { at: -6.8, 21.2; radius: 4.5 + 1.5 * air_glow; color: #ef7a66; opacity: on_air * (22% + 18% * air_glow) }
        figure phones.led    { at: 0, 0; size: 64, 64; color: mix(#9ed6bd, #ef7a66, on_air) }
    }
    //  Beside her: it keeps her company, stays behind and floats.
    Tagalong(cx, cy_actual, worn.3, sway, apart: 42) {
        figure mug { at: 0, 0; size: 34, 34 }
    }

    // ── what is seen of the finder ───────────────────────────────
    //  It goes here for the same reason as the menu: the card's clip is loose and
    //  takes with it everything that comes after.
    let bx0 = finder.x - 300
    let by0 = finder.y - finder.h / 2

    //  A row. The logic brings the list, so it is a component: each copy with its
    //  spring and its zone.
    component ResultRow(h: record, pick: event, cue: number) {
        size: 600, 44
        prop glow = 0 ~140ms
        //  Its turn: the top one comes in earlier, and the last one somewhat later.
        let arrive = clamp(cue * 8 - h.index, 0, 1)
        //  Only with the finder open. Closed, these rows are still filled —«At
        //  hand» is loaded on starting— and below the control center: a click on
        //  a gap in the panel went through them and launched a terminal.
        //  A file or a folder can be dragged out of her to any program —into a
        //  browser to upload it, into a folder to copy it—: it carries its path.
        zone box touch { from: 0, 0; size: 600, 44; corner: 12; cursor: pointer; active: searching; carries: "{h.path}" }
        box { from: 0, 0; size: 600, 44; corner: 12; color: #23282b; opacity: glow * 70% * arrive }
        group {
            opacity: arrive
            move: (1 - arrive) * -14, 0
                //  An image's `at` is its CORNER, not its centre —the opposite of
            //  a box or a figure—, so centring it in a 44 row is (44 − 30) / 2.
            //  Placed at the centre it came out 8 px too low.
            image h.icon { at: 8, 7; size: 30, 30; show: h.glyph < 0.5 }
            //  What is hers —a page, a trick of hers— is not an application:
            //  it comes with a little her, with the face of what it does. Waves
            //  for the agents' water, «^ ^» to celebrate, brows for the rage,
            //  and her plain eyes for the rest. Under the mouse she hops a
            //  little and looks at what is written.
            group {
                show: h.glyph > 0.5
                move: 0, -2.5 * glow
                ellipse { at: 23, 22; radius: 14; color: #2b2f33 }
                ellipse { at: 23, 22; radius: 13.4; stroke: 1.2; color: #ffffff; opacity: 16% + glow * 14% }
                box { at: 19 + 1.5 * glow, 22; size: 3.4, 6.6; corner: 1.7; color: #f5f7f5; show: h.glyph == 1 or h.glyph == 3 }
                box { at: 27 + 1.5 * glow, 22; size: 3.4, 6.6; corner: 1.7; color: #f5f7f5; show: h.glyph == 1 or h.glyph == 3 }
                arc { at: 19, 23.5; radius: 2.8; span: 170deg; width: 1.8; color: #f5f7f5; show: h.glyph == 2 }
                arc { at: 27, 23.5; radius: 2.8; span: 170deg; width: 1.8; color: #f5f7f5; show: h.glyph == 2 }
                line { from: 16.5, 16.5; to: 21, 18.5; width: 1.6; color: #f5f7f5; show: h.glyph == 3 }
                line { from: 29.5, 16.5; to: 25, 18.5; width: 1.6; color: #f5f7f5; show: h.glyph == 3 }
                repeat e in 0..2 {
                    arc { at: 17.6 + e * 8, 23; radius: 1.7; span: 170deg; width: 1.5; color: #9ed6bd; show: h.glyph == 4 }
                    arc { at: 21 + e * 8, 21.4; radius: 1.7; span: 170deg; width: 1.5; rotate: 180deg; color: #9ed6bd; show: h.glyph == 4 }
                }
            }
            text h.name { at: 48, 22; anchor: left center; size: 14; width: 400; lines: 1
                            color: mix(#dfe1e3, #f6f6f5, glow) }
            text h.kind_label { at: 592, 22; anchor: right center; size: 11.5; color: #8b8f95 }
        }
        on enter touch { glow: 1 }
        on leave touch { glow: 0 }
        //  On letting go, not on pressing: a press may be the start of dragging
        //  it out, and then it is not opened.
        on release touch { emit pick(h.index) }
        //  Dragged out, the finder goes: what it is let go on is what is
        //  underneath, not her catcher.
        on carry touch { searching = false }
    }

    // ── the shots ────────────────────────────────────────────────
    //  Where each one lands, on her surface: around her and below, never on her.
    event bang.1
    event bang.2
    event bang.3
    event bang.4
    event bang.5
    let tgt.x.1 = 170
    let tgt.y.1 = 250
    let tgt.x.2 = 560
    let tgt.y.2 = 330
    let tgt.x.3 = 300
    let tgt.y.3 = 470
    let tgt.x.4 = 660
    let tgt.y.4 = 190
    let tgt.x.5 = 110
    let tgt.y.5 = 440
    //  She aims at the next one: as soon as a shot is fired, at the one after.
    let aim.next = min(5, 1 + round(shot.1 + shot.2 + shot.3 + shot.4 + shot.5))
    prop aim.x = 170 ~quick
    prop aim.y = 250 ~quick
    follow aim.x = if(aim.next < 1.5, tgt.x.1, if(aim.next < 2.5, tgt.x.2, if(aim.next < 3.5, tgt.x.3, if(aim.next < 4.5, tgt.x.4, tgt.x.5))))
    follow aim.y = if(aim.next < 1.5, tgt.y.1, if(aim.next < 2.5, tgt.y.2, if(aim.next < 3.5, tgt.y.3, if(aim.next < 4.5, tgt.y.4, tgt.y.5))))
    //  The pistol, on the side she aims to: it swaps hands, and flips so the
    //  grip stays down.
    let side = if(aim.x < cx, -1, 1)
    //  Blowing, the pistol comes up beside her mouth, barrel to the sky.
    let gun.x = cx + (40 - 12 * blow) * side
    let gun.y = cy_actual + 14 + 8 * blow
    let gun.aim = atan2(aim.y - gun.y, aim.x - gun.x)
    //  Up is −90° from the right hand and 270° from the left: the nearer way round.
    let gun.angle = gun.aim + (if(side > 0, -90, 270) - gun.aim) * blow
    let muzzle.x = gun.x + cos(gun.angle) * 36
    let muzzle.y = gun.y + sin(gun.angle) * 36

    //  The broken glass: a shader of her own at each hole, bending what is
    //  behind the screen. And the shards that jump out of it.
    shader cracks = file "shaders/cracks.wgsl"
    repeat k in 1..6 {
        on change shot.$k > 0.5 while shot.$k > 0.5 and raging { emit bang.$k }
        on bang.$k { crack.$k: 1 ~300ms; flash: 1 ~16ms; flash: 0 ~120ms after 50ms; play recoil }
        shader cracks { at: tgt.x.$k - 140, tgt.y.$k - 140; size: 280, 280; values: crack.$k, k * 1.37, fade
                        show: crack.$k > 0.01 and fade > 0.01 }
        particles { at: tgt.x.$k, tgt.y.$k; count: 45; life: 0.5s .. 1.1s; speed: 60 .. 280; spread: 360deg
                    gravity: 0, 700; drag: 0.6; size: 3.2, 1; colors: #ffffff, #bfe3ff; opacity: 95%, 0%
                    shape: square; burst: bang.$k }
        particles { at: tgt.x.$k, tgt.y.$k; count: 25; life: 0.4s .. 0.9s; speed: 20 .. 90; spread: 360deg
                    drag: 2; size: 5, 9; colors: #8a8f96, #5a5e63; opacity: 35%, 0%; burst: bang.$k }
        //  The tracer: from the muzzle to the hole, too fast to see as anything
        //  but a streak.
        particles { at: muzzle.x, muzzle.y; count: 2; life: length(tgt.x.$k - muzzle.x, tgt.y.$k - muzzle.y) / 3200
                    speed: 3200; direction: atan2(tgt.y.$k - muzzle.y, tgt.x.$k - muzzle.x) * 1deg; spread: 0
                    size: 3, 3; colors: #fff6d8; opacity: 100%, 100%; shape: spark; burst: bang.$k }
        //  And the flash's sparks, out of the muzzle.
        group {
            glow: 8, 120%
            mode: add
            particles { at: muzzle.x, muzzle.y; count: 20; life: 0.08s .. 0.22s; speed: 90 .. 260
                        direction: gun.angle * 1deg; spread: 60deg; size: 3, 0; colors: #fff1b8, #ff8a3d; shape: spark; burst: bang.$k }
        }
    }

    //  The pistol itself: slide, barrel, frame, grip and trigger guard, drawn
    //  pointing right from its pivot and turned to where she aims. It slides
    //  out of her, and kicks back and up with every shot.
    group {
        opacity: gun
        pivot: gun.x, gun.y
        rotate: gun.angle * 1deg - kick * 0.35 * side - (1 - gun.twirl) * 4 * 3.14159265 * side
        scale: 0.4 + 0.6 * gun, (0.4 + 0.6 * gun) * side
        move: (1 - gun) * -26 * side, 0
        box { at: gun.x + 17 - 6 * kick, gun.y - 4; size: 30, 9; corner: 2; color: #2b2e33 }
        box { at: gun.x + 33 - 6 * kick, gun.y - 4; size: 3, 6; corner: 1; color: #121416 }
        box { at: gun.x + 13 - 6 * kick, gun.y + 1.5; size: 22, 5; corner: 1.5; color: #22252a }
        box { at: gun.x + 5 - 6 * kick, gun.y + 10; size: 9, 17; corner: 2.5; rotate: 0.28; color: #1b1d20 }
        ellipse { at: gun.x + 14 - 6 * kick, gun.y + 7; radius: 3.6; stroke: 1.6; color: #1b1d20 }
        line { from: gun.x + 4 - 6 * kick, gun.y - 8; to: gun.x + 31 - 6 * kick, gun.y - 8; width: 1; color: ink; opacity: 25% }
        box { at: gun.x + 22 - 6 * kick, gun.y - 4; size: 6, 2; corner: 1; color: ink; opacity: 12% }
    }
    //  The smoke she blows off: grey puffs that grow, rise and thin out.
    particles { at: muzzle.x, muzzle.y; count: 60; life: 0.9s .. 1.6s; speed: 12 .. 34; direction: -90deg; spread: 50deg
                drag: 0.8; size: 4, 15; colors: #b8bcc2, #7d8288; opacity: 45%, 0%; emit: blow > 0.8 and raging }
    //  The muzzle flash: a bright star that lasts a blink.
    group {
        glow: 12, 140%
        mode: add
        ellipse { at: muzzle.x, muzzle.y; radius: 9 * flash; color: #fff1b8; opacity: flash }
        ellipse { at: muzzle.x + cos(gun.angle) * 8, muzzle.y + sin(gun.angle) * 8; radius: 5 * flash; color: #ff9f43; opacity: flash }
    }

    // ── the fireworks ────────────────────────────────────────────
    //  Seven rockets, one after another. Each one is a spring from her to
    //  where it bursts —critically damped, so it slows as it arrives, like a
    //  rocket at the top of its climb—, with a slight bow sideways so it does
    //  not fly like a ruler. While it flies it leaves a trail of sparks; on
    //  arriving, its event lets out the burst. She lives against the top
    //  edge, so they fan out downwards and to the sides.
    //  Here and not further down: after the card's loose clip everything is
    //  the card's, and with the card closed they did not show at all.
    event boom.1
    event boom.2
    event boom.3
    event boom.4
    event boom.5
    event boom.6
    event boom.7
    on celebrate {
        fw.rise.1: 0 ~16ms; fw.rise.1: 1 ~700ms after 120ms
        fw.rise.2: 0 ~16ms; fw.rise.2: 1 ~700ms after 330ms
        fw.rise.3: 0 ~16ms; fw.rise.3: 1 ~700ms after 520ms
        fw.rise.4: 0 ~16ms; fw.rise.4: 1 ~700ms after 740ms
        fw.rise.5: 0 ~16ms; fw.rise.5: 1 ~700ms after 960ms
        fw.rise.6: 0 ~16ms; fw.rise.6: 1 ~700ms after 1250ms
        fw.rise.7: 0 ~16ms; fw.rise.7: 1 ~700ms after 1500ms
    }
    group {
        glow: 10, 110%
        mode: add
        repeat k in 1..8 {
            prop fw.rise.$k = 0 ~700ms
            //  Where it bursts, from her: a fan from left to right, alternating
            //  near and far so two neighbours do not burst on top of each other.
            let fw.ang = 200 - (k - 1) * 36.6
            let fw.far = if(k == 2 or k == 4 or k == 6, 115, 175)
            let fw.tx = cx + cos(fw.ang - 180) * fw.far * -1
            let fw.ty = cy_actual + 40 + abs(sin(fw.ang - 180)) * fw.far * 0.8 + 30
            let fw.color = mix(mix(mix(mix(mix(mix(amber, mint, k > 1.5), lilac, k > 2.5), blue, k > 3.5), #ff6f91, k > 4.5), green, k > 5.5), #ffd166, k > 6.5)
            //  The rocket: from her centre to its point, bowed a little.
            let fw.bow = 4 * fw.rise.$k * (1 - fw.rise.$k) * 18 * if(k < 4, -1, 1)
            let fw.x = cx + (fw.tx - cx) * fw.rise.$k + fw.bow
            let fw.y = cy_actual + (fw.ty - cy_actual) * fw.rise.$k
            let flying = fw.rise.$k > 0.03 and fw.rise.$k < 0.95 and celebrating
            particles { at: fw.x, fw.y; count: 90; life: 0.25s .. 0.6s; speed: 4 .. 30; size: 2.6, 0
                        colors: fw.color, #fff3d6; opacity: 90%, 0%; emit: flying }
            ellipse { at: fw.x, fw.y; radius: 2.6; color: #fff3d6; opacity: if(flying, 1, 0) }
            on change fw.rise.$k > 0.95 while fw.rise.$k > 0.95 and celebrating { emit boom.$k }
            //  The burst: a ring of streaks that the air brakes and gravity bends,
            //  and a few slower sparks that linger as it falls apart.
            particles { at: fw.tx, fw.ty; count: 160; life: 0.9s .. 1.5s; speed: 90 .. 200; drag: 1.8
                        gravity: 0, 70; size: 3, 0.6; colors: fw.color, #ffffff; opacity: 100%, 0%
                        shape: spark; burst: boom.$k }
            particles { at: fw.tx, fw.ty; count: 60; life: 1.2s .. 2s; speed: 20 .. 70; drag: 1.2
                        gravity: 0, 40; size: 2.2, 0; colors: #ffffff, fw.color; opacity: 90%, 0%; burst: boom.$k }
        }
    }

    //  The clip goes INSIDE a group, and with it everything of its own: loose it
    //  would take with it whatever came after —the menu— up to the next named
    //  surface, which is what happened right after writing it. A clip ends where
    //  its group ends, and that is what is wanted here.
    group {
    clip inset 2 box { at: finder.x, finder.y; size: finder.w, finder.h; corner: 22 * finder }
    group {
        opacity: finder_content
        move: 0, (1 - finder_content) * 10
        text "MAREA" { at: bx0, by0 + 22; anchor: left center; size: 9; weight: 600; color: mint; opacity: 80% }
        //  The field's magnifying glass: the same one she wears on her face.
        arc { at: bx0 + 14, by0 + 54; radius: 8; span: 360deg; width: 2.2; color: ink; opacity: 75% }
        line { from: bx0 + 20, by0 + 60; to: bx0 + 26, by0 + 66; width: 2.4; color: ink; opacity: 75% }
        input query { at: bx0 + 40, by0 + 54; width: 470; size: 21; color: ink
                         placeholder: "What do you want to find?"; selection: #2f5f52 }
        box { at: bx0 + 570, by0 + 54; size: 44, 26; corner: 8; color: #202021 }
        text "Esc" { at: bx0 + 570, by0 + 54; anchor: center; size: 11.5; color: #8b8f95 }
        text "Apps, windows, files and folders" { at: bx0 + 40, by0 + 86; anchor: left center; size: 11.5; color: #8b8f95 }
        line { from: bx0, by0 + 108; to: bx0 + 600, by0 + 108; width: 1; color: ink; opacity: 10% }
        text "At hand" { at: bx0 + 8, by0 + 126; anchor: left center; size: 11; weight: 600; color: #8b8f95
                        show: not typing }
        text "Results" { at: bx0 + 8, by0 + 126; anchor: left center; size: 11; weight: 600; color: #8b8f95
                            show: typing }
        //  The selection is ONE single one that travels between rows with its
        //  spring, not one per row lighting up and going out. It is what makes
        //  choosing with the arrows read as moving something and not as blinking.
        box { at: finder.x - 2, sel_y; size: 600, 44; corner: 12; color: mint; opacity: 16% * clamp(results.count, 0, 1) }
        box { at: bx0 + 2, sel_y; size: 3, 24; corner: 1.5; color: mint; opacity: clamp(results.count, 0, 1) }
        column result_list {
            at: bx0, by0 + 140
            gap: 2
            for h in results { ResultRow(h, pick: open_result, cue: stagger) }
        }
        text "↑↓ choose · Enter open" { at: finder.x, by0 + finder_h - 20; anchor: center; size: 11; color: #8b8f95; opacity: 70% }
        text "Nothing here" { at: finder.x, by0 + 164; anchor: center; size: 12.5; color: #8b8f95
                               show: results.count < 1 }
    }
    }

    // ── what is seen of her menu ─────────────────────────────────
    //  The drawing goes here and the zones at the very end, and it is not a
    //  whim: the card's clip is loose and takes with it everything that comes
    //  after up to the next named surface, so a menu written further down came
    //  out clipped to a closed card —that is, it did not come out—.
    //  An add-on's entry. It is a piece and not six copies written by hand
    //  because the logic brings the list: each copy has its spring and its zone,
    //  and the row pointed at with the keyboard is passed in from outside.
    component MenuRow(e: record, marked: number, pick: event) {
        size: 155, 23 + e.first * 16
        prop glow = 0 ~110ms
        let fy = e.first * 16
        let is_marked = if(marked == e.index, 1, 0)
        //  The name of whoever brings it, only above the first of its group.
        text e.group_name { at: 8, 8; anchor: left center; size: 9.5; weight: 600; color: #6f7378
                       width: 139; lines: 1; show: e.first }
        //  At rest the row has no background: the box's is hers, since the box is
        //  hers. The only thing painted is what is pointed at.
        box { from: 0, fy; size: 155, 23; corner: 7; color: #23282b; opacity: glow }
        //  The pointer's highlight is filled; the keyboard's is an outline. They
        //  are two different things and that is why they look different.
        box { from: 0, fy; size: 155, 23; corner: 7; stroke: 1; color: mint; opacity: is_marked * (1 - glow) }
        //  Without an icon catalogue, an entry's glyph is its little square.
        box { at: 13, fy + 11.5; size: 9, 9; corner: 2.5; stroke: 1.4; color: mix(#8b8f95, #f6f6f5, glow) }
        text e.title { at: 26, fy + 11.5; anchor: left center; size: 12; width: 122; lines: 1
                        color: mix(#dfe1e3, #f6f6f5, glow) }
        zone box touch { from: 0, fy; size: 155, 23; corner: 7; cursor: pointer }
        on enter touch { glow: 1 }
        on leave touch { glow: 0 }
        on press touch { emit pick(e.index) }
    }

    group {
        opacity: clamp(menu * 4 - 3, 0, 1)
        move: (1 - menu) * -13, 0
        let mx0 = menu.x - menu.w / 2 + 4
        //  The two house ones. They are written out and not in the model because
        //  they are hers: an add-on cannot add or remove Settings.
        repeat m in 0..4 {
            prop own.$m = 0 ~110ms
            box { at: menu.x, menu.y0 + 15.5 + m * 23; size: 155, 23; corner: 7
                  color: #23282b; opacity: own.$m }
            box { at: menu.x, menu.y0 + 15.5 + m * 23; size: 155, 23; corner: 7; stroke: 1; color: mint
                  opacity: if(menu_selected == m, 1, 0) * (1 - own.$m) }
        }
        let ry.search = menu.y0 + 15.5
        let ry.settings = menu.y0 + 38.5
        let ry.custom = menu.y0 + 61.5
        let ry.sleep = menu.y0 + 84.5
        //  Search goes first because it is what is done most. And its icon is the
        //  magnifying glass, the same one that appears on her face.
        arc { at: mx0 + 12, ry.search - 1; radius: 4.6; span: 360deg; width: 1.5; color: mix(#8b8f95, #f6f6f5, own.0) }
        line { from: mx0 + 15, ry.search + 2; to: mx0 + 18, ry.search + 5; width: 1.6; color: mix(#8b8f95, #f6f6f5, own.0) }
        text "Search…" { at: mx0 + 26, ry.search; anchor: left center; size: 12; color: mix(#dfe1e3, #f6f6f5, own.0) }
        //  The Settings gear, the same one as in the panel's header.
        arc { at: mx0 + 13, ry.settings; radius: 5; span: 300deg; width: 1.4; color: mix(#8b8f95, #f6f6f5, own.1) }
        ellipse { at: mx0 + 13, ry.settings; radius: 1.9; color: mix(#8b8f95, #f6f6f5, own.1) }
        text "Settings" { at: mx0 + 26, ry.settings; anchor: left center; size: 12; color: mix(#dfe1e3, #f6f6f5, own.1) }
        //  And Customize's sparkle: a four-pointed star, which is a square whose
        //  sides have been eaten away.
        path { at: mx0 + 13, ry.custom; color: mix(#8b8f95, #f6f6f5, own.2)
               move 0, -5.5; curve 5.5, 0 via 1.2, -1.2; curve 0, 5.5 via 1.2, 1.2
               curve -5.5, 0 via -1.2, 1.2; curve 0, -5.5 via -1.2, -1.2; close }
        text "Customize" { at: mx0 + 26, ry.custom; anchor: left center; size: 12; color: mix(#dfe1e3, #f6f6f5, own.2) }
        //  And the third house one: sleep. In Marea these are the control
        //  center's «zZ»; here the center is the sheet's —three cards, and none of
        //  them is this one—, so it goes with hers, which is where the things
        //  SHE does are.
        text "z" { at: mx0 + 10, ry.sleep - 3; anchor: center; size: 9; weight: 600
                   color: mix(#8b8f95, #f6f6f5, own.3) }
        text "z" { at: mx0 + 16, ry.sleep + 3; anchor: center; size: 12; weight: 600
                   color: mix(#8b8f95, #f6f6f5, own.3) }
        text "Sleep" { at: mx0 + 26, ry.sleep; anchor: left center; size: 12; color: mix(#dfe1e3, #f6f6f5, own.3) }
        //  The line, and below it the add-ons' stuff.
        line { from: mx0 + 8, menu.y0 + 99; to: mx0 + 147, menu.y0 + 99; width: 1; color: #1f2226 }
        column menu_col {
            at: mx0, menu.y0 + 102
            gap: 0
            for e in entries { MenuRow(e, marked: menu_selected - 4, pick: menu_entry) }
        }
    }

    // ── the card ─────────────────────────────────────────────────
    //  The control center, measured on the sheet
    //  (`design/concepts/2026-08-31-centro-y-apps/centro-de-control.png`): the
    //  ball measures 70 there and 46 here, so everything goes times 46/70.
    //
    //  Three cards, not six: Wi-Fi, Bluetooth and Focus. And the two levels are
    //  **brightness and volume**, with their icon BELOW the track, the label and
    //  the percentage in mint. The six and the orbit belong to the current
    //  ControlCenter, which is no longer this sheet.
    let card.w = 520 * card
    let card.h = 510 * card
    //  Stuck to her, not beside her: they overlap 17 px and with that the melting
    //  makes a neck. It is the same as the tray, and for the same reason: the
    //  card does not appear beside her, it comes out of her.
    //  The card's corner: the sheet's as soon as there is a card, and fatter and
    //  fatter in proportion as it goes, so that the last thing that goes into her
    //  is a drop and not a little box with corners.
    let card.corner = max(22 * card, min(card.w, card.h) / 2 * (1 - card))
    let card.x = cx + 6 + card.w / 2
    let card.y = cy_actual + card.h / 2 - 8
    //  And its top edge, which is where EVERYTHING inside hangs from. Written from
    //  the centre, adding a card moved the whole panel and the separator, the
    //  audio section and the pages had to be rearranged by hand. From the top,
    //  growing is growing downwards and the rest stays where it was.
    let card.top = card.y - card.h / 2


    // ── Deriva's pool: something carried over her ────────────────
    //  The water opens under her while something from another program is
    //  carried over: rings that spread, «Drop it in Deriva», and on each side
    //  a drop to leave it somewhere of its own —read later, inspiration—.
    //  Let go on her or on the pool, it goes in the inbox.
    let pool.x = cx
    let pool.y = cy_actual + 82
    group {
        show: catch > 0.01
        opacity: catch
        body {
            color: #10201c
            rim: 12%
            shadow: 0, 10, 26, 40%
            ellipse { at: pool.x, pool.y; radius: 64 * catch; scale: 1, 0.42 }
        }
        repeat w in 0..3 {
            let t = fract(pool.t + w / 3)
            ellipse { at: pool.x, pool.y; radius: 10 + 50 * t; scale: 1, 0.42; stroke: 1.4; color: mint; opacity: (1 - t) * 60% }
        }
        text "Drop it in Deriva" { at: pool.x, pool.y + 42; anchor: center; size: 11.5; weight: 600; color: mint }
        //  Its two places, drops that swell under the pointer.
        body {
            gradient: radial pool.x - 124, pool.y - 6 radius 30, #e8f3ff, blue 55%, #3d6f9c
            rim: 30%
            ellipse { at: pool.x - 120, pool.y; radius: (20 + 6 * later.hl) * catch }
        }
        body {
            gradient: radial pool.x + 116, pool.y - 6 radius 30, #fff1dd, amber 55%, #9c6a2f
            rim: 30%
            ellipse { at: pool.x + 120, pool.y; radius: (20 + 6 * insp.hl) * catch }
        }
        //  A book, and a spark.
        path { at: pool.x - 128, pool.y - 6; color: #0c0f12; stroke: 1.6
               move 0, 0; line 7, 2; line 16, 0; line 16, 11; line 7, 13; line 0, 11; close }
        line { from: pool.x - 121, pool.y - 4; to: pool.x - 121, pool.y + 7; width: 1.6; color: #0c0f12 }
        path { at: pool.x + 113, pool.y - 8; color: #0c0f12
               move 7, 0; line 9, 6; line 15, 8; line 9, 10; line 7, 16; line 5, 10; line 0, 8; line 5, 6; close }
        text "Read later" { at: pool.x - 120, pool.y + 36; anchor: center; size: 10.5; color: ink; opacity: 60% + 40% * later.hl }
        text "Inspiration" { at: pool.x + 120, pool.y + 36; anchor: center; size: 10.5; color: ink; opacity: 60% + 40% * insp.hl }
    }
    //  Sharing the screen: the ring that breathes around her.
    ellipse { at: cx, cy_actual; radius: r + 6 + 1.5 * sin(share.breath * 360); stroke: 1.8; color: #ef7a66
              opacity: share.lit * (0.45 + 0.3 * sin(share.breath * 360)); show: share.lit > 0.01 }
    //  And what it became: «Kept in Deriva», «It was already there».
    group {
        show: toast.in > 0.01
        opacity: toast.in
        move: 0, (1 - toast.in) * -6
        body {
            color: #0c0f12
            rim: 6%
            shadow: 0, 6, 16, 35%
            box { at: cx, cy_actual + 62; size: 190, 30; corner: 15 }
        }
        ellipse { at: cx - 78, cy_actual + 62; radius: 4; color: mix(mint, amber, drift.result == 2) }
        text drift.toast { at: cx + 6, cy_actual + 62; anchor: center; size: 11.5; weight: 500; color: ink; width: 160; lines: 1 }
    }

    clip inset 2 box { at: card.x, card.y; size: card.w, card.h; corner: card.corner }
    group {
        opacity: content
        move: 0, (1 - content) * 10

        let x0 = card.x - 228
        //  The overview goes away while the page grows: there are no two things
        //  halfway, and what stays below is seen through the gap of the one rising.
        let overview = 1 - clamp(paging * 1.6, 0, 1)
        let y0 = card.top + 23

        text "MAREA" { at: x0, y0; anchor: left center; size: 9; weight: 600; color: ink; opacity: 38% }
        //  The big title says where you are: «Control center» on the front
        //  page, and the page's own name —with its way back beside it— on the
        //  others (see the page's header, below).
        text "Control center" { at: x0 + 22 * paging, y0 + 22; anchor: left center; size: 18; weight: 500; color: ink; opacity: 1 - clamp(paging * 2, 0, 1) }
        //  The gear and the cross, top right.
        prop gear.glow = 0 ~140ms
        prop cross.glow = 0 ~140ms
        let gear.x = card.x + 168
        let cross.x = card.x + 204
        group {
            //  Inside a page its place is the page's own buttons'.
            opacity: (55% + gear.glow * 45%) * (1 - clamp(paging * 2, 0, 1))
            arc { at: gear.x, y0 + 14; radius: 7; span: 300deg; width: 1.8; color: ink }
            ellipse { at: gear.x, y0 + 14; radius: 2.6; color: ink }
        }
        group {
            opacity: 55% + cross.glow * 45%
            line { from: cross.x - 6, y0 + 8; to: cross.x + 6, y0 + 20; width: 1.8; color: ink }
            line { from: cross.x + 6, y0 + 8; to: cross.x - 6, y0 + 20; width: 1.8; color: ink }
        }
        zone box gear { at: gear.x, y0 + 14; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 and page == none }
        zone box close_btn { at: cross.x, y0 + 14; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 }
        on enter gear { gear.glow: 1 }
        on leave gear { gear.glow: 0 }
        on enter close_btn { cross.glow: 1 }
        on leave close_btn { cross.glow: 0 }
        on press gear { page = settings }
        on press close_btn { open = false }

        //  The system tray lives where it does on any desktop: top right, in the
        //  gap between the title and the gear. It does not cost a pixel of height,
        //  and what is done most with it —a click to bring up somebody's window—
        //  is still ONE click. Stuck to the right, so it grows towards the title
        //  as people sign up.
        component TrayIcon(i: record) {
            size: 28, 28
            prop rise = 0 ~140ms
            box touch { from: 0, 0; size: 28, 28; corner: 8; color: ink; opacity: rise * 12%
                       cursor: pointer; active: content > 0.9 and page == none }
            image i.icon { at: 3, 3 - rise * 1.5; size: 22, 22 }
            on enter touch { rise: 1 }
            on leave touch { rise: 0 }
            on press touch { emit systray_activate(i.index) }
            on press right touch { emit systray_menu(i.index) }
        }
        //  The agents' reservoirs: a little tube beside the gear, as full as the
        //  tightest window has left, and of its colour. It says «how am I doing»
        //  without opening anything; pressing it opens the page.
        prop agents.glow = 0 ~140ms
        let agents.x = gear.x - 36
        group {
            opacity: (55% + agents.glow * 45%) * overview
            box { at: agents.x, y0 + 14; size: 11, 18; corner: 4; stroke: 1.5; color: ink }
            box { from: agents.x - 3.5, y0 + 21 - 12 * ag.shown; size: 7, 12 * ag.shown; corner: 2; color: ag.tone }
        }
        zone box agents_btn { at: agents.x, y0 + 14; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 and page == none }
        on enter agents_btn { agents.glow: 1 }
        on leave agents_btn { agents.glow: 0 }
        on press agents_btn { page = agents; emit agents_refresh }

        row systray_row ~quick {
            at: gear.x - 58, y0 + 14
            anchor: right middle
            gap: 4
            opacity: overview
            for i in icons { TrayIcon(i) }
        }

        group {
            opacity: overview
            // ── the two levels ───────────────────────────────────────
            //  Dragging them really moves them: the scene says where the finger
            //  goes and the logic asks the system for it. The value is not made up
            //  here —the service keeps reading it—, so raising the volume with the
            //  key moves this very track.
            //  Everything below, measured on the sheet and written from the centre
            //  of the card: the header ends at −150 and the content starts at −134.
            //  Before, the right column started at −165 and climbed on top of the
            //  cross.
            let levels.x = card.x - 123
            //  The levels' box reaches as far as the cards reach: with five, the
            //  old one stopped at half height and the panel looked lopsided. And the
            //  tracks grow with it, which is what the sheet asks: the sliders are
            //  the protagonist.
            let levels.y = card.top + 237
            box { at: levels.x, levels.y; size: 210, 322; corner: 16; color: mix(#1b1b1c, ink, glassiness); opacity: mix(1, veil, glassiness) }
            //  Three levels: brightness, volume and the microphone; and while it
            //  rains on the windows, a fourth, the rain, which the others make
            //  room for.
            repeat k in 0..4 {
                let step = 66 - 14 * four
                let sx = levels.x - step * (1 + 0.5 * four) + k * step
                let val = pick(k, bright_level, vol_level, mic_level, rain_level)
                let silenced = pick(k, 0, if(sound.muted, 1, 0), if(sound.input_muted, 1, 0), 0)
                let avail = if(k == 0, if(display.present, 1, 0), 1)
                let track_top = levels.y - 137
                let track_h = 200
                let here = if(k == 3, four, 1)
              group {
                show: here > 0.01
                opacity: here
                group {
                    opacity: 25% + avail * 75%
                    //  The track, and the filled part from below.
                    box { at: sx, track_top + track_h / 2; size: 14, track_h; corner: 7; color: mix(#2a2b2c, sunken, glassiness); opacity: mix(1, 70%, glassiness) }
                    box { from: sx - 7, track_top + track_h * (1 - val); size: 14, track_h * val; corner: 7
                          color: mix(mint, #6b7280, silenced) }
                    //  And the handle, which is what says where you are.
                    ellipse { at: sx, track_top + track_h * (1 - val); radius: 9; color: #f0ece4 }
                }
                //  The icon goes BELOW, and with it the label and the percentage.
                let iy = levels.y + 93
                group {
                    opacity: (25% + avail * 75%) * (1 - silenced * 0.45)
                    //  The brightness sun: a disc and eight rays.
                    ellipse { at: sx, iy; radius: 4.5; color: ink; show: k == 0 }
                    repeat r in 0..8 {
                        line { from: sx + 7.5 * cos(r * 45), iy + 7.5 * sin(r * 45)
                               to: sx + 10.5 * cos(r * 45), iy + 10.5 * sin(r * 45)
                               width: 1.6; color: ink; show: k == 0 }
                    }
                    //  The volume speaker: body, horn and two waves.
                    path { at: sx - 8, iy - 5; color: ink; show: k == 1
                           move 0, 3; line 4, 3; line 9, 0; line 9, 11; line 4, 8; line 0, 8; close }
                    arc { at: sx + 3, iy; radius: 6; span: 110deg; width: 1.5; rotate: 90deg; color: ink; show: k == 1 }
                    arc { at: sx + 3, iy; radius: 9.5; span: 110deg; width: 1.5; rotate: 90deg; color: ink; show: k == 1 }
                    //  The microphone: a capsule, its cradle and its foot.
                    box { at: sx, iy - 3; size: 7, 12; corner: 3.5; color: ink; show: k == 2 }
                    arc { at: sx, iy - 1; radius: 6.5; span: 180deg; width: 1.5; rotate: 90deg; color: ink; show: k == 2 }
                    line { from: sx, iy + 5.5; to: sx, iy + 9; width: 1.5; color: ink; show: k == 2 }
                    line { from: sx - 3.5, iy + 9; to: sx + 3.5, iy + 9; width: 1.5; color: ink; show: k == 2 }
                    //  The rain: three streaks slanting down and a drop.
                    line { from: sx - 5, iy - 8; to: sx - 7.5, iy - 1; width: 1.6; color: ink; show: k == 3 }
                    line { from: sx + 1, iy - 10; to: sx - 1.5, iy - 3; width: 1.6; color: ink; show: k == 3 }
                    line { from: sx + 7, iy - 8; to: sx + 4.5, iy - 1; width: 1.6; color: ink; show: k == 3 }
                    ellipse { at: sx - 1.5, iy + 5.5; radius: 2.6; scale: 1, 1.25; color: ink; show: k == 3 }
                }
                line { from: sx - 9, iy - 9; to: sx + 9, iy + 9; width: 1.8; color: #e0655a; opacity: silenced }
                //  (Four to a row, the names a little smaller, so they do not touch.)
                group {
                    pivot: sx, iy + 24
                    scale: 1 - 0.14 * four
                    text "Brightness" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 0 }
                    text "Volume" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 1 }
                    text "Microphone" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 2 }
                    text "Rain" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 3 }
                }
                text "{val * 100, 0}%" { at: sx, iy + 42; anchor: center; size: 11.5; weight: 500; color: mint }
              }
                //  Drag the track, and press the icon to mute.
                zone box track.$k { at: sx, track_top + track_h / 2; size: 34 - 6 * four, track_h + 18; corner: 17; cursor: pointer; active: content > 0.9 and (k < 3 or rain_on) }
                zone box icon.$k { at: sx, iy; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 and (k < 3 or rain_on) }

            }
            //  The track: wherever you release your finger, that is where it goes.
            //  With `pointer.y`, which is over the surface, that is, the same
            //  coordinates the track is drawn with: that way the sum reads next to
            //  the drawing.
            let finger.0 = 1 - clamp((pointer.y - (card.top + 100)) / 200, 0, 1)
            on drag track.0 { emit set_brightness(finger.0) }
            on press track.0 { emit set_brightness(finger.0) }
            on drag track.1 { emit set_volume(finger.0) }
            on press track.1 { emit set_volume(finger.0) }
            on press icon.1 { emit mute_output }
            on drag track.2 { emit set_mic(finger.0) }
            on press track.2 { emit set_mic(finger.0) }
            on press icon.2 { emit mute_mic }
            on drag track.3 { emit set_rain(finger.0) }
            on press track.3 { emit set_rain(finger.0) }

            // ── the sheet's three ────────────────────────────────────
            //  Each card is a `row` of three: the icon, what is read, and the
            //  switch or the arrow. The middle one asks for the room left over
            //  (`grow: 1`) and its texts take their width from it, so **there is
            //  not a single width written by hand here** and what does not fit is
            //  cut by itself. Before, I set it and that is why the network's name
            //  slid under the switch.
            text title.1 = "Wi-Fi"
            text title.2 = "Bluetooth"
            text title.3 = "Focus"
            text title.4 = "Sound"
            text title.5 = "Session"
            text sub.1 = ""
            text sub.2 = "Headphones"
            text sub.3 = "25 min"
            text sub.4 = "Output and input"
            text sub.5 = "Lock or power off"
            //  The springs and the zones go OUTSIDE the layout: inside a `column`
            //  everything there is is a child, and a `prop` takes up no room.
            repeat k in 1..6 {
                prop glow.$k = 0 ~140ms
                zone box row.$k { at: card.x + 111, card.top + 105 + (k - 1) * 66; size: 234, 58; corner: 14; cursor: pointer; active: content > 0.9 }
                //  The switch has its own zone, ON TOP of the card's: pressing it
                //  switches on or off, and pressing the rest opens the page.
                //  Before, the body took both things and the switch did nothing,
                //  so with the Wi-Fi off there was no way to turn it back on from
                //  here.
                zone box switch.$k { at: card.x + 196, card.top + 105 + (k - 1) * 66; size: 52, 44; corner: 20; cursor: pointer; active: content > 0.9 and k < 3 }
                on enter row.$k { glow.$k: 1 }
                on leave row.$k { glow.$k: 0 }
                on press switch.$k { emit flip(k) }
                //  Pressing the card opens its page. The Wi-Fi and Bluetooth
            //  switch still belongs to the system; what opens here is the list.
                on press row.$k { emit scan(k) }
            }
            //  And **which page opens is decided by the scene**, not the logic. The
            //  logic did it —`fact.page = pages[k]`— and that was a round trip with
            //  the 600 ms of blocking in the middle for something that does not
            //  depend on the system; worse: the two new cards were not in its
            //  list, so the logic put the page back to `none` right after the rule
            //  opened it. Outside the layout, or they would be five identical rules.
            on press row.1 { page = wifi }
            on press row.2 { page = bluetooth }
            on press row.3 { page = concentration }
            on press row.4 { page = sound }
            on press row.5 { page = session }
            column cards {
                at: card.x - 6, card.top + 76
                gap: 8
                repeat k in 1..6 {
                    row card_row {
                        size: 234, 58
                        gap: 6
                        padding: 8
                        //  Centred vertically. By default a layout aligns to
                        //  `start`, and with that the switch stayed stuck at the
                        //  top while the text dropped to the middle.
                        align: center
                        //  The Focus one is highlighted when it is on: the
                        //  background a touch greener. It is the only border in the
                        //  panel, and the card paints it, not the layout.
                        fill: mix(mix(mix(#1b1b1c, #202021, glow.$k), #1a241f, lit.$k * if(k == 3, 1, 0)), mix(ink, mint, lit.$k * if(k == 3, 1, 0)), glassiness) mix(1, veil + glow.$k * veil.glow, glassiness)
                        corner: 14
                        group {
                            size: 20, 22
                            //  Wi-Fi: three arcs and the dot.
                            repeat a in 1..4 {
                                //  An arc is drawn ABOVE its point, so the point
                                //  goes at the very bottom: the icon takes up from
                                //  y−16 to y+2, and is centred 7 lower.
                                arc { at: 10, 18; radius: 3 + a * 3.4; span: 110deg; width: 1.8; color: ink
                                      opacity: 40% + lit.1 * 60%; show: k == 1 }
                            }
                            ellipse { at: 10, 19; radius: 1.8; color: ink; opacity: 40% + lit.1 * 60%; show: k == 1 }
                            //  Bluetooth: the rune, in one stroke.
                            path { at: 6, 2; color: ink; stroke: 1.8; opacity: 40% + lit.2 * 60%; show: k == 2
                                   move 0, 4; line 10, 14; line 5, 18; line 5, 0; line 10, 4; line 0, 14 }
                            //  Focus: the moon. It was a disc with one side eaten by
                            //  another the colour of the card, and on a glass card
                            //  the eating one shows: now it is the crescent itself,
                            //  the radius 9 disc at (11, 11) minus the 8.5 one at
                            //  (16, 6), with each arc in curves.
                            path { at: 0, 0; color: ink; opacity: 70%; show: k == 3
                                   move 8.3, 2.4; curve 3.5, 6.1 via 5.2, 3.4; curve 2, 11.9 via 1.7, 8.7; curve 4.6, 17.4 via 2.4, 15.1
                                   curve 10.1, 20 via 6.9, 19.6; curve 15.9, 18.5 via 13.3, 20.3; curve 19.6, 13.7 via 18.6, 16.8
                                   curve 14.5, 14.4 via 17.2, 14.8; curve 10, 12 via 11.9, 13.9; curve 7.6, 7.5 via 8.1, 10.1
                                   curve 8.3, 2.4 via 7.2, 4.8; close }
                            //  Sound: the usual speaker, the same one that goes
                            //  below its track.
                            path { at: 2, 5; color: ink; opacity: 70%; show: k == 4
                                   move 0, 3; line 4, 3; line 9, 0; line 9, 11; line 4, 8; line 0, 8; close }
                            arc { at: 13, 10.5; radius: 5; span: 110deg; width: 1.5; rotate: 90deg; color: ink; opacity: 70%; show: k == 4 }
                            //  Session: the power symbol, which is what that card
                            //  ends up offering.
                            arc { at: 10, 12; radius: 7; span: 280deg; width: 1.7; rotate: 180deg; color: ink; opacity: 70%; show: k == 5 }
                            box { at: 10, 4.5; size: 1.7, 7; corner: 0.9; color: ink; opacity: 70%; show: k == 5 }
                        }
                        //  What is read, with whatever room is left. No widths.
                        column { grow: 1; gap: 2
                            text title.$k { size: 13; lines: 1; color: ink }
                            text sub.$k { size: 11.5; lines: 1; color: mix(#8b8f95, faint, glassiness); show: k > 3 }
                            text bt.sub { size: 11.5; lines: 1; color: mix(#8b8f95, faint, glassiness); show: k == 2 }
                            text net.name { size: 11.5; lines: 1; color: mix(#8b8f95, faint, glassiness); show: k == 1 }
                            //  The Focus one tells what it has left, not what it
                            //  would last: when it is on, what you need to know is
                            //  when she comes back.
                            text "On · {remaining, 0} min" { size: 11.5; lines: 1; color: mint; show: k == 3 and haven }
                            text sub.3 { size: 11.5; lines: 1; color: mix(#8b8f95, faint, glassiness); show: k == 3 and not haven }
                        }
                        //  The switch, or the arrow of those that open a page.
                        //  The one that opens a page only carries an arrow, so it
                        //  takes up much less and its text has more room left.
                        group {
                            size: if(k < 3, 40, 12), 23
                            box { from: 0, 0; size: 40, 23; corner: 11.5; color: mix(#2a2b2c, mint, lit.$k); show: k < 3 }
                            ellipse { at: 11.5 + 18 * lit.$k, 11.5; radius: 8.5; color: #ffffff; show: k < 3 }
                            path { at: 3, 6; color: ink; stroke: 1.6; opacity: 70%; show: k > 2
                                   move 0, 0; line 5, 5; line 0, 10 }
                        }
                    }
                }
            }
            //  The mint outline of the one that is on. It goes apart and with
            //  `stroke` —only the outline— because a layout's background is a
            //  colour and carries no border; a filled `body` on top covered the
            //  whole card.
            box { at: card.x + 111, card.top + 237; size: 234, 58; corner: 14
                  stroke: 1; color: mint; opacity: lit.3 }



        }

        // ── the page, which comes out of its card ────────────────
        //  It grows from the place of the card that was pressed until it fills
        //  the panel. What is below goes away meanwhile: there are no two things
        //  halfway.
        let pg.k = if(page == bluetooth, 2, 0) + if(page == concentration, 3, 0) + if(page == wifi, 1, 0) + if(page == sound, 4, 0) + if(page == session, 5, 0)
        //  The first three come out of their card; the wardrobe has no card
        //  —it is entered through her menu—, so it grows from the centre of the
        //  panel.
        let pg.own = if(page == wardrobe or page == systray or page == settings or page == agents or page == calendar or page == history or page == drift or page == walls, 0, 1)
        let pg.ox = card.x + 111 * pg.own
        let pg.oy = card.top + 231 + (-126 + (pg.k - 1) * 66) * pg.own
        //  The page's box starts where its content does, 96 below the card's
        //  top edge: the page's name and its buttons live in the card's own
        //  header now, not in a row of the box. And the pages of their
        //  own (agents, calendar, settings…) reach down to where their content
        //  ends instead of letting it spill out of the box.
        let pg.to.h = 310 + 88 * (1 - pg.own)
        let pg.to.y = card.top + 96 + pg.to.h / 2
        let pg.x = pg.ox + (card.x - pg.ox) * paging
        let pg.y = pg.oy + (pg.to.y - pg.oy) * paging
        let pg.w = 234 + 222 * paging
        let pg.h = 58 + (pg.to.h - 58) * paging
        //  The box only carries the row into the page: once there it melts,
        //  and the page sits on the card itself, all of one colour.
        box { at: pg.x, pg.y; size: pg.w, pg.h; corner: 14; color: mix(#1b1b1c, ink, glassiness); opacity: paging * min(1, (1 - paging) * 4) * mix(1, veil, glassiness) }

        group {
            opacity: clamp(paging * 3 - 2, 0, 1)
            let px0 = card.x - 208
            //  The page's header, in the card's own: back, and where you are.
            path { at: card.x - 228, card.top + 40; color: ink; stroke: 1.8; opacity: 70%
                   move 5, 0; line 0, 5; line 5, 10 }
            text "Wi-Fi" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == wifi }
            text "Bluetooth" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == bluetooth }
            text "Focus" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == concentration }
            text "Her wardrobe" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == wardrobe }
            text "Sound" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == sound }
            text pick(section, "Settings", "Where she lives", "Her look", "Language", "The lock", "Notices") { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == settings }
            text "Agents" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == agents }
            text "History" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == history }
            text "Deriva" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == drift }
            text "Wallpapers" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == walls }
            text "{drift.kept, 0} kept" { at: card.x + 150, card.top + 45; anchor: right center; size: 11; color: #8b8f95; show: page == drift }
            text cal.month { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == calendar }
            text systray.title { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; width: 300; lines: 1; color: ink; show: page == systray }
            text "Shall we take a break?" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == session and confirming == none }
            text "Confirm" { at: px0, card.top + 45; anchor: left center; size: 18; weight: 500; color: ink; show: page == session and confirming != none }
            zone box back_arrow { at: card.x - 224, card.top + 45; size: 34, 34; corner: 17; cursor: pointer; active: paging > 0.9 }
            //  A step back is ONE step: from the question you go back to the list,
            //  not to the control center. The guards read the previous frame, so
            //  the two do not step on each other.
            on press back_arrow while confirming != none { confirming = none }
            on press back_arrow while confirming == none and not (page == settings and section != menu) { page = none }

            //  A list row, the same for all three: the network, the gadget and the
            //  sound device are told apart by the drawing on the left and by
            //  nothing else. The rest —lighting up on hover, the «this is the
            //  current one» dot and the number sent on choosing it— is the same, so
            //  it is written once.
            //  `lock`: a network that asks for its password (a padlock); `busy`:
            //  the one being joined, which breathes; `battery`: a gadget's,
            //  0..1 (−1, it does not say); `fresh`: one not paired yet.
            component ListRow(f: record, pick: event, glyph: number = 1, signal: number = 0, base: number = 0, lock: number = 0, busy: number = 0, battery: number = -1, fresh: number = 0) {
                size: 456, 38
                prop glow = 0 ~140ms
                let current = if(f.current, 1, 0)
                let tone = mix(#8b8f95, mint, current)
                zone box touch { from: 0, 0; size: 456, 38; corner: 10; cursor: pointer }
                box { from: 0, 0; size: 456, 38; corner: 10
                      color: mix(mix(#202021, #262728, glow), #1a241f, current) }
                //  1 · the network, with its strength in arcs: the more lit, the
                //  better it reaches.
                group {
                    show: glyph == 1
                    repeat a in 1..4 {
                        arc { at: 20, 26; radius: 3 + a * 3.2; span: 110deg; width: 1.7; color: ink
                              opacity: 20% + 80% * if(signal > (a - 1) * 0.25, 1, 0) }
                    }
                    ellipse { at: 20, 27; radius: 1.7; color: ink }
                }
                //  2 · the gadget
                path { at: 15, 11; color: ink; stroke: 1.7; opacity: 80%; show: glyph == 2
                       move 0, 4; line 10, 14; line 5, 18; line 5, 0; line 10, 4; line 0, 14 }
                //  3 · the speaker
                path { at: 12, 13; color: tone; show: glyph == 3
                       move 0, 3; line 4, 3; line 9, 0; line 9, 11; line 4, 8; line 0, 8; close }
                //  4 · and the mic, which is a capsule with its stand
                group {
                    show: glyph == 4
                    box { at: 20, 15; size: 7, 14; corner: 3.5; color: tone }
                    arc { at: 20, 17; radius: 6.4; span: 180deg; width: 1.5; color: tone }
                    box { at: 20, 27.5; size: 1.5, 3.5; color: tone }
                }
                text f.name { at: 42, 19; anchor: left center; size: 12; width: 300; lines: 1
                                color: mix(#dfe1e3, #f6f6f5, glow) }
                ellipse { at: 438, 19; radius: 4; color: mint; opacity: current * 100% }
                //  The padlock: it asks for a password the first time.
                group {
                    show: lock > 0.5
                    box { at: 412, 21; size: 10, 8; corner: 2; color: #8b8f95 }
                    arc { at: 412, 16.5; radius: 3.2; span: 180deg; width: 1.5; rotate: -90deg; color: #8b8f95 }
                }
                //  Joining: the row breathes, a ring of mint that comes and goes.
                box { from: 0, 0; size: 456, 38; corner: 10; stroke: 1.5; color: mint
                      opacity: busy * (35% + 35% * sin(join.t * 360)) }
                //  A gadget's battery: a little drop, as full as it is.
                group {
                    show: battery >= 0
                    box { at: 404, 19; size: 22, 11; corner: 3; stroke: 1.2; color: #8b8f95 }
                    box { at: 416, 19; size: 2, 5; corner: 1; color: #8b8f95 }
                    box { from: 394.5, 15.5; size: 19 * clamp(battery, 0, 1), 7; corner: 2
                          color: mix(#e0655a, mint, clamp(battery * 3 - 0.3, 0, 1)) }
                }
                //  One just found, not paired: pressing it pairs it.
                text "Pair" { at: 428, 19; anchor: right center; size: 11; weight: 600; color: mint; show: fresh > 0.5 }
                on enter touch { glow: 1 }
                on leave touch { glow: 0 }
                on press touch { emit pick(f.index + base) }
            }

            //  The networks there are. The logic brings them from `nmcli`, because
            //  pleamar can read the network but not list it or change it.
            column network_list {
                at: card.x - 228, card.top + 109
                gap: 4
                show: page == wifi
                for r in networks { ListRow(r, pick: pick_network, glyph: 1, signal: r.signal, lock: r.secure and not r.known, busy: joining == r.index) }
            }
            //  Its password, asked for in place: under the list, with the
            //  network's name, the field and «Join». Enter joins too; Esc, or
            //  pressing elsewhere in the list, lets it be.
            group {
                show: page == wifi and asking >= 0
                opacity: clamp(ask.in * 1.4, 0, 1)
                move: 0, (1 - ask.in) * 8
                let ay = card.top + 109 + networks.count * 42 + 16
                box { from: card.x - 228, ay; size: 456, 78; corner: 12; color: mix(#202021, ink, glassiness * 0.06); stroke: 1; opacity: 100% }
                box { from: card.x - 228, ay; size: 456, 78; corner: 12; stroke: 1.2; color: mint; opacity: 35% }
                text "Password for «{ask.name}»" { at: card.x - 212, ay + 18; anchor: left center; size: 11.5; color: #8b8f95; width: 420; lines: 1 }
                box { from: card.x - 212, ay + 32; size: 320, 32; corner: 9; color: #141415 }
                input wifi_pw { at: card.x - 202, ay + 48; width: 300; size: 13; color: ink; placeholder: "Password"; secret: true; selection: #2f5f52 }
                box { from: card.x + 118, ay + 32; size: 94, 32; corner: 9; color: mint; opacity: 85% + 15% * join_btn.glow }
                text "Join" { at: card.x + 165, ay + 48; anchor: center; size: 12; weight: 600; color: #0c0f12 }
                zone box join_btn { from: card.x + 118, ay + 32; size: 94, 32; corner: 9; cursor: pointer; active: page == wifi and asking >= 0 }
            }
            on enter join_btn { join_btn.glow: 1 }
            on leave join_btn { join_btn.glow: 0 }
            on press join_btn { emit join }
            on submit wifi_pw { emit join }
            on key Escape while page == wifi and asking >= 0 { emit forget_ask }
            text "Looking for networks…" { at: card.x, card.y + 20; anchor: center; size: 11.5; color: #8b8f95
                                     show: page == wifi and networks.count < 1 }

            //  And the headphones and the rest, from `bluetoothctl`.
            column gadget_list {
                at: card.x - 228, card.top + 109
                gap: 4
                show: page == bluetooth
                for c in gadgets { ListRow(c, pick: pick_gadget, glyph: 2, battery: c.battery, fresh: not c.paired) }
            }
            //  Looking for new ones: a radar in the header, rings that leave
            //  from the Bluetooth mark while the radio listens; pressed, it
            //  starts or stops listening.
            group {
                show: page == bluetooth
                let rx = card.x + 150
                let ry = card.top + 45
                repeat w in 0..3 {
                    let t = fract(radar.t + w / 3)
                    ellipse { at: rx, ry; radius: 6 + 16 * t; stroke: 1.4; color: mint; opacity: if(bt_scanning, (1 - t) * 70%, 0) }
                }
                ellipse { at: rx, ry; radius: 13; color: mix(#202021, #1a241f, if(bt_scanning, 1, 0)) }
                path { at: rx - 4, ry - 7; color: mix(ink, mint, if(bt_scanning, 1, 0)); stroke: 1.5
                       move 0, 3.5; line 8, 10.5; line 4, 14; line 4, 0; line 8, 3.5; line 0, 10.5 }
                text pick(bt_scanning, "Search", "Searching…") { at: rx - 22, ry; anchor: right center; size: 11.5; color: mix(#8b8f95, mint, if(bt_scanning, 1, 0)) }
                zone box radar_btn { at: rx - 30, ry; size: 110, 32; corner: 16; cursor: pointer; active: page == bluetooth and paging > 0.9 }
            }
            on press radar_btn { emit bt_scan }
            text pick(bt_scanning, "Nothing paired", "Looking around…") { at: card.x, card.y + 20; anchor: center; size: 11.5; color: #8b8f95
                                     show: page == bluetooth and gadgets.count < 1 }

            // ── the history: what has washed up ──────────────────
            //  Every notice dealt with —done, thrown away, opened, or closed by
            //  its own application—, kept on disk by the logic, newest first,
            //  in days. Each one with the drop of its category's colour; the
            //  older, the paler, as things the tide left a while ago. «Clear»
            //  lets the tide take them: they slide away one after another.
            group {
                show: page == history
                let hx = card.x - 228
                let hy = card.top + 104
                column history_list {
                    at: hx, hy
                    gap: 3
                    for h in past {
                        group {
                            size: 456, if(h.head, 26, 44)
                            opacity: (1 - clamp(hist.wash * 1.6 - h.index * 0.07, 0, 1)) * if(h.head, 1, 1 - 0.45 * h.age)
                            move: 120 * pow(clamp(hist.wash * 1.6 - h.index * 0.07, 0, 1), 2), 0
                            text h.day { at: 6, 16; anchor: left center; size: 10.5; weight: 700; color: #8b8f95; show: h.head }
                            box { from: 0, 0; size: 456, 44; corner: 11; color: #1f2021; show: not h.head }
                            ellipse { at: 16, 22; radius: 4.5; color: mix(mix(blue, lilac, h.cat == 2), mix(green, amber, h.cat == 4), h.cat >= 3); show: not h.head }
                            text h.app { at: 32, 14; anchor: left center; size: 8.5; weight: 700; color: mix(mix(blue, lilac, h.cat == 2), mix(green, amber, h.cat == 4), h.cat >= 3); show: not h.head }
                            text h.title { at: 32, 29; anchor: left center; size: 12; weight: 500; width: 250; lines: 1; color: ink; show: not h.head }
                            text h.detail { at: 292, 29; anchor: left center; size: 10.5; width: 110; lines: 1; color: #8b8f95; show: not h.head }
                            text h.when { at: 446, 14; anchor: right center; size: 9.5; color: #8b8f95; show: not h.head }
                        }
                    }
                }
                //  Nothing yet: three little drops resting on a calm line.
                group {
                    show: past.count < 1
                    line { from: card.x - 60, card.y + 30; to: card.x + 60, card.y + 30; width: 1.2; color: #8b8f95; opacity: 40% }
                    repeat d in 0..3 {
                        ellipse { at: card.x - 20 + d * 20, card.y + 24 - 2 * sin(tide.t * 360 + d * 120); radius: 4; color: mix(mix(blue, lilac, d == 1), green, d == 2); opacity: 70% }
                    }
                    text "Nothing has washed up yet" { at: card.x, card.y + 52; anchor: center; size: 11.5; color: #8b8f95 }
                }
                //  «Clear», top right, and the wheel to go back in time.
                text "Clear" { at: card.x + 150, card.top + 45; anchor: right center; size: 11.5; weight: 600
                               color: mix(#8b8f95, #ef7a66, clear.glow); show: past.count > 0 }
                zone box clear_btn { at: card.x + 128, card.top + 45; size: 70, 30; corner: 15; cursor: pointer; active: page == history and paging > 0.9 and past.count > 0 }
                zone box history_area { from: hx, hy; size: 456, 300; active: page == history and paging > 0.9 }
            }
            on enter clear_btn { clear.glow: 1 }
            on leave clear_btn { clear.glow: 0 }
            on press clear_btn { hist.wash: 1 ~700ms }
            on still hist.wash for 80ms while hist.wash > 0.97 {
                emit clear_history
                hist.wash: 0 ~16ms
            }
            on scroll history_area { emit history_scroll(wheel) }

            // ── the wallpapers ───────────────────────────────────
            //  Small, three by three; the one on now has its ring. The wheel
            //  goes on. Hovered, one lifts a little and says its name.
            component WallCard(w: record, pick: event) {
                size: 144, 104
                prop lift = 0 ~lively
                prop arrive = 0 ~360ms
                follow arrive = if(page == walls, 1, 0)
                zone box touch { from: 0, 0; size: 144, 81; corner: 10; cursor: pointer; active: page == walls and paging > 0.9 }
                group {
                    opacity: arrive
                    move: 0, (1 - arrive) * (12 + w.index * 5) - lift * 3
                    pivot: 72, 40
                    scale: 1 + 0.04 * lift
                    body {
                        color: #1a2a26
                        shadow: 0, 4 + 6 * lift, 10 + 10 * lift, 30% + 20% * lift
                        box { from: 0, 0; size: 144, 81; corner: 10 }
                    }
                    group {
                        clip box { from: 0, 0; size: 144, 81; corner: 10 }
                        ellipse { at: 72, 95; radius: 70; color: mint; opacity: 8%; show: not w.ready }
                        image w.thumb { at: 0, 0; size: 144, 81; show: w.ready }
                    }
                    box { from: 0, 0; size: 144, 81; corner: 10; stroke: 2; color: mint; opacity: if(w.current, 1, 0) }
                    box { from: 0, 0; size: 144, 81; corner: 10; stroke: 1.2; color: ink; opacity: lift * 45% * if(w.current, 0, 1) }
                    text w.name { at: 72, 95; anchor: center; size: 10.5; width: 140; lines: 1; color: mix(#8b8f95, ink, max(lift, if(w.current, 1, 0))) }
                }
                on enter touch { lift: 1 }
                on leave touch { lift: 0 }
                on press touch { emit pick(w.index) }
            }
            group {
                show: page == walls
                grid {
                    at: card.x - 228, card.top + 100; columns: 3; gap: 12; width: 456; row: 104
                    for w in walls { WallCard(w, pick: wall_pick) }
                }
                zone box walls_area { from: card.x - 228, card.top + 100; size: 456, 340; active: page == walls and paging > 0.9 }
            }
            on scroll walls_area { emit walls_scroll(wheel) }

            // ── Deriva's library ─────────────────────────────────
            //  What she keeps: a search at the top, and cards below —the
            //  picture of the page or the image when there is one, its title
            //  and where it came from—. Pressed, it opens; carried out, it goes
            //  wherever it is let go (a browser, a folder, a chat).
            component DriftCard(d: record, pick: event) {
                size: 222, 150
                prop glow = 0 ~140ms
                prop arrive = 0 ~320ms
                follow arrive = if(page == drift, 1, 0)
                zone box touch { from: 0, 0; size: 222, 150; corner: 14; cursor: pointer; active: page == drift and paging > 0.9; carries: "{d.link}" }
                group {
                    opacity: arrive
                    move: 0, (1 - arrive) * (10 + d.index * 6)
                    box { from: 0, 0; size: 222, 150; corner: 14; color: mix(#1f2021, #262829, glow) }
                    group {
                        clip box { from: 0, 0; size: 222, 92; corner: 14 }
                        //  With no picture: a calm sea of its kind's colour, and its initial.
                        box { from: 0, 0; size: 222, 92; color: #1a2a26; show: not d.has_preview }
                        ellipse { at: 111, 110; radius: 90; color: mint; opacity: 10%; show: not d.has_preview }
                        text d.kind { at: 111, 46; anchor: center; size: 11; weight: 700; color: mint; opacity: 70%; show: not d.has_preview }
                        image d.preview { at: 0, 0; size: 222, 92; show: d.has_preview }
                        box { from: 0, 0; size: 222, 92; color: #000; opacity: glow * 12% }
                    }
                    text d.title { at: 12, 108; anchor: left center; size: 12; weight: 500; width: 198; lines: 1; color: ink }
                    text d.source { at: 12, 130; anchor: left center; size: 10.5; weight: 600; width: 120; lines: 1; color: mint; opacity: 85% }
                    text d.date { at: 210, 130; anchor: right center; size: 10; color: #8b8f95 }
                    box { from: 0, 0; size: 222, 150; corner: 14; stroke: 1.2; color: mint; opacity: glow * 45% }
                }
                on enter touch { glow: 1 }
                on leave touch { glow: 0 }
                on release touch { emit pick(d.index) }
            }
            group {
                show: page == drift
                let dx0 = card.x - 228
                let dy0 = card.top + 96
                group {
                    show: not drift.missing
                    box { from: dx0, dy0; size: 456, 36; corner: 12; color: #141415 }
                    arc { at: dx0 + 18, dy0 + 17; radius: 6; span: 360deg; width: 1.8; color: ink; opacity: 60% }
                    line { from: dx0 + 22.5, dy0 + 21.5; to: dx0 + 27, dy0 + 26; width: 2; color: ink; opacity: 60% }
                    input drift_q { at: dx0 + 36, dy0 + 18; width: 400; size: 13; color: ink; placeholder: "Search what she keeps"; selection: #2f5f52 }
                    grid {
                        at: dx0, dy0 + 50; columns: 2; gap: 12; width: 456; row: 150
                        for d in drift { DriftCard(d, pick: drift_pick) }
                    }
                }
                zone box drift_area { from: dx0, dy0 + 50; size: 456, 312; active: page == drift and paging > 0.9 and not drift.missing }
                group {
                    show: drift.kept < 1 and not drift.missing
                    text "Carry anything over her: a link, a file, an image." { at: card.x, card.y + 30; anchor: center; size: 11.5; color: #8b8f95 }
                }
                group {
                    show: drift.missing
                    text "Deriva needs its library, deriva-worker." { at: card.x, card.y + 20; anchor: center; size: 12.5; weight: 500; color: ink }
                    text "She builds it herself when she starts, if Rust (cargo) is installed." { at: card.x, card.y + 42; anchor: center; size: 11.5; color: #8b8f95 }
                }
            }
            on scroll drift_area { emit drift_scroll(wheel) }

            // ── the wardrobe ─────────────────────────────────────
            //  The pieces there are, one per spot. What is seen of each one is the
            //  real piece —the same SVG, not an icon of it—, so the day you draw
            //  another one it appears here without touching this.
            group {
                show: page == wardrobe
                text "Each piece chases in its own way: the hat rests, the glasses stay stuck on, the mug keeps her company and the headphones go on air when the screen is shared." {
                    at: card.x - 228, card.top + 121; anchor: left center; size: 11.5; width: 456; lines: 2; color: #8b8f95 }
                repeat a in 1..5 {
                    let ax = card.x - 171 + (a - 1) * 114
                    prop piece_glow.$a = 0 ~140ms
                    box { at: ax, card.top + 191; size: 102, 96; corner: 14
                          color: mix(#202021, #262728, piece_glow.$a) }
                    //  The mint outline of the one she is wearing, as on the cards.
                    box { at: ax, card.top + 191; size: 102, 96; corner: 14; stroke: 1; color: mint
                          opacity: worn.$a }
                    zone box piece_zone.$a { at: ax, card.top + 191; size: 102, 96; corner: 14; cursor: pointer
                                        active: page == wardrobe and paging > 0.9 }
                    on enter piece_zone.$a { piece_glow.$a: 1 }
                    on leave piece_zone.$a { piece_glow.$a: 0 }
                }
                figure hat      { at: card.x - 171, card.top + 177; size: 62, 46 }
                figure glasses  { at: card.x - 57,  card.top + 177; size: 54, 25 }
                figure mug      { at: card.x + 57,  card.top + 177; size: 40, 40 }
                figure phones   { at: card.x + 171, card.top + 177; size: 52, 52 }
                text "Hat"      { at: card.x - 171, card.top + 221; anchor: center; size: 12; color: ink }
                text "Glasses"  { at: card.x - 57,  card.top + 221; anchor: center; size: 12; color: ink }
                text "Mug"      { at: card.x + 57,  card.top + 221; anchor: center; size: 12; color: ink }
                text "Headphones" { at: card.x + 171, card.top + 221; anchor: center; size: 12; color: ink }
                text "rests"     { at: card.x - 171, card.top + 235; anchor: center; size: 10; color: #8b8f95 }
                text "stuck on"  { at: card.x - 57,  card.top + 235; anchor: center; size: 10; color: #8b8f95 }
                text "tags along" { at: card.x + 57, card.top + 235; anchor: center; size: 10; color: #8b8f95 }
                text "on air"    { at: card.x + 171, card.top + 235; anchor: center; size: 10; color: #8b8f95 }
                on press piece_zone.1 { toggle wears.hat }
                on press piece_zone.2 { toggle wears.glasses }
                on press piece_zone.3 { toggle wears.mug }
                on press piece_zone.4 { toggle wears.phones }

                //  And the wallpaper: the one on now, small, and pressing it
                //  opens the page where a new one is picked.
                text "WALLPAPER" { at: card.x - 228, card.top + 284; anchor: left center; size: 9.5; weight: 700; color: #8b8f95 }
                prop wallrow_glow = 0 ~140ms
                box { from: card.x - 228, card.top + 298; size: 456, 116; corner: 14
                      color: mix(#202021, #262728, wallrow_glow) }
                for w in wallnow {
                    body {
                        color: #1a2a26
                        shadow: 0, 3 + 3 * wallrow_glow, 10, 30%
                        box { from: card.x - 216, card.top + 311; size: 160, 90; corner: 10 }
                    }
                    group {
                        clip box { from: card.x - 216, card.top + 311; size: 160, 90; corner: 10 }
                        image w.thumb { at: card.x - 216, card.top + 311; size: 160, 90; show: w.ready }
                        //  A ring of water crosses it while the pointer is over it.
                        ellipse { at: card.x - 136, card.top + 356; radius: 12 + 90 * wallrow_glow; stroke: 1.5
                                  color: #e8f6ff; opacity: 50% * wallrow_glow * (1 - wallrow_glow * 0.6) }
                    }
                    box { from: card.x - 216, card.top + 311; size: 160, 90; corner: 10; stroke: 1.5; color: mint }
                    text w.name { at: card.x - 40, card.top + 342; anchor: left center; size: 13; weight: 500; width: 230; lines: 1; color: ink }
                }
                text "Pick another one: the tide brings it" { at: card.x - 40, card.top + 364; anchor: left center; size: 11; width: 230; lines: 2; color: #8b8f95 }
                path { at: card.x + 206, card.top + 356; stroke: 2; color: mix(#8b8f95, mint, wallrow_glow)
                       move -3 - 3 * wallrow_glow, -6; line 3 - 3 * wallrow_glow, 0; line -3 - 3 * wallrow_glow, 6 }
                zone box wallrow_zone { from: card.x - 228, card.top + 298; size: 456, 116; corner: 14; cursor: pointer
                                        active: page == wardrobe and paging > 0.9 }
                on enter wallrow_zone { wallrow_glow: 1 }
                on leave wallrow_zone { wallrow_glow: 0 }
                on press wallrow_zone { emit show_walls }
            }

            // ── sound: where it plays and where it listens ───────
            //  A device row: its name, and a mint dot if it is the current one.
            //  `base` is what has to be added to its place for the logic to know
            //  which one it is: the two lists travel together.

            //  Two lists, one below the other, with their label. What there is is
            //  said by pleamar —`outputs` and `inputs` of the same volume
            //  service— and choosing one is `audio.default`, so there is not a
            //  single line here that knows about PipeWire.
            group {
                show: page == sound
                text "OUTPUT" { at: card.x - 228, card.top + 118; anchor: left center; size: 9.5; weight: 700; color: #8b8f95 }
                column output_list {
                    at: card.x - 228, card.top + 132
                    gap: 4
                    for a in outputs { ListRow(a, pick: pick_device, glyph: 3) }
                }
                //  The input goes right below whatever the output takes up, not in
                //  a fixed place: with two speakers a hole was left in the middle.
                text "INPUT" { at: card.x - 228, card.top + 150 + output_list.height; anchor: left center; size: 9.5; weight: 700; color: #8b8f95 }
                column mic_list {
                    at: card.x - 228, card.top + 164 + output_list.height
                    gap: 4
                    for a in mics { ListRow(a, pick: pick_device, glyph: 4, base: outputs.count) }
                }
                text "Nothing to choose" { at: card.x, card.top + 200; anchor: center; size: 11.5; color: #8b8f95
                                         show: outputs.count < 1 and mics.count < 1 }
            }

            // ── the settings ─────────────────────────────────────
            //  A front page of tiles, one per subject, each with its drawing and
            //  what it is set to right now; pressing one opens its own page, and
            //  the arrow of the card's header comes back. The pages are
            //  pleamar's `pages`, the tiles its `grid` of `Tile`s, and the
            //  switches and choices its own pieces: what is left here is what
            //  is Marea's.
            on press back_arrow while page == settings and section != menu { section = menu }
            event to_home
            event to_look
            event to_language
            event to_lock
            event to_notices
            event to_wardrobe
            event flip_follow
            event flip_room
            event flip_safety
            on to_home { section = home }
            on to_look { section = look }
            on to_language { section = language }
            on to_lock { section = lock }
            on to_notices { section = notices }
            on to_wardrobe { emit customize; page = wardrobe }
            on flip_follow { toggle following }
            on flip_room { toggle taking_room }
            on flip_safety { toggle with_exit }
            let st.faint = mix(#8b8f95, faint, glassiness)
            group {
                show: page == settings
                pages section {
                    page menu "Settings" {
                        grid {
                            at: card.x - 228, card.top + 109; columns: 2; gap: 12; width: 456; row: 106
                            Tile("Where she lives", pick(if(following, 0, home + 1), "Follows you", screen.0.name, screen.1.name), to_home, cell.w) {
                                group { size: 30, 26
                                    box { at: 15, 10; size: 26, 17; corner: 3; stroke: 1.8; color: ink }
                                    line { from: 9, 23; to: 21, 23; width: 1.8; color: ink }
                                    ellipse { at: 15, 10; radius: 4.5; color: mint }
                                }
                            }
                            Tile("Her look", pick(skin, "Liquid", "Light liquid", "Classic"), to_look, cell.w) {
                                group { size: 32, 32
                                    body {
                                        color: coal
                                        rim: 14%
                                        glass: if(skin == classic, 0, 1)
                                        lens: skin == lens
                                        ellipse { at: 16, 16; radius: 15 }
                                    }
                                    box { at: 12, 16; size: 3, 7; corner: 1.5; color: ink }
                                    box { at: 20, 16; size: 3, 7; corner: 1.5; color: ink }
                                }
                            }
                            Tile("Language", pick(language, "System", "English", "Español"), to_language, cell.w) {
                                text "Aa" { size: 17; weight: 700; color: ink }
                            }
                            Tile("The lock", pick(with_exit, "Password only", "Safety net on"), to_lock, cell.w) {
                                group { size: 20, 24
                                    arc { at: 10, 8; radius: 6; span: 180deg; width: 2; color: ink }
                                    line { from: 4, 8; to: 4, 12; width: 2; color: ink }
                                    line { from: 16, 8; to: 16, 12; width: 2; color: ink }
                                    box { at: 10, 17; size: 18, 13; corner: 3; color: mix(ink, mint, with_exit) }
                                }
                            }
                            Tile("Notices", pick(if(dnd, 3, min(muted.count, 2)), "All of them arrive", "One app muted", "Some apps muted", "Do not disturb"), to_notices, cell.w) {
                                group { size: 24, 26
                                    path { at: 12, 13; color: ink
                                           move -9, 6; line -7, 3; line -7, -3; curve 0, -11 via -7, -11; curve 7, -3 via 7, -11; line 7, 3; line 9, 6; close }
                                    ellipse { at: 12, 22; radius: 2.6; color: ink }
                                    ellipse { at: 19, 5; radius: 3.2; color: mix(mint, lilac, dnd) }
                                }
                            }
                            Tile("Wardrobe and wallpaper", "Pieces and the background", to_wardrobe, cell.w) {
                                group { size: 30, 22
                                    box { at: 15, 11; size: 28, 20; corner: 4; stroke: 1.6; color: ink }
                                    path { at: 3, 19; color: ink; move 0, 0; line 8, -9; line 13, -3; line 17, -7; line 24, 0; close }
                                    ellipse { at: 22, 6; radius: 2.4; color: mint }
                                }
                            }
                        }
                    }

                    // ── where she lives ──
                    //  The two monitors drawn as two pools, to scale, with their
                    //  names, and her swimming in the one she is in; pressing a pool
                    //  sends her there. «Follow me» sets her to go wherever the focus is.
                    page home "Where she lives" {
                        text "Choose her monitor, or let her follow you." { at: card.x - 228, card.top + 122; anchor: left center; size: 12; color: st.faint }
                        repeat m in 0..2 {
                            let px = card.x - 114 + m * 228
                            let py = card.top + 222
                            let is_home.$m = if(not following and home == m, 1, 0)
                            text screen.$m.name { at: px, py - 76; anchor: center; size: 12; weight: 600; color: mix(st.faint, ink, is_home.$m) }
                            box { at: px, py; size: 208, 118; corner: 12; color: mix(mix(#1b1f22, #202528, pool_zone.$m.hover), #1a2a25, is_home.$m) }
                            box { at: px, py; size: 208, 118; corner: 12; stroke: 1.4; color: mint; opacity: is_home.$m * 85% + pool_zone.$m.hover * 25% }
                            group {
                                clip inset 0 box { at: px, py; size: 208, 118; corner: 12 }
                                box { at: px, py + 46; size: 208, 44; color: mix(#1f3a34, #24524a, is_home.$m); opacity: 55% }
                            }
                            group {
                                opacity: if(m == 0, if(hosts.0, 1, 0), if(hosts.1, 1, 0))
                                body {
                                    color: coal
                                    rim: 14%
                                    ellipse { at: px + 3 * sway, py + 26 + 1.5 * sway; radius: 12 }
                                }
                                box { at: px - 4 + 3 * sway, py + 26 + 1.5 * sway; size: 3, 6; corner: 1.5; color: ink }
                                box { at: px + 4 + 3 * sway, py + 26 + 1.5 * sway; size: 3, 6; corner: 1.5; color: ink }
                            }
                            text "Her home" { at: px, py + 76; anchor: center; size: 10.5; weight: 600; color: mint; opacity: is_home.$m }
                            zone box pool_zone.$m { at: px, py; size: 208, 118; corner: 12; cursor: pointer }
                            on press pool_zone.$m { home = m; following = false }
                        }
                        box { at: card.x, card.top + 360; size: 456, 64; corner: 16; color: mix(#202021, #1a2a25, following) }
                        box { at: card.x, card.top + 360; size: 456, 64; corner: 16; stroke: 1.2; color: mint; opacity: following * 70% }
                        text "Follow me" { at: card.x - 206, card.top + 350; anchor: left center; size: 13; weight: 600; color: ink }
                        text "She goes to the monitor where you are working" { at: card.x - 206, card.top + 369; anchor: left center; size: 11; color: st.faint }
                        column { at: card.x + 174, card.top + 348
                            Switch(following, flip_follow)
                        }
                        //  And whether windows go under her or leave her the strip at the top.
                        box { at: card.x, card.top + 436; size: 456, 64; corner: 16; color: mix(#202021, #1a2a25, taking_room) }
                        box { at: card.x, card.top + 436; size: 456, 64; corner: 16; stroke: 1.2; color: mint; opacity: taking_room * 70% }
                        text "Her own strip" { at: card.x - 206, card.top + 426; anchor: left center; size: 13; weight: 600; color: ink }
                        text "Windows leave her the top, instead of going under her" { at: card.x - 206, card.top + 445; anchor: left center; size: 11; color: st.faint }
                        column { at: card.x + 174, card.top + 424
                            Switch(taking_room, flip_room)
                        }
                    }

                    // ── her look ──
                    //  Three swatches, and in each one she herself painted that way:
                    //  not a photo of how it would be, but really her.
                    page look "Her look" {
                        text "Made of glass like Apple's, or the usual one." { at: card.x - 228, card.top + 122; anchor: left center; size: 12; color: st.faint }
                        repeat t in 0..3 {
                            let fx = card.x - 152 + t * 152
                            let fy = card.top + 250
                            let chosen.$t = if(t == 0, skin == lens, if(t == 1, skin == liquid, skin == classic))
                            box { at: fx, fy; size: 140, 180; corner: 18; color: mix(#25282b, #2c3033, swatch.$t.hover) }
                            box { at: fx, fy; size: 140, 180; corner: 18; stroke: 1.5; color: mint; opacity: chosen.$t * 85% + swatch.$t.hover * 20% }
                            body {
                                color: coal
                                rim: 14%
                                glass: if(t < 2, 1, 0)
                                lens: t == 0
                                ellipse { at: fx + 3 * sway, fy - 26 + 1.5 * sway; radius: 32 }
                            }
                            box { at: fx - 7 + 3 * sway, fy - 26 + 1.5 * sway; size: 5, 11; corner: 2.5; color: ink }
                            box { at: fx + 7 + 3 * sway, fy - 26 + 1.5 * sway; size: 5, 11; corner: 2.5; color: ink }
                            text pick(t, "Liquid", "Light liquid", "Classic") { at: fx, fy + 38; anchor: center; size: 13; weight: 600; color: ink }
                            text pick(t, "Bends what's behind", "Blurs it", "Opaque, no glass") { at: fx, fy + 58; anchor: center; size: 10.5; color: st.faint }
                            ellipse { at: fx, fy + 76; radius: 4; color: mint; opacity: chosen.$t }
                            zone box swatch.$t { at: fx, fy; size: 140, 180; corner: 18; cursor: pointer }
                        }
                        on press swatch.0 { skin = lens }
                        on press swatch.1 { skin = liquid }
                        on press swatch.2 { skin = classic }
                        text "Liquid reads the screen behind her to bend it: it costs a little more." { at: card.x, card.top + 372; anchor: center; size: 11; width: 440; lines: 1; color: st.faint; opacity: 85% }
                    }

                    // ── the language ──
                    //  Three rows, each name written in its own language.
                    page language "Language" {
                        text "The language she speaks in." { at: card.x - 228, card.top + 122; anchor: left center; size: 12; color: st.faint }
                        repeat l in 0..3 {
                            let ly = card.top + 178 + l * 74
                            let lang.on.$l = if(l == 0, language == system, if(l == 1, language == english, language == spanish))
                            box { at: card.x, ly; size: 456, 64; corner: 16; color: mix(mix(#25282b, #2c3033, lang_zone.$l.hover), #1a2a25, lang.on.$l) }
                            box { at: card.x, ly; size: 456, 64; corner: 16; stroke: 1.3; color: mint; opacity: lang.on.$l * 80% + lang_zone.$l.hover * 20% }
                            ellipse { at: card.x - 196, ly; radius: 20; color: ink; opacity: 8% }
                            text pick(l, "Aa", "EN", "ES") { at: card.x - 196, ly; anchor: center; size: 13; weight: 700; color: ink }
                            text pick(l, "System", "English", "Español") { at: card.x - 164, ly - 9; anchor: left center; size: 13.5; weight: 600; color: ink }
                            text pick(l, "The one your session speaks", "Always in English", "Siempre en español") { at: card.x - 164, ly + 10; anchor: left center; size: 11; color: st.faint }
                            ellipse { at: card.x + 200, ly; radius: 9; stroke: 1.6; color: mix(st.faint, mint, lang.on.$l) }
                            ellipse { at: card.x + 200, ly; radius: 5 * lang.on.$l; color: mint }
                            zone box lang_zone.$l { at: card.x, ly; size: 456, 64; corner: 16; cursor: pointer }
                        }
                        on press lang_zone.0 { language = system }
                        on press lang_zone.1 { language = english }
                        on press lang_zone.2 { language = spanish }
                    }

                    // ── the lock ──
                    //  A big padlock, open while the safety net is on, and what that
                    //  means said plainly, with its switch.
                    page lock "The lock" {
                        prop safety.pos = 0 ~200ms
                        follow safety.pos = if(with_exit, 1, 0)
                        arc { at: card.x, card.top + 172 - 6 * safety.pos; radius: 18; span: 180deg; width: 5; color: ink }
                        line { from: card.x - 18, card.top + 172 - 6 * safety.pos; to: card.x - 18, card.top + 186 - 6 * safety.pos; width: 5; color: ink }
                        line { from: card.x + 18, card.top + 172; to: card.x + 18, card.top + 186; width: 5; color: ink; opacity: 1 - safety.pos }
                        box { at: card.x, card.top + 206; size: 54, 40; corner: 9; color: mix(ink, mint, safety.pos) }
                        ellipse { at: card.x, card.top + 202; radius: 4.5; color: coal }
                        box { at: card.x, card.top + 211; size: 3.5, 9; corner: 1.5; color: coal }
                        text "Her lock screen opens with your password." { at: card.x, card.top + 256; anchor: center; size: 12.5; weight: 500; color: ink }
                        text "While you try it out, a safety net: Esc also opens it, and it opens by itself after a minute." { at: card.x, card.top + 284; anchor: center; size: 11; width: 400; lines: 2; align: center; color: st.faint }
                        box { at: card.x, card.top + 360; size: 456, 64; corner: 16; color: mix(#202021, #1a2a25, safety.pos) }
                        box { at: card.x, card.top + 360; size: 456, 64; corner: 16; stroke: 1.2; color: mint; opacity: safety.pos * 70% }
                        text "Safety net" { at: card.x - 206, card.top + 350; anchor: left center; size: 13; weight: 600; color: ink }
                        text "Remove it once you trust your password. It lasts until a restart" { at: card.x - 206, card.top + 369; anchor: left center; size: 11; width: 370; lines: 1; color: st.faint }
                        column { at: card.x + 174, card.top + 348
                            Switch(with_exit, flip_safety)
                        }
                    }

                    // ── the notices ──
                    //  Whether they come in with a card or quietly, straight to
                    //  their drop; how long «later» keeps one away; and the apps
                    //  muted from a notice's bell, each with its way back.
                    page notices "Notices" {
                        text "Quiet ones still arrive: they go to their drop, without a card." { at: card.x - 228, card.top + 116; anchor: left center; size: 12; color: st.faint }
                        box { at: card.x, card.top + 164; size: 456, 60; corner: 16; color: mix(#202021, #1f1d2a, dnd) }
                        box { at: card.x, card.top + 164; size: 456, 60; corner: 16; stroke: 1.2; color: lilac; opacity: dnd * 70% }
                        text "Do not disturb" { at: card.x - 206, card.top + 155; anchor: left center; size: 13; weight: 600; color: ink }
                        text "Only the urgent ones get through" { at: card.x - 206, card.top + 173; anchor: left center; size: 11; color: st.faint }
                        column { at: card.x + 174, card.top + 152
                            Switch(dnd, flip_dnd, accent: lilac)
                        }
                        box { at: card.x, card.top + 232; size: 456, 60; corner: 16; color: mix(#202021, #1a2a25, quiet_rec) }
                        box { at: card.x, card.top + 232; size: 456, 60; corner: 16; stroke: 1.2; color: mint; opacity: quiet_rec * 70% }
                        text "Quiet while recording or sharing" { at: card.x - 206, card.top + 223; anchor: left center; size: 13; weight: 600; color: ink }
                        text "None of them ends up in your video or your call. Locked, always quiet" { at: card.x - 206, card.top + 241; anchor: left center; size: 11; width: 360; lines: 1; color: st.faint }
                        column { at: card.x + 174, card.top + 220
                            Switch(quiet_rec, flip_quiet_rec)
                        }
                        //  How long «later» is: three drops to choose from.
                        text "LATER BRINGS IT BACK IN" { at: card.x - 228, card.top + 288; anchor: left center; size: 9.5; weight: 700; color: #8b8f95 }
                        repeat k in 0..3 {
                            let lx = card.x - 228 + 76 + k * 152
                            prop later_pick.glow.$k = 0 ~140ms
                            box { at: lx, card.top + 318; size: 144, 34; corner: 17; color: mix(mix(#202021, #262728, later_pick.glow.$k), #1a2a25, snooze_k == k) }
                            box { at: lx, card.top + 318; size: 144, 34; corner: 17; stroke: 1.2; color: mint; opacity: if(snooze_k == k, 70%, 0) }
                            text pick(k, "15 minutes", "An hour", "Three hours") { at: lx, card.top + 318; anchor: center; size: 12; weight: 500; color: mix(#a9adb3, ink, snooze_k == k) }
                            zone box later_pick.$k { at: lx, card.top + 318; size: 144, 34; corner: 17; cursor: pointer }
                            on enter later_pick.$k { later_pick.glow.$k: 1 }
                            on leave later_pick.$k { later_pick.glow.$k: 0 }
                            on press later_pick.$k { snooze_k = k }
                        }
                        //  The muted apps: a pill each, and its cross unmutes it.
                        text "MUTED APPS" { at: card.x - 228, card.top + 362; anchor: left center; size: 9.5; weight: 700; color: #8b8f95 }
                        component MutedPill(m: record, drop: event) {
                            size: 144, 34
                            prop glow = 0 ~140ms
                            //  The grid lays out every record there could be: the empty ones are not drawn.
                            group {
                                show: m.index < muted.count
                                box { from: 0, 0; size: 144, 34; corner: 17; color: mix(#202021, #2a2222, glow) }
                                text m.app { at: 14, 17; anchor: left center; size: 11.5; weight: 500; width: 100; lines: 1; color: ink }
                                line { from: 122, 12; to: 132, 22; width: 1.5; color: mix(#8b8f95, #ef7a66, glow) }
                                line { from: 132, 12; to: 122, 22; width: 1.5; color: mix(#8b8f95, #ef7a66, glow) }
                                zone box touch { from: 0, 0; size: 144, 34; corner: 17; cursor: pointer }
                            }
                            on enter touch { glow: 1 }
                            on leave touch { glow: 0 }
                            on press touch { emit drop(m.index) }
                        }
                        grid {
                            at: card.x - 228, card.top + 378; columns: 3; gap: 12; width: 456; row: 42
                            for m in muted { MutedPill(m, drop: unmute) }
                        }
                        text "None. The bell on a notice mutes its app." { at: card.x - 228, card.top + 394; anchor: left center; size: 11.5; color: st.faint; show: muted.count < 1 }
                    }
                }
            }

            // ── the agents' reservoirs ───────────────────────────
            //  What is left of Claude Code's and Codex's windows, as water in
            //  glass tubes: as full as there is left, and of the colour of the
            //  margin —mint, amber, coral—, never of the brand. Each tube is
            //  its own window: nothing is added up between them. Coming in, they
            //  fill one after another; a new reading makes them sway; the mouse
            //  over one stirs its water. An unknown number is an empty tube with
            //  a dashed line, not a zero.
            shader reservoir = file "shaders/reservoir.wgsl"
            //  The water rises once the page can be seen, from empty, every time:
            //  started on asking for the page, it rose while the page was still
            //  growing out of the card and by the time it showed it was full. And
            //  leaving empties it at once, so coming back fills it again.
            prop reveal = 0 ~3400ms
            on change page == agents and paging > 0.9 while page == agents and paging > 0.9 { reveal: 0 ~16ms; reveal: 1 ~3400ms after 60ms }
            on change page while page != agents { reveal: 0 ~16ms }
            //  And she fills them herself: a breath, and a jet of water from her
            //  mouth to each tube, one after another, left to right and top to
            //  bottom. Each tube starts rising when its jet lands, not before —
            //  the first drops take 0.7 s to fly to the top row and 0.9 s to the
            //  bottom one—. Two jets overlap for a moment: she does not stop to
            //  breathe between them.
            on change page == agents and paging > 0.9 while page == agents and paging > 0.9 {
                play gulp
                blow: 1 ~200ms after 200ms
                pour.1.1: 0 ~16ms; pour.1.2: 0 ~16ms; pour.1.3: 0 ~16ms
                pour.2.1: 0 ~16ms; pour.2.2: 0 ~16ms; pour.2.3: 0 ~16ms
                jet.head.1.1: 0 ~16ms; jet.head.1.2: 0 ~16ms; jet.head.1.3: 0 ~16ms; jet.head.2.1: 0 ~16ms; jet.head.2.2: 0 ~16ms; jet.head.2.3: 0 ~16ms
                jet.tail.1.1: 0 ~16ms; jet.tail.1.2: 0 ~16ms; jet.tail.1.3: 0 ~16ms; jet.tail.2.1: 0 ~16ms; jet.tail.2.2: 0 ~16ms; jet.tail.2.3: 0 ~16ms
                jet.head.1.1: 1 ~720ms after 260ms; jet.tail.1.1: 1 ~480ms after 1080ms; pour.1.1: 1 ~1300ms after 980ms
                jet.head.1.2: 1 ~720ms after 660ms; jet.tail.1.2: 1 ~480ms after 1480ms; pour.1.2: 1 ~1300ms after 1380ms
                jet.head.1.3: 1 ~720ms after 1060ms; jet.tail.1.3: 1 ~480ms after 1880ms; pour.1.3: 1 ~1300ms after 1780ms
                jet.head.2.1: 1 ~930ms after 1460ms; jet.tail.2.1: 1 ~480ms after 2280ms; pour.2.1: 1 ~1300ms after 2390ms
                jet.head.2.2: 1 ~930ms after 1860ms; jet.tail.2.2: 1 ~480ms after 2680ms; pour.2.2: 1 ~1300ms after 2790ms
                jet.head.2.3: 1 ~930ms after 2260ms; jet.tail.2.3: 1 ~480ms after 3080ms; pour.2.3: 1 ~1300ms after 3190ms
                blow: 0 ~300ms after 3250ms
            }
            on change page while page != agents {
                blow: 0 ~16ms
                jet.head.1.1: 0 ~16ms; jet.head.1.2: 0 ~16ms; jet.head.1.3: 0 ~16ms; jet.head.2.1: 0 ~16ms; jet.head.2.2: 0 ~16ms; jet.head.2.3: 0 ~16ms
                jet.tail.1.1: 0 ~16ms; jet.tail.1.2: 0 ~16ms; jet.tail.1.3: 0 ~16ms; jet.tail.2.1: 0 ~16ms; jet.tail.2.2: 0 ~16ms; jet.tail.2.3: 0 ~16ms
                pour.1.1: 0 ~16ms; pour.1.2: 0 ~16ms; pour.1.3: 0 ~16ms; pour.2.1: 0 ~16ms; pour.2.2: 0 ~16ms; pour.2.3: 0 ~16ms
            }
            //  Claude's rays turn slowly, only while the page is there: a
            //  `time` would keep her painting all day for a page nobody sees.
            prop rays = 0
            spin rays by if(page == agents, 12, 0)
            prop refresh.turn = 0 ~slow
            prop refresh.glow = 0 ~140ms
            group {
                show: page == agents
                //  Read again: the arrow turns once.
                group {
                    opacity: 55% + refresh.glow * 45%
                    arc { at: card.x + 168, card.top + 37; radius: 7; span: 290deg; width: 1.8; rotate: refresh.turn * 1deg; color: ink }
                    path { at: card.x + 168 + 7 * cos(refresh.turn - 55), card.top + 37 + 7 * sin(refresh.turn - 55); color: ink; rotate: (refresh.turn + 35) * 1deg
                           move -3, -3; line 3, 0; line -3, 3; close }
                }
                zone box refresh_btn { at: card.x + 168, card.top + 37; size: 30, 30; corner: 15; cursor: pointer; active: page == agents and paging > 0.9 }
                on enter refresh_btn { refresh.glow: 1 }
                on leave refresh_btn { refresh.glow: 0 }
                on press refresh_btn { refresh.turn: refresh.turn + 360; emit agents_refresh }

                text "Reading your windows…" { at: card.x, card.top + 250; anchor: center; size: 11.5; color: #8b8f95
                                              show: ag.kind.1 < 1 and ag.kind.2 < 1 }

                repeat a in 1..3 {
                    let ay = card.top + 120 + (a - 1) * 186
                    let ax0 = card.x - 228
                    group {
                        show: ag.kind.$a > 0
                        //  Each agent comes in a moment after the one before.
                        opacity: clamp((reveal - (a - 1) * 0.12) * 3, 0, 1)
                        move: 0, (1 - clamp((reveal - (a - 1) * 0.12) * 3, 0, 1)) * 12
                        box { at: card.x, ay + 88; size: 456, 178; corner: 16; color: mix(#202122, ink, glassiness); opacity: mix(1, veil, glassiness) }
                        //  Who it is. Claude: its burst of rays, turning very
                        //  slowly. Codex: a hexagon with its prompt.
                        group {
                            show: ag.kind.$a == 1
                            repeat r in 0..10 {
                                line { from: ax0 + 26 + 3 * cos(r * 36 + rays), ay + 24 + 3 * sin(r * 36 + rays)
                                       to: ax0 + 26 + 10 * cos(r * 36 + rays), ay + 24 + 10 * sin(r * 36 + rays)
                                       width: 2.4; color: #d97757 }
                            }
                        }
                        group {
                            show: ag.kind.$a == 2
                            path { at: ax0 + 26, ay + 24; stroke: 1.8; color: ink
                                   move 0, -11; line 9.5, -5.5; line 9.5, 5.5; line 0, 11; line -9.5, 5.5; line -9.5, -5.5; close }
                            path { at: ax0 + 22, ay + 24; stroke: 1.6; color: ink; move 0, -3.5; line 3.5, 0; line 0, 3.5 }
                            line { from: ax0 + 27, ay + 27.5; to: ax0 + 31, ay + 27.5; width: 1.6; color: ink }
                        }
                        text ag.name.$a { at: ax0 + 46, ay + 17; anchor: left center; size: 15; weight: 600; color: ink }
                        text ag.sub.$a { at: ax0 + 46, ay + 35; anchor: left center; size: 11; width: 380; lines: 1; color: faint; opacity: 75% }

                        repeat l in 1..4 {
                            let sx = ax0 + 16 + (l - 1) * 146
                            let used = ag.used.$a.$l
                            let known = if(used > -0.5, 1, 0)
                            let avail = clamp(100 - used, 0, 100)
                            //  The colour of the margin: coral under 15 %, amber
                            //  up to 50 %, mint above.
                            let tone = mix(mix(#ef7a66, #f0b85a, clamp((avail - 12) / 8, 0, 1)), mint, clamp((avail - 40) / 15, 0, 1))
                            prop lvl.$a.$l = 0 ~calm
                            follow lvl.$a.$l = avail / 100
                            prop sway.$a.$l = 0 ~lively
                            prop hover.$a.$l = 0 ~140ms
                            //  Its jet —on while she spits at it— and how full it is,
                            //  which starts when the jet lands.
                            prop jet.head.$a.$l = 0 ~16ms
                            prop jet.tail.$a.$l = 0 ~16ms
                            prop pour.$a.$l = 0 ~1300ms
                            let fill = clamp(pour.$a.$l, 0, 1)
                            let eased = fill * fill * (3 - 2 * fill)
                            group {
                                show: ag.on.$a.$l
                                opacity: 45% + 55% * if(ag.active.$a.$l, 1, 0)
                                //  A halo when there is little left: the tube says it
                                //  without a notice.
                                group {
                                    glow: 10, if(avail < 15 and known > 0.5, 70%, 0), #ef7a66
                                    shader reservoir { at: sx, ay + 52; size: 46, 112; corner: 13
                                                       values: if(known > 0.5, lvl.$a.$l * eased, -1), sway.$a.$l + clamp(vel(lvl.$a.$l) * 0.3 + vel(reveal) * 0.5 * (1 - eased), -0.6, 0.6), a * 3.7 + l * 1.3, if(ag.pending.$a.$l, 1, 0), hover.$a.$l, if(avail < 15 and known > 0.5, 1, 0)
                                                       colors: tone, mix(tone, #0b1a22, 0.62) }
                                }
                                //  A reading splashes: drops jump off the surface of
                                //  each tube and fall back into it.
                                particles { at: sx + 23, ay + 56 + 104 * (1 - lvl.$a.$l * eased); area: 30, 0; count: 14
                                            life: 0.35s .. 0.7s; speed: 40 .. 110; direction: -90deg; spread: 70deg
                                            gravity: 0, 520; size: 2.6, 1.2; colors: tone, #ffffff; opacity: 90%, 0%
                                            burst: agents_read }
                                //  The jet: drops fired from her mouth on a real
                                //  parabola. Given how long they fly (T, longer the
                                //  further down, so the jet rises before it falls),
                                //  the speed to land on the tube's mouth comes out of
                                //  the sums: vx = dx / T, vy = dy / T − g·T / 2. They
                                //  live exactly T: they go into the tube and vanish.
                                let jet.x0 = cx + 9
                                let jet.y0 = cy_actual + 10
                                let jet.dx = sx + 23 - jet.x0
                                let jet.dy = ay + 56 - jet.y0
                                let jet.t = 0.55 + jet.dy / 900
                                let jet.vx = jet.dx / jet.t
                                let jet.vy = jet.dy / jet.t - 450 * jet.t
                                //  Not drops: water. A parabola is exactly a quadratic
                                //  Bézier, so the jet is ONE line with round ends, as
                                //  long as it has to be, from its tail to its front:
                                //  the ends are where the water is at those two
                                //  moments, and the control point is where their
                                //  tangents meet, P0 + (t1 − t0) / 2 · v(t0). Melted in
                                //  a body with a fatter drop at its front —where the
                                //  water piles up— and a line of light along the top.
                                //  Its front flies from her mouth to the tube; when she
                                //  stops, its tail follows it in.
                                let jh = jet.head.$a.$l
                                let jt = jet.tail.$a.$l
                                let jon = jh > 0.002 and jt < 0.995 and ag.on.$a.$l
                                let j0 = jt * jet.t
                                let j1 = jh * jet.t
                                let jx0 = jet.x0 + jet.vx * j0
                                let jy0 = jet.y0 + jet.vy * j0 + 450 * j0 * j0
                                let jx1 = jet.x0 + jet.vx * j1
                                let jy1 = jet.y0 + jet.vy * j1 + 450 * j1 * j1
                                let jcx = jx0 + (j1 - j0) / 2 * jet.vx
                                let jcy = jy0 + (j1 - j0) / 2 * (jet.vy + 900 * j0)
                                body {
                                    color: mix(tone, #ffffff, 0.18)
                                    rim: 24%
                                    show: jon
                                    path { at: 0, 0; stroke: 5
                                           move jx0, jy0; curve jx1, jy1 via jcx, jcy }
                                    ellipse { at: jx1, jy1; radius: 4.2; blend: 6 }
                                }
                                group {
                                    show: jon
                                    opacity: 65%
                                    path { at: -0.8, -1.4; stroke: 1.3; color: #ffffff
                                           move jx0, jy0; curve jx1, jy1 via jcx, jcy }
                                    ellipse { at: jx1 - 1.3, jy1 - 1.5; radius: 1.3; color: #ffffff }
                                }
                                //  And a few drops come loose from it on the way.
                                particles { at: jx1, jy1; count: 40; life: 0.2s .. 0.45s; speed: 10 .. 45; spread: 360deg
                                            gravity: 0, 500; size: 2.4, 1; colors: mix(tone, #ffffff, 0.4); opacity: 80%, 0%
                                            emit: jon and jh < 0.98 }
                                //  And where it lands, the water jumps while it pours.
                                particles { at: sx + 23, ay + 56 + 104 * (1 - lvl.$a.$l * eased); area: 14, 0; count: 60
                                            life: 0.2s .. 0.45s; speed: 30 .. 90; direction: -90deg; spread: 100deg
                                            gravity: 0, 600; size: 2.2, 0.8; colors: #ffffff, tone; opacity: 85%, 0%
                                            emit: pour.$a.$l > 0.01 and pour.$a.$l < 0.45 }
                                text ag.lname.$a.$l { at: sx + 58, ay + 62; anchor: left center; size: 11; weight: 500; width: 76; lines: 1; color: faint }
                                text number(avail * eased, 0, "%") { at: sx + 58, ay + 90; anchor: left center; size: 26; weight: 700; color: tone; show: known > 0.5 }
                                text "—" { at: sx + 58, ay + 90; anchor: left center; size: 26; weight: 700; color: #8b8f95; show: known < 0.5 }
                                text "left" { at: sx + 58, ay + 112; anchor: left center; size: 10.5; color: faint; opacity: 70% }
                                text ag.lrenew.$a.$l { at: sx + 58, ay + 134; anchor: left center; size: 10.5; width: 76; lines: 1; color: faint; opacity: 80% }
                                //  How far into its window it is, and a dot at
                                //  how much it has used: a dot ahead of the bar
                                //  is spending faster than time goes.
                                box { from: sx + 58, ay + 150; size: 72, 3; corner: 1.5; color: ink; opacity: 14% }
                                box { from: sx + 58, ay + 150; size: 72 * ag.elapsed.$a.$l * eased, 3; corner: 1.5; color: ink; opacity: 45% }
                                ellipse { at: sx + 58 + 72 * clamp(used / 100, 0, 1) * eased, ay + 151.5; radius: 3; color: tone; show: known > 0.5 }
                            }
                            zone box tank.$a.$l { at: sx + 23, ay + 108; size: 46, 112; corner: 13; active: page == agents and paging > 0.9 and ag.on.$a.$l }
                            on enter tank.$a.$l { hover.$a.$l: 1; impulse sway.$a.$l 1.5 }
                            on leave tank.$a.$l { hover.$a.$l: 0 }
                            //  A new reading makes every tube sway, a little
                            //  after its neighbour.
                            on agents_read { impulse sway.$a.$l 2.4 }
                        }
                    }
                }
            }
            //  And she reacts once, when the page comes in: little left
            //  somewhere, the «!» face; everything with margin, the happy one.
            on change page == agents and paging > 0.9 while page == agents and paging > 0.9 { face = reading; agents.face = reading }
            on still agents.face for 3.6s while agents.face == reading and ag.worst < 15 { face = alert; agents.face = verdict }
            on still agents.face for 3.6s while agents.face == reading and ag.worst >= 50 and ag.worst < 101 { face = happy; agents.face = verdict }
            on still agents.face for 3.6s while agents.face == reading and (ag.worst >= 15 and ag.worst < 50 or ag.worst > 100) { face = eye; agents.face = none }
            on still agents.face for 1.6s while agents.face == verdict { face = eye; agents.face = none }
            //  Leaving the page mid-reading does not leave her with waves for eyes.
            on change page while page != agents and agents.face != none { face = eye; agents.face = none }


            // ── the calendar ─────────────────────────────────────
            //  Every day is a drop, and it fills with water as it fills with
            //  things: one event a third, three and it is full. Today has a
            //  ring of light; the chosen one grows and sends a ripple out.
            //  Changing month, the days come in like a wave, each row a little
            //  behind the one above. Writing an event, a drop flies from the
            //  field to its day and splashes in it.
            prop cal.shift = 0 ~520ms
            prop cal.ripple = 1 ~650ms
            prop cal.fall = 0 ~16ms
            prop cal.jig = 0 ~lively
            on cal_went_next { cal.shift: 1 ~16ms; cal.shift: 0 ~560ms after 16ms }
            on cal_went_prev { cal.shift: -1 ~16ms; cal.shift: 0 ~560ms after 16ms }
            on cal_pick { cal.ripple: 0 ~16ms; cal.ripple: 1 ~650ms after 16ms }
            on cal_added { cal.fall: 0 ~16ms; cal.fall: 1 ~620ms after 16ms; play happy }
            on change cal.fall > 0.97 while cal.fall > 0.97 { emit cal_splash; impulse cal.jig 7 }
            on change page while page == calendar { focus cal_new }
            let cal.cw = 31
            let cal.ch = 34
            let cal.gx = card.x - 212
            let cal.gy = card.top + 152
            let cal.sx = cal.gx + mod(cal.sel, 7) * cal.cw
            let cal.sy = cal.gy + floor(cal.sel / 7) * cal.ch
            group {
                show: page == calendar
                //  Back a month, today, forward a month.
                prop cal.prev.glow = 0 ~140ms
                prop cal.next.glow = 0 ~140ms
                prop cal.today.glow = 0 ~140ms
                path { at: card.x + 92, card.top + 32; color: ink; stroke: 1.8; opacity: 55% + cal.prev.glow * 45%
                       move 5, 0; line 0, 5; line 5, 10 }
                box { at: card.x + 128, card.top + 37; size: 46, 24; corner: 12; color: ink; opacity: 8% + cal.today.glow * 10% }
                text "Today" { at: card.x + 128, card.top + 37; anchor: center; size: 11; weight: 500; color: ink }
                path { at: card.x + 160, card.top + 32; color: ink; stroke: 1.8; opacity: 55% + cal.next.glow * 45%
                       move 0, 0; line 5, 5; line 0, 10 }
                zone box cal_prev_btn { at: card.x + 95, card.top + 37; size: 28, 28; corner: 14; cursor: pointer; active: page == calendar and paging > 0.9 }
                zone box cal_today_btn { at: card.x + 128, card.top + 37; size: 46, 26; corner: 13; cursor: pointer; active: page == calendar and paging > 0.9 }
                zone box cal_next_btn { at: card.x + 163, card.top + 37; size: 28, 28; corner: 14; cursor: pointer; active: page == calendar and paging > 0.9 }
                on enter cal_prev_btn { cal.prev.glow: 1 }
                on leave cal_prev_btn { cal.prev.glow: 0 }
                on enter cal_next_btn { cal.next.glow: 1 }
                on leave cal_next_btn { cal.next.glow: 0 }
                on enter cal_today_btn { cal.today.glow: 1 }
                on leave cal_today_btn { cal.today.glow: 0 }
                on press cal_prev_btn { emit cal_prev }
                on press cal_next_btn { emit cal_next }
                on press cal_today_btn { emit cal_today }

                // ── her sky: where you are, and what it is like there. Pressed,
                //  it becomes a field to write another city; Enter keeps it.
                zone box sky_strip { at: card.x, card.top + 86; size: 456, 36; corner: 12; cursor: pointer; active: page == calendar and paging > 0.9 and not sky.editing }
                box { at: card.x, card.top + 86; size: 456, 36; corner: 12; color: mix(#1d2124, #232a2c, sky_strip.hover) }
                box { at: card.x, card.top + 86; size: 456, 36; corner: 12; stroke: 1; color: mint; opacity: if(sky.editing, 60%, 0%) }
                group {
                    show: not sky.editing
                    //  A little sign of what it is like: the sun, or the moon at night;
                    //  a cloud if it is covered, with drops or flakes under it; a bolt.
                    let sg.x = card.x - 204
                    let sg.y = card.top + 86
                    let sg.cloudy = wx.cloud > 0.4 or wx.rain > 0.05 or wx.snow > 0.05 or wx.fog > 0.5
                    group {
                        glow: 5, 80%, #ffd36b
                        ellipse { at: sg.x, sg.y; radius: 6; color: #ffd36b; show: not sg.cloudy and sky.day > 0.3 }
                    }
                    ellipse { at: sg.x, sg.y; radius: 6; color: #e8ecf5; show: not sg.cloudy and sky.day <= 0.3 }
                    ellipse { at: sg.x + 2.8, sg.y - 1.8; radius: 5; color: #1d2124; show: not sg.cloudy and sky.day <= 0.3 }
                    body {
                        color: mix(#dfe3e8, #9aa3af, max(wx.rain, wx.storm))
                        opacity: if(sg.cloudy, 1, 0)
                        ellipse { at: sg.x - 4.5, sg.y - 1; radius: 4.5 }
                        ellipse { at: sg.x + 1, sg.y - 4; radius: 5.5; blend: 3 }
                        ellipse { at: sg.x + 6, sg.y; radius: 4; blend: 3 }
                        box { at: sg.x + 0.5, sg.y + 1.5; size: 17, 5; corner: 2.5; blend: 3 }
                    }
                    line { from: sg.x - 4, sg.y + 7; to: sg.x - 5.2, sg.y + 10.5; width: 1.4; color: #a8d8ff; show: wx.rain > 0.05 }
                    line { from: sg.x + 1, sg.y + 7; to: sg.x - 0.2, sg.y + 10.5; width: 1.4; color: #a8d8ff; show: wx.rain > 0.05 }
                    line { from: sg.x + 6, sg.y + 7; to: sg.x + 4.8, sg.y + 10.5; width: 1.4; color: #a8d8ff; show: wx.rain > 0.05 }
                    ellipse { at: sg.x - 3, sg.y + 9; radius: 1.2; color: #ffffff; show: wx.snow > 0.05 }
                    ellipse { at: sg.x + 3.5, sg.y + 9.5; radius: 1.2; color: #ffffff; show: wx.snow > 0.05 }
                    path { at: sg.x + 1, sg.y + 5; color: #ffd36b; show: wx.storm > 0.5
                           move 1, 0; line -1.5, 4; line 1, 4; line -1, 8; line 3, 3; line 0.5, 3; line 2, 0; close }
                    text wx.place { at: card.x - 186, card.top + 86; anchor: left center; size: 12.5; weight: 600; width: 150; lines: 1; color: ink; show: wx.ok }
                    text "{wx.temp, 0}°" { at: card.x - 20, card.top + 86; anchor: left center; size: 17; weight: 600
                                           color: mix(mix(ink, #a8d8ff, wx.cold), #ffbb85, wx.heat); show: wx.ok }
                    text wx.summary { at: card.x + 24, card.top + 86; anchor: left center; size: 11.5; width: 120; lines: 1; color: faint; show: wx.ok }
                    text "{wx.hi, 0}° · {wx.lo, 0}°" { at: card.x + 214, card.top + 86; anchor: right center; size: 11; color: faint; opacity: 75%; show: wx.ok }
                    text "Your city, for her sky" { at: card.x - 186, card.top + 86; anchor: left center; size: 12; color: faint; show: not wx.ok }
                }
                group {
                    show: sky.editing
                    input city_q { at: card.x - 206, card.top + 86; width: 400; size: 13; color: ink; placeholder: "A city · Enter keeps it"; selection: #2f5f52 }
                }
                on press sky_strip {
                    sky.editing = true
                    focus city_q
                }
                on submit city_q { sky.editing = false }
                on key Escape while sky.editing { sky.editing = false }

                //  The weekdays.
                repeat w in 1..8 {
                    text cal.wd.$w { at: cal.gx + (w - 1) * cal.cw, card.top + 124; anchor: center; size: 10; weight: 600; color: faint; opacity: 60% }
                }
                //  The days.
                repeat k in 0..42 {
                    let row = floor(k / 7)
                    let wave = cal.shift * 80 * (1 + row * 0.22)
                    let dx = cal.gx + mod(k, 7) * cal.cw + wave
                    let dy = cal.gy + row * cal.ch
                    prop cal.pick.$k = 0 ~lively
                    follow cal.pick.$k = if(cal.sel == k, 1, 0)
                    prop cal.lvl.$k = 0 ~calm
                    follow cal.lvl.$k = min(cal.n.$k, 3) / 3 * 0.85
                    let grow = 1 + 0.12 * cal.pick.$k + cal.jig * 0.02 * cal.pick.$k
                    group {
                        opacity: (35% + 65% * if(cal.in.$k, 1, 0)) * clamp(1 - abs(cal.shift) * 1.3, 0, 1)
                        pivot: dx, dy
                        scale: grow, grow
                        ellipse { at: dx, dy; radius: 13; color: mix(#24282c, #2f3a37, cal.pick.$k) }
                        //  Its water: a level inside the drop, with a lighter surface.
                        group {
                            clip inset 0 ellipse { at: dx, dy; radius: 13 }
                            box { from: dx - 13, dy + 13 - 26 * cal.lvl.$k; size: 26, 26 * cal.lvl.$k; color: mint; opacity: 50% }
                            box { from: dx - 13, dy + 13 - 26 * cal.lvl.$k; size: 26, 1.5; color: #ffffff; opacity: 45% * if(cal.lvl.$k > 0.02, 1, 0) }
                        }
                        //  Today: a ring of light.
                        group {
                            glow: 6, 70%, mint
                            ellipse { at: dx, dy; radius: 14.5; stroke: 1.6; color: mint; show: cal.today.$k }
                        }
                        ellipse { at: dx, dy; radius: 13.5; stroke: 1.6; color: ink; opacity: cal.pick.$k * 90% }
                        text number(cal.day.$k, 0) { at: dx, dy; anchor: center; size: 12; weight: 500 + 200 * if(cal.today.$k, 1, 0); color: ink }
                    }
                    zone box cal_cell.$k { at: dx, dy; size: 30, 30; corner: 15; cursor: pointer; active: page == calendar and paging > 0.9 }
                    on press cal_cell.$k { emit cal_pick(k) }
                }
                //  The ripple from the chosen day.
                ellipse { at: cal.sx, cal.sy; radius: 14 + 30 * cal.ripple; stroke: 1.5; color: mint; opacity: (1 - cal.ripple) * 70% }
                particles { at: cal.sx, cal.sy - 6; count: 18; life: 0.3s .. 0.6s; speed: 40 .. 110; direction: -90deg; spread: 120deg
                            gravity: 0, 420; size: 3, 1; colors: #ffffff, mint; opacity: 90%, 0%; burst: cal_splash }

                //  The chosen day, big, and what it holds.
                text cal.sel_day { at: card.x + 14, card.top + 138; anchor: left center; size: 34; weight: 700; color: ink }
                text cal.sel_title { at: card.x + 66, card.top + 130; anchor: left center; size: 12; weight: 500; width: 150; lines: 1; color: ink }
                text cal.sel_sub { at: card.x + 66, card.top + 148; anchor: left center; size: 10.5; width: 150; lines: 1; color: faint; opacity: 75% }
                component CalRow(e: record, drop: event) {
                    size: 212, 30
                    prop glow = 0 ~140ms
                    zone box touch { from: 0, 0; size: 212, 30; corner: 9 }
                    box { from: 0, 0; size: 212, 30; corner: 9; color: #23272b; opacity: 70% + glow * 30% }
                    box { from: 5, 8; size: 3, 14; corner: 1.5; color: #9ed6bd }
                    text e.time { at: 15, 15; anchor: left center; size: 11; weight: 600; width: 44; lines: 1; color: #9ed6bd }
                    text e.title { at: 62, 15; anchor: left center; size: 12; width: 124; lines: 1; color: #f5f7f5 }
                    line { from: 194, 11; to: 202, 19; width: 1.6; color: #f5f7f5; opacity: 25% + glow * 60% }
                    line { from: 202, 11; to: 194, 19; width: 1.6; color: #f5f7f5; opacity: 25% + glow * 60% }
                    zone box gone { at: 198, 15; size: 24, 24; corner: 12; cursor: pointer; active: page == calendar }
                    on enter touch { glow: 1 }
                    on leave touch { glow: 0 }
                    on press gone { emit drop(e.index) }
                }
                column cal_list ~quick {
                    at: card.x + 8, card.top + 172
                    gap: 6
                    for e in cal_events { CalRow(e, drop: cal_delete) }
                }
                text "Nothing yet." { at: card.x + 118, card.top + 220; anchor: center; size: 11.5; color: faint; opacity: 60%; show: cal_events.count < 1 }

                //  Writing one: the field, and the drop it becomes.
                box { at: card.x, card.top + 380; size: 456, 44; corner: 14; color: mix(#202122, ink, glassiness); opacity: mix(1, veil, glassiness) }
                ellipse { at: card.x - 206, card.top + 380; radius: 6; color: mint; opacity: 80% }
                input cal_new { at: card.x - 190, card.top + 380; width: 380; size: 13; color: ink; placeholder: "New event: 10:30 Dentist"; selection: #2f5f52 }
                text "Start with a time, or leave it for the whole day. Enter saves it." { at: card.x, card.top + 414; anchor: center; size: 10; color: faint; opacity: 55% }
                let fall.x0 = card.x - 206
                let fall.y0 = card.top + 380
                ellipse { at: fall.x0 + (cal.sx - fall.x0) * cal.fall, fall.y0 + (cal.sy - fall.y0) * cal.fall - 110 * sin(cal.fall * 180)
                          radius: 5.5; color: mint; show: cal.fall > 0.01 and cal.fall < 0.97 }
            }

            // ── the menu of a tray icon ──────────────────────────
            //  It is a page like the others, and that is why it holds what a
            //  dropdown does not: a Telegram or Steam menu is fifteen rows with
            //  submenus. The list scrolls with the wheel if it does not fit, and a
            //  submenu is entered —the first row goes back—, which is what lets
            //  everything happen in the same place without opening boxes beside it.
            component MenuOption(r: record, pick: event) {
                size: 456, 32 - r.separator * 22
                prop glow = 0 ~140ms
                box touch { from: 0, 0; size: 456, 32 - r.separator * 22; corner: 9; color: #262728; opacity: glow
                           cursor: pointer; active: r.enabled and not r.separator and page == systray and paging > 0.9 }
                box { from: 8, 4; size: 440, 1; color: ink; opacity: r.separator * 12% }
                text r.label { at: 14, 16; anchor: left center; size: 12.5; width: 390; lines: 1; color: ink
                               opacity: (1 - r.separator) * (0.45 + r.enabled * 0.55) }
                //  Checkbox: filled if it is ticked, the ring if it is a checkbox and
                //  is not ticked.
                ellipse { at: 436, 16; radius: 3.5; color: mint; opacity: r.checked > 0.5 }
                ellipse { at: 436, 16; radius: 3.5; stroke: 1.2; color: ink; opacity: if(r.checked > -0.5, 0.5, 0) }
                path { at: 433, 11; color: ink; stroke: 1.6; opacity: if(r.children > 0, 0.6, 0)
                       move 0, 0; line 5, 5; line 0, 10 }
                on enter touch { glow: 1 }
                on leave touch { glow: 0 }
                on press touch { emit pick(r.index) }
            }
            column option_list ~quick {
                at: card.x - 228, card.top + 112
                view: 456, 286
                show: page == systray
                for r in options { MenuOption(r, pick: systray_pick) }
            }
            text "Asking it for its menu…" { at: card.x, card.top + 200; anchor: center; size: 11.5; color: #8b8f95
                                            show: page == systray and options.count < 1 }
            //  The scene opens the page, on the spot; the logic fills it. If it
            //  turns out there is no menu to read, it is the logic that closes it.
            on systray_menu { page = systray }

            // ── the session ──────────────────────────────────────
            //  Two separate intentions, as the sheet asks: **taking a break**
            //  —lock and suspend, which are done just like that— and **finishing**
            //  —log out, reboot and power off—, which open a separate
            //  confirmation. Hovering only ANTICIPATES: it shows on her face what
            //  it would do, and does nothing.
            group {
                show: page == session and question < 0.99
                opacity: 1 - question
                move: -22 * question, 0
                repeat b in 0..2 {
                    let bx = card.x - 117 + b * 234
                    prop pause.$b = 0 ~140ms
                    box { at: bx, card.top + 150; size: 222, 70; corner: 14
                          color: mix(#202021, #1e2a25, pause.$b) }
                    box { at: bx, card.top + 150; size: 222, 70; corner: 14; stroke: 1; color: mint; opacity: pause.$b }
                    zone box pause_zone.$b { at: bx, card.top + 150; size: 222, 70; corner: 14; cursor: pointer
                                        active: page == session and confirming == none and paging > 0.9 }
                    on enter pause_zone.$b { pause.$b: 1 }
                    on leave pause_zone.$b { pause.$b: 0 }
                }
                //  The lock's padlock: the body and its shackle.
                box { at: card.x - 161, card.top + 152; size: 15, 12; corner: 3; color: ink }
                arc { at: card.x - 161, card.top + 142; radius: 5; span: 180deg; width: 1.8; color: ink }
                text "Lock" { at: card.x - 141, card.top + 142; anchor: left center; size: 13; color: ink }
                text "Protect the session" { at: card.x - 141, card.top + 160; anchor: left center; size: 11; color: #8b8f95 }
                //  And the suspend moon, the same as the Haven's.
                ellipse { at: card.x + 75, card.top + 150; radius: 8.6; color: ink }
                ellipse { at: card.x + 79.5, card.top + 145.5; radius: 7.4; color: mix(#202021, #1e2a25, pause.1) }
                text "Suspend" { at: card.x + 93, card.top + 142; anchor: left center; size: 13; color: ink }
                text "Go into standby" { at: card.x + 93, card.top + 160; anchor: left center; size: 11; color: #8b8f95 }

                line { from: card.x - 228, card.top + 200; to: card.x + 228, card.top + 200; width: 1; color: ink; opacity: 12% }
                text "When you're done" { at: card.x - 228, card.top + 220; anchor: left center; size: 11; weight: 600; color: #8b8f95 }

                //  The three that cannot be undone. Each one with its arrow, and the
                //  power-off one in coral: the colour marks what does not come back.
                repeat f in 0..3 {
                    let fy = card.top + 252 + f * 46
                    prop finish.$f = 0 ~140ms
                    box { at: card.x, fy; size: 456, 42; corner: 11; color: #202021; opacity: finish.$f * 80% }
                    path { at: card.x + 212, fy - 5; color: mix(#8b8f95, ink, finish.$f); stroke: 1.6
                           move 0, 0; line 5, 5; line 0, 10 }
                    zone box finish_zone.$f { at: card.x, fy; size: 456, 42; corner: 11; cursor: pointer
                                        active: page == session and confirming == none and paging > 0.9 }
                    on enter finish_zone.$f { finish.$f: 1 }
                    on leave finish_zone.$f { finish.$f: 0 }
                }
                //  Log out: a door and the arrow going out.
                box { at: card.x - 208, card.top + 252; size: 11, 15; corner: 2; stroke: 1.6; color: ink }
                path { at: card.x - 198, card.top + 247; color: ink; stroke: 1.6; move 0, 0; line 5, 5; line 0, 10 }
                text "Log out" { at: card.x - 184, card.top + 252; anchor: left center; size: 12.5; color: ink }
                //  Reboot: the arrow that goes all the way round.
                arc { at: card.x - 208, card.top + 298; radius: 7; span: 280deg; width: 1.7; rotate: 20deg; color: ink }
                path { at: card.x - 204, card.top + 289; color: ink; stroke: 1.6; move 0, 0; line 4, 3; line 0, 6 }
                text "Restart" { at: card.x - 184, card.top + 298; anchor: left center; size: 12.5; color: ink }
                //  Power off: the power symbol, and in coral.
                arc { at: card.x - 208, card.top + 344; radius: 7; span: 280deg; width: 1.7; rotate: 180deg; color: #e0655a }
                box { at: card.x - 208, card.top + 336; size: 1.7, 7; corner: 0.9; color: #e0655a }
                text "Power off" { at: card.x - 184, card.top + 344; anchor: left center; size: 12.5; color: #e0655a }

                text "Esc to go back" { at: card.x, card.top + 400; anchor: center; size: 11; color: #8b8f95; opacity: 70% }
            }

            // ── and the confirmation, which is something else ────
            //  «Back receives the initial focus; the chosen action needs a new,
            //  deliberate activation.» That is why it is not one more step of the
            //  same page: it is a question, with its title, what is going to
            //  happen and two buttons that do not look alike.
            group {
                show: page == session and question > 0.01
                opacity: question
                move: 26 * (1 - question), 0
                text "Log out?" { at: card.x - 228, card.top + 146; anchor: left center; size: 19; weight: 500; color: ink; show: confirming == logout }
                text "Restart the computer?" { at: card.x - 228, card.top + 146; anchor: left center; size: 19; weight: 500; color: ink; show: confirming == reboot }
                text "Shut down the computer?" { at: card.x - 228, card.top + 146; anchor: left center; size: 19; weight: 500; color: ink; show: confirming == poweroff }
                text "Applications will be closed." { at: card.x - 228, card.top + 186; anchor: left center; size: 12; color: #8b8f95 }
                text "Save your changes before continuing." { at: card.x - 228, card.top + 208; anchor: left center; size: 12; color: #8b8f95 }

                prop back.glow = 0 ~140ms
                prop do_it.glow = 0 ~140ms
                box { at: card.x - 128, card.top + 264; size: 200, 44; corner: 11; color: mix(mix(#1b1b1c, #232425, back.glow), ink, glassiness); opacity: mix(1, veil + back.glow * veil.glow, glassiness) }
                box { at: card.x - 128, card.top + 264; size: 200, 44; corner: 11; stroke: 1.4; color: mint }
                text "Back" { at: card.x - 128, card.top + 264; anchor: center; size: 13; color: ink }
                box { at: card.x + 118, card.top + 264; size: 220, 44; corner: 11; color: mix(#e0655a, #f0796a, do_it.glow) }
                text "Log out" { at: card.x + 118, card.top + 264; anchor: center; size: 13; weight: 600; color: #200705; show: confirming == logout }
                text "Restart" { at: card.x + 118, card.top + 264; anchor: center; size: 13; weight: 600; color: #200705; show: confirming == reboot }
                text "Shut down" { at: card.x + 118, card.top + 264; anchor: center; size: 13; weight: 600; color: #200705; show: confirming == poweroff }
                zone box back { at: card.x - 128, card.top + 264; size: 200, 44; corner: 11; cursor: pointer
                                  active: page == session and confirming != none and paging > 0.9 }
                zone box do_it { at: card.x + 118, card.top + 264; size: 220, 44; corner: 11; cursor: pointer
                                 active: page == session and confirming != none and paging > 0.9 and armed }
                on enter back { back.glow: 1 }
                on leave back { back.glow: 0 }
                on enter do_it { do_it.glow: 1 }
                on leave do_it { do_it.glow: 0 }
                text "Esc to go back" { at: card.x, card.top + 320; anchor: center; size: 11; color: #8b8f95; opacity: 70% }
            }

            //  Pointing is not doing. Hovering only tells what it would do: the
            //  padlock, the eyelids, the door, the turn or the power symbol. And on
            //  leaving, her face comes back.
            //  On jumping from one to another, `enter` and `leave` fall in the same
            //  frame, and the second one erased what the first had just set. The
            //  guards read the previous frame, so looking at the value is not
            //  enough: what sorts it out is **declaring the one that clears first**.
            on leave pause_zone.0 while confirming == none and hint == lock { hint = none }
            on leave pause_zone.1 while confirming == none and hint == sleep { hint = none }
            on leave finish_zone.0 while confirming == none and hint == logout { hint = none }
            on leave finish_zone.1 while confirming == none and hint == reboot { hint = none }
            on leave finish_zone.2 while confirming == none and hint == poweroff { hint = none }
            on enter pause_zone.0 { hint = lock }
            on enter pause_zone.1 { hint = sleep }
            on enter finish_zone.0 { hint = logout }
            on enter finish_zone.1 { hint = reboot }
            on enter finish_zone.2 { hint = poweroff }
            //  And from there to her face. One fact drives five springs, and the
            //  five switch off by themselves on changing place: there is no need to
            //  say in each rule what the other four stop being worth.
            on change hint {
                padlock: if(hint == lock, 1, 0)
                lids: if(hint == sleep, 1, 0)
                door: if(hint == logout, 1, 0)
                turn: if(hint == reboot, 1, 0)
                power: if(hint == poweroff, 1, 0)
            }
            //  «A single turn»: one whole turn every time you point at it, and none
            //  while you stay there.
            on change hint == reboot while hint == reboot { twirl: twirl + 1 }

            //  Lock and suspend are asked for and that is it: there is nothing to
            //  confirm in something that is undone with the password or with a
            //  key. The other three open the question.
            on press pause_zone.0 { open = false; page = none; emit lock }
            on press pause_zone.1 { emit session(2); open = false; page = none }
            on press finish_zone.0 { confirming = logout }
            on press finish_zone.1 { confirming = reboot }
            on press finish_zone.2 { confirming = poweroff }
            on press back { confirming = none }
            //  And the real one, only once. `armed` is what stops the row's double
            //  click from landing on the button right below it: the sheet asks for
            //  «a new, deliberate activation», and a second click that came from
            //  the previous one is not that.
            on press do_it { emit session(if(confirming == logout, 3, 0) + if(confirming == reboot, 4, 0) + if(confirming == poweroff, 5, 0))
                             powerdown: 1 }
            //  «If the system rejects or inhibits the action, get normal eyes
            //  back.» There is no way to ask it, but there is a way to notice we are
            //  still here: after four seconds, if nothing has happened, she comes
            //  back.
            on still powerdown for 4s while powerdown > 0.5 { powerdown: 0; confirming = none }
            follow question = if(confirming == none, 0, 1)
            on still confirming for 320ms while confirming != none { armed = true }
            on change confirming { armed = false }
            //  Changing page disarms whatever there was: «do not leave a
            //  confirmation armed when the option changes».
            on change page while page != session { confirming = none; hint = none }
            on change confirming while confirming == logout { hint = logout }
            on change confirming while confirming == reboot { hint = reboot }
            on change confirming while confirming == poweroff { hint = poweroff }
            on change confirming while confirming == none { hint = none }

            //  Focus: what it does, said. There is no list to bring.
            group {
                show: page == concentration
                text "While it lasts, notices are kept and not shown." {
                    at: card.x - 228, card.top + 119; anchor: left center; size: 12; width: 456; lines: 2; color: #8b8f95 }
                repeat m in 0..3 {
                    let mx = card.x - 158 + m * 158
                    prop mins_glow.$m = 0 ~140ms
                    box { at: mx, card.top + 185; size: 140, 44; corner: 12; color: mix(#202021, #262728, mins_glow.$m) }
                    text "{25 + m * 20} min" { at: mx, card.top + 185; anchor: center; size: 12.5; color: ink }
                    zone box mins_zone.$m { at: mx, card.top + 185; size: 140, 44; corner: 12; cursor: pointer; active: page == concentration and paging > 0.9 }
                    on enter mins_zone.$m { mins_glow.$m: 1 }
                    on leave mins_zone.$m { mins_glow.$m: 0 }
                    //  And here is where the Haven is entered: you choose how long,
                    //  and the first thing it does is close. Leaving the panel open
                    //  on top of her would be the opposite of what you have just
                    //  asked for. The page folds away first so that on opening it
                    //  again the three cards are there and not the inside of one.
                    on press mins_zone.$m { remaining = 25 + m * 20; page = none; open = false; emit enter_haven }
                }
            }
        }

        group {
            opacity: overview
            // ── the line and what is playing ─────────────────────────
            line { from: x0, card.top + 424; to: card.x + 228, card.top + 424; width: 1; color: ink; opacity: 12% }
            let by = card.top + 466
            group {
                show: playback.playing
                //  The cover, which here is a gradient: there is no artwork yet.
                body {
                    gradient: radial x0 + 28, by - 6 radius 44, #e8c9a8, #6f8f7d
                    box { at: x0 + 28, by; size: 56, 56; corner: 12 }
                }
                text playback.title { at: x0 + 66, by - 9; anchor: left center; size: 12.5; width: 130; lines: 1; color: ink }
                text playback.artist { at: x0 + 66, by + 10; anchor: left center; size: 11; width: 130; lines: 1; color: #8b8f95 }
                //  Previous, pause and next. The pause goes in its filled disc.
                let bx1 = card.x + 126
                let bx3 = card.x + 206
                path { at: bx1 - 6, by - 7; color: ink; move 12, 0; line 12, 14; line 0, 7; close }
                box { at: bx1 - 8, by; size: 2.6, 14; corner: 1.3; color: ink }
                ellipse { at: card.x + 166, by; radius: 19; color: #2a2b2c }
                box { at: card.x + 162, by; size: 3.4, 14; corner: 1.7; color: ink }
                box { at: card.x + 170, by; size: 3.4, 14; corner: 1.7; color: ink }
                path { at: bx3 - 6, by - 7; color: ink; move 0, 0; line 12, 7; line 0, 14; close }
                box { at: bx3 + 10, by; size: 2.6, 14; corner: 1.3; color: ink }
                zone box prev_btn { at: bx1, by; size: 34, 34; corner: 17; cursor: pointer; active: content > 0.9 }
                zone box play_btn { at: card.x + 166, by; size: 42, 42; corner: 21; cursor: pointer; active: content > 0.9 }
                zone box next_btn { at: bx3, by; size: 34, 34; corner: 17; cursor: pointer; active: content > 0.9 }
                on press prev_btn { emit previous }
                on press play_btn { emit play_pause }
                on press next_btn { emit next }
            }
            text "Nothing playing" { at: card.x, by; anchor: center; size: 11.5; color: #8b8f95; show: not playback.playing }
        }

    }

    // ── opening and closing ──────────────────────────────────────
    //  On opening the geometry leads and the content comes in behind. On
    //  closing, the other way round: 50 ms of fade and then 210 of folding away,
    //  which is what makes it look like she swallows it and not like it switches
    //  off.
    on change open while open {
        offset: 1 ~290ms
        card: 1 ~290ms
        content: 1 ~200ms after 90ms
    }
    //  Closing is three beats, and that is the whole trick: **they do not happen
    //  at the same time**. What is read switches off (50 ms), she drinks it —the
    //  card narrows towards her and the neck pinches off by itself, as it already
    //  was—, she gulps when it has just gone in, and THEN she goes back to her
    //  place, bowing the path and leaning towards where she is going. On
    //  arriving, the water at the edge notices: it sinks a little around her and
    //  bounces, like when something settles.
    //
    //  Before, the three things happened on top of each other in 210 ms: the card
    //  shrank while she had already left, so nothing was drunk, a box was left
    //  alone fading out in a corner.
    on change open while not open {
        content: 0 ~50ms
        card: 0 ~210ms after 30ms
    }

    // ── one thing of hers out, and only one ──────────────────────
    //  The card, the finder and the swell all three come out of her, moving her
    //  aside (`offset`). Before they did not exclude each other —the finder closed
    //  the card, but the swell closed nothing and nothing closed it—: pressing
    //  her face with the swell open brought the card out ON TOP, with the two
    //  titles stepping on each other. Now opening one closes the others, and the
    //  menu too.
    //
    //  And going back to her place belongs to all of them, not to each one: each
    //  one sent her back on closing, 200 ms later, even if another was still out;
    //  on folding the card away she went back with the swell open, and the swell,
    //  brought out from there, was cut against the edge. Now she goes back when
    //  nothing is left out and it stays like that for 200 ms: if something else
    //  comes out in that time, she does not go back.
    let anything_out = open or searching or tray_open
    on change open while open { tray_open = false; searching = false }
    //  Whatever opened the card —a press, the finder, a shortcut—, she wakes
    //  up for it: a card beside a sleeping ball was a page nobody was showing.
    on change open while open and asleep { asleep = false }
    on change tray_open while tray_open { open = false; searching = false; menu_open = false }
    on still anything_out for 200ms while not anything_out { offset: 0 ~homing }

    //  And neither the gulp nor the splash go by the clock: they go by what is
    //  happening. When almost nothing is left of the card, she has swallowed it;
    //  and when she has almost arrived, the water at the edge notices.
    on change card < 0.2 while not open and card < 0.2 { play gulp }
    on change offset < 0.08 while not open and offset < 0.08 {
        impulse wobble -120
        impulse bounce -70
    }

    // ── opening and closing the finder ───────────────────────────
    //  «She moves aside» and **turns into a magnifying glass**: both things at
    //  once, because it is the same movement. And on closing, the usual order
    //  —first what is read, then the geometry— and she comes back afterwards,
    //  with her spring.
    on search { searching = true }
    on change searching while searching {
        open = false
        menu_open = false
        tray_open = false
        asleep = false
        needed = true
        wanted = true
        selected = 0
        offset: 1 ~290ms
        magnifier: 1 ~320ms
        finder: 1 ~290ms
        finder_content: 1 ~200ms after 90ms
        focus query
    }
    on change searching while not searching {
        finder_content: 0 ~50ms
        finder: 0 ~210ms after 30ms
        magnifier: 0 ~280ms after 60ms
        blur
    }
    on key Escape while searching { searching = false }
    //  The arrows choose and Enter opens. The logic sorts the list; here it is
    //  only said which one is pointed at.
    on key Down while searching { selected = min(selected + 1, max(results.count - 1, 0)) }
    on key Up while searching { selected = max(selected - 1, 0) }
    on submit query { emit open_result(selected); searching = false }
    //  «Opens»: the sheet draws her with happy eyes. A short wink and a jump, and
    //  back to her business: what she celebrates is having found it, not herself.
    gesture happy reflex {
        140ms out_quad { eyes: 6.5; sx: 1.06; sy: 0.92; body.y: 2.4 }
        220ms out_back { eyes: 6.5; sx: 0.97; sy: 1.05; body.y: -3.2 }
        240ms          { eyes: 8 }
    }
    on open_result { searching = false; play happy }
    //  The height follows what the list takes up, and the selection travels to
    //  its row. Both things with a spring, so typing moves the panel and the
    //  arrows move the mark, without anyone rearranging them.
    follow finder_h = 176 + result_list.height
    follow sel_y = by0 + 140 + selected * 46 + 22

    // ── the level ────────────────────────────────────────────────
    //  It fires with whatever changes the volume, wherever it comes from. And it
    //  does not happen when sunk: the volume key is not addressed to her.
    follow vol_level = sound.volume
    //  And it does not happen when asleep: the volume key is not addressed to her.
    on change sound.volume while out > 0.9 and not asleep { meter: 1 }
    //  It holds 1.1 s after the LAST change, not after each one: a burst of key
    //  presses is one continuous reading and not a blink per step. This is what
    //  pleamar could not say and now says: `on still`.
    on still sound.volume for 1.1s { meter: 0 }

    // ── the life of a notice ─────────────────────────────────────
    //  A notice brings her out if she is sunk, and then the card waits for her
    //  to have come out: separating and presenting at the same time buried one
    //  in the other.
    //  In the Haven it is kept and that is it: no card, no jump, no opening.
    //  Only her pearl grows under the waterline.
    on notice while haven or hush { seq = seq + 1; emit direct }
    //  Asleep: no card, no jump, no opening. The drop forms, falls, and she
    //  opens one eye. What raises the count is the `direct` afterwards, on sinking
    //  in: the drop **is** the notice arriving, so the count goes up when it goes
    //  in and not when someone sends it.
    on notice while asleep and not haven and not hush { reading_cat = cat; seq = seq + 1; play trickle }
    //  And an urgent one does wake her, and opens the tray. It is the only thing
    //  allowed to do it.
    on urge while asleep { asleep = false }
    on notice while not haven and not hush and not asleep and phase == 0 and out > 0.9 { reading_cat = cat; phase = 1; burst = 1; seq = seq + 1; arrival_seq = seq; mark = mark + 1; needed = true; wanted = true; play startle; arrive: 1 ~220ms
        land: 0 ~16ms; land: 1 ~850ms after 16ms; write: 0 ~16ms; write: 1 ~1100ms after 560ms; read.t: 0 ~16ms
        sign: 1 ~200ms; sign: 0 ~260ms after 1600ms }
    on notice while not haven and not hush and not asleep and phase == 0 and out <= 0.9 { reading_cat = cat; phase = 1; burst = 1; seq = seq + 1; arrival_seq = seq; needed = true; wanted = true; play startle; arrive: 1 ~220ms after 560ms
        land: 0 ~16ms; land: 1 ~850ms after 580ms; write: 0 ~16ms; write: 1 ~1100ms after 1120ms; read.t: 0 ~16ms
        sign: 1 ~200ms after 560ms; sign: 0 ~260ms after 2160ms }
    on change out > 0.9 while phase == 1 { mark = mark + 1 }
    //  And the start **once she can be seen**. Sunk, the gesture happened under
    //  the water —620 ms of journey— and by the time she peeked out it was over:
    //  the surprise of a notice arriving is never seen if it arrives while she is
    //  sunk.
    on change out > 0.9 while phase == 1 and out > 0.9 { play startle }
    //  Another one while it is still being read: it stacks, and the reading
    //  starts over. Not one more jump: the gesture is already on, and a mascot
    //  that jumps for every message in a group ends up switched off.
    on notice while not haven and not hush and phase == 1 { seq = seq + 1; burst = burst + 1; mark = mark + 1; read.t: 0 ~16ms; write: 0 ~16ms; write: 1 ~900ms after 60ms }
    //  With the burst already flying, the one that arrives goes straight to its drop.
    on notice while not haven and not hush and phase == 2 { seq = seq + 1; emit direct }

    //  3.2 s to read it, which the pointer over it stops: when it leaves, it
    //  counts again. It is `on still` again: «when it has gone that long without
    //  anything starting the reading over».
    zone box notice_zone { at: arrival.x0, cy_actual + 7 + 15 * chips; size: 250, 58 + 30 * chips; corner: 14; cursor: pointer; active: phase == 1 }
    //  Its chips, on top of it: the press belongs to the zone declared last.
    //  Where each chip goes: Open and Done first; with a pile, «All» third;
    //  then its own actions, as many as fit.
    repeat i in 0..5 {
        zone box chip.$i { at: f.left + 41 + chip.slot.$i * 58, f.top + 58; size: 54, 22; corner: 11; cursor: pointer
                           active: chips > 0.8 and phase == 1 and chip.on.$i }
        on enter chip.$i { chip.glow.$i: 1 }
        on leave chip.$i { chip.glow.$i: 0 }
    }
    //  Open, and its own actions: done with the reading, the pile goes as always.
    on press chip.0 { emit notice_act(0); phase = 2 }
    on press chip.2 { emit notice_act(2); phase = 2 }
    on press chip.3 { emit notice_act(3); phase = 2 }
    //  Done: only the one in front. With more behind, it vanishes in a puff and
    //  the next one comes to the front, written again, with its reading anew.
    //  Alone, the card goes without flying to a count: there is nothing left
    //  pending.
    on press chip.1 while burst > 1 { emit notice_act(1); emit notice_puff; burst = burst - 1; read.t: 0 ~16ms; write: 0 ~16ms; write: 1 ~900ms after 140ms }
    on press chip.1 while burst < 2 { emit notice_act(1); emit notice_gone }
    //  All: the whole pile done.
    on press chip.4 { emit notice_act(9); emit notice_gone }
    //  Later and mute: the one in front leaves like «Done», without history for
    //  «later» —it comes back— and with it for «mute».
    zone ellipse later_zone { at: f.left + 208, f.top + 15; radius: 11; cursor: pointer; active: chips > 0.8 and phase == 1 }
    zone ellipse hush_zone { at: f.left + 232, f.top + 15; radius: 11; cursor: pointer; active: chips > 0.8 and phase == 1 }
    on enter later_zone { later.glow: 1 }
    on leave later_zone { later.glow: 0 }
    on enter hush_zone { hush.glow: 1 }
    on leave hush_zone { hush.glow: 0 }
    on press later_zone while burst > 1 { emit notice_act(10); emit notice_puff; burst = burst - 1; read.t: 0 ~16ms; write: 0 ~16ms; write: 1 ~900ms after 140ms }
    on press later_zone while burst < 2 { emit notice_act(10); emit notice_gone }
    on press hush_zone while burst > 1 { emit notice_act(11); emit notice_puff; burst = burst - 1; read.t: 0 ~16ms; write: 0 ~16ms; write: 1 ~900ms after 140ms }
    on press hush_zone while burst < 2 { emit notice_act(11); emit notice_gone }
    on notice_gone {
        phase = 0
        wanted = false
        hovered = false
        arrive: 0 ~240ms
        land: 0 ~16ms after 240ms; write: 0 ~16ms; read.t: 0 ~16ms
    }
    on enter notice_zone { hovered = true }
    on leave notice_zone { hovered = false; mark = mark + 1 }
    //  And the arriving card itself: pressing it opens the swell.
    on press notice_zone { filter = 0; emit tray; emit open_tray }
    //  3.2 s to read one; 4.2 if there are several, which is what the contract
    //  says. They are two rules because a rule's `for` is a written time and not
    //  a sum; here it does not get in the way, and said twice it reads well.
    //  And if the swell opens, the arriving card **goes away**: what it says is
    //  already inside, and leaving it on top is the same news twice —it is just
    //  what was seen when an urgent one opened it—. It does not disappear: it
    //  flies off to its drop, which is the journey it had to make anyway.
    on change tray_open while tray_open and phase == 1 { phase = 2 }
    //  The reading ends when its water line runs out: 3.2 s, or 4.2 with
    //  several; the pointer over the card stops it where it is.
    on change read.t >= 1 while phase == 1 and read.t >= 1 { phase = 2 }
    //  And they fly together, each one a little after the previous one.
    on change phase while phase == 2 {
        fly.2: 1 ~280ms
        fly.1: 1 ~280ms after 45ms
        fly.0: 1 ~280ms after 90ms
    }
    on change fly.0 > 0.97 while phase == 2 and fly.0 > 0.97 { emit landed }
    on landed {
        phase = 0
        wanted = false
        arrive: 0 ~16ms
        land: 0 ~16ms; write: 0 ~16ms; read.t: 0 ~16ms
        fly.0: 0 ~16ms after 40ms
        fly.1: 0 ~16ms after 40ms
        fly.2: 0 ~16ms after 40ms
        play gulp
    }

    // ── opening and closing the swell ────────────────────────────
    //  Arriving opens nothing: it opens by pressing her, or a drop.
    on open_tray { tray_open = true }
    on enter hist_link { hist_link.glow: 1 }
    on leave hist_link { hist_link.glow: 0 }
    on press hist_link { emit show_history }
    on close_tray { tray_open = false }
    //  And if it opened BY ITSELF —an urgent one— and nobody comes near, it
    //  closes by itself. The `away` of its grace zone only counts for someone who
    //  was inside, so a tray nobody got to visit stayed open forever: that is
    //  what happened at the end of the demo.
    fact visited = false
    on enter tray_area { visited = true }
    on leave tray_area { visited = false }
    //  Only when it opened by itself —an urgent notice opens it for you—:
    //  opened by you, it waits for Esc or a click outside like the card.
    fact tray_by_itself = false
    on still tray_open for 7s while tray_open and not visited and tray_by_itself { emit close_tray }
    on change tray_open while not tray_open { tray_by_itself = false }
    //  Opening: she moves aside and the tray comes out of her, at the same time,
    //  which is what makes it look like it comes out OF her. Closing, instead, is
    //  in order: first the tray folds away, and **then** she goes back to her
    //  place. It is the same as the control center, and for the same reason:
    //  seeing it in two beats is seeing it.
    on change tray_open while tray_open { offset: 1 ~290ms; tray: 1 ~240ms }
    on change tray_open while not tray_open { tray: 0 ~240ms }
    //  The drops go to the lane as soon as the tray starts coming out.
    follow lane = if(tray_open, 1, 0)
    //  And the rows arrive one after another, 35 ms between each. On closing they
    //  leave the other way round —from bottom to top—, which is how something
    //  really empties.
    on change tray_open while tray_open {
        rise.1: 1 after 60ms
        rise.2: 1 after 95ms
        rise.3: 1 after 130ms
        rise.4: 1 after 165ms
        rise.5: 1 after 200ms
    }
    on change tray_open while not tray_open {
        rise.5: 0 ~120ms
        rise.4: 0 ~120ms after 35ms
        rise.3: 0 ~120ms after 70ms
        rise.2: 0 ~120ms after 105ms
        rise.1: 0 ~120ms after 140ms
    }
    //  Resolving one: it goes off to the right and releases a drop of its colour
    //  that flies back to her. On arriving, its drop's number goes down with a
    //  tap and she gulps. Dismissing sends no drop: what is dismissed does not
    //  come back.
    repeat k in 1..6 {
        //  Dragging it follows it, and on letting go it decides: past the
        //  threshold it goes the way it was going, and otherwise it comes back by
        //  itself with its spring.
        on drag row_zone.$k while alive.$k { pull.$k: drag.dx ~16ms }
        on release row_zone.$k while alive.$k and pull.$k > 92 {
            pull.$k: 0 ~16ms
            flung.$k: 1 ~220ms
            freed.$k: 1 ~380ms
            undoable = true
            resolved_row = k
            play burn
            emit resolve(k)
        }
        //  Dismissing: it goes off to the left and **sends no drop**.
        on release row_zone.$k while alive.$k and pull.$k < -92 {
            pull.$k: 0 ~16ms
            flung.$k: -1 ~220ms
            alive.$k = false
            emit dismiss(k)
        }
        //  And if it did not reach the threshold, it comes back by itself. A tap
        //  —releasing where it was pressed— is opening it, not marking it: `press`
        //  is no good for this, because dragging starts with pressing and would
        //  take it as done at the first pixel.
        on release row_zone.$k while alive.$k and pull.$k > -92 and pull.$k < 92 {
            pull.$k: 0
        }
        on release row_zone.$k while alive.$k and pull.$k > -4 and pull.$k < 4 {
            emit open_notice(k)
        }
        //  When the drop reaches her: the row goes out and she gulps.
        on still freed.$k for 60ms while freed.$k > 0.97 {
            alive.$k = false
            freed.$k: 0 ~16ms
            flung.$k: 0 ~16ms
            play gulp
        }
        //  And the count of ITS category goes down with a tap. One rule per pair
        //  of row and category: the `repeat` writes them, not me.
        repeat c in 1..5 {
            on still freed.$k for 60ms while freed.$k > 0.97 and row_cat.$k == c and n.$c > 0 {
                n.$c = n.$c - 1
                impulse beat.$c 4
            }
            //  Dismissing sends no drop, but the count goes down all the same:
            //  what was dismissed is not pending any more. Without this the
            //  number stayed beside her for ever.
            on release row_zone.$k while alive.$k and pull.$k < -92 and row_cat.$k == c and n.$c > 0 {
                n.$c = n.$c - 1
            }
            //  And undoing gives it back: the row goes back to its place rising,
            //  and its drop's count goes up again with its beat.
            on press undo_zone while resolved_row == k and row_cat.$k == c {
                alive.$k = true
                n.$c = n.$c + 1
                impulse beat.$c 5
                undoable = false
                emit undone(k)
            }
        }
    }

    // ── the countdown ────────────────────────────────────────────
    //  It happens INSIDE the ball and BEFORE the recorder starts, so it does not
    //  come out in the video. And the number never gets to show zero: zero is not
    //  a count, it is the moment to start.
    //  On leaving it goes back to zero, and so entering is ALWAYS a change from 0
    //  to 3: the three gets its bounce like the two and the one, without a
    //  separate rule that then fires twice.
    on change face while face != count { left = 0 }
    on change face while face == count { left = 3 }
    every 1s while face == count { left = left - 1 }
    //  The bounce DECREASES with the count: three blows smaller and smaller so the
    //  last one lands silently just as the recorder starts. A push to the spring's
    //  velocity, not an animation up to a size: that is why each blow comes from
    //  where the previous one was instead of cutting it off, and why the amount can
    //  depend on the count —which is what pleamar could not do: `impulse` only
    //  accepted a written number—.
    on change left while left > 0 { impulse pop left * 2.5 }
    //  Only if she was really counting: on leaving the countdown `left` goes back
    //  to zero, and without this stopping halfway through the count sent her to
    //  record.
    on change left while left == 0 and face == count { face = rec }

    // ── recording: the corner ────────────────────────────────────
    //  She travels along the edges: she leaves at the top with the same gesture as
    //  the photo and comes in at the corner, on another surface. Marea hides one
    //  window and shows another; here she really leaves and really arrives, and in
    //  between there is no frame where she is in both places or in neither while
    //  you watch her.
    event record
    event stop ->                      // and the logic asks the recorder to finish
    event record_toggle                // SUPER+SHIFT+C: starts, or stops whatever there is
    fact corner = false
    fact nook_screen = 0               // which monitor's copy holds the corner
    //  Which of the four. The contract says the one that falls OUTSIDE what is
    //  recorded is chosen; the one that knows what is being recorded is the logic,
    //  so here it is only obeyed. Recording the whole screen leaves none and she
    //  will be in the video, which is the deal of this mode.
    fact nook: top_right | top_left | bottom_right | bottom_left = top_right
    //  0 off the screen, 1 tucked into the corner. Lively: she comes in with a
    //  small bounce against the angle, which is what makes her «snap in».
    prop tuck = 0 ~lively
    follow tuck = if(corner, 1, 0)

    //  Filming is not something she does asleep.
    on record { purpose = nook; asleep = false; play retire }
    //  «She already counts from the corner she is going to take».
    on gone while purpose == nook {
        away: 1 ~16ms
        nook_screen = if(hosts.1, 1, 0)
        corner = true
        face = count
    }
    //  The logic starts the recorder on seeing the recording face, and it is the
    //  logic that says `taping` when it runs FOR REAL. They are two facts on
    //  purpose: the disc arrives with the face, and the red with the recorder.
    //  The same key starts and stops. The guards read the previous frame, so the
    //  two rules do not step on each other.
    on record_toggle while face == eye { emit record }
    on record_toggle while face == count or face == rec { emit stop }
    on stop {
        taping = false
        corner = false
        face = eye
        away: 0 ~lively after 300ms
    }

    // ── what answers the mouse ───────────────────────────────────
    //  Below her: the press belongs to the topmost zone.
    //  In the Haven the time does not come out —the capsule does—, so neither does
    //  its grace zone: declared after, it kept the click on «End», which lands
    //  right on top of it. The capsule already has its own.
    zone box body_zone { at: cx, cy_actual; size: 2 * r, 2 * r + 30; corner: r; cursor: pointer }

    zone ellipse drift_drop { at: pool.x, cy_actual + 44; radius: 84; active: drag.over }
    zone ellipse drift_later { at: pool.x - 120, pool.y; radius: 34; active: drag.over }
    zone ellipse drift_insp { at: pool.x + 120, pool.y; radius: 34; active: drag.over }
    on enter drift_later { later.hl: 1 }
    on leave drift_later { later.hl: 0 }
    on enter drift_insp { insp.hl: 1 }
    on leave drift_insp { insp.hl: 0 }
    //  Anything that needs her brings her out; and she sinks back after 2.6 s of
    //  grace, which is what the contract calls grace and here it is said as is.
    //  And waking up is the first thing that happens when someone looks for her:
    //  the rest —coming out, the time, the panel— comes after, with her already
    //  awake.
    on enter body_zone { needed = true; wanted = true; asleep = false }
    //  180 ms of waiting before coming out: hovering over her is not asking the
    //  time. And 300 of grace on leaving, because the gap between her and the note
    //  is real and must not be lost while crossing it. It goes away if the panel
    //  opens.
    zone box notecard_zone { at: notecard.x, cy_actual; size: 104, 56; corner: 13; cursor: pointer; active: notecard > 0.8 }
    on hover body_zone for 180ms while not open and not menu_open and drag.over < 0.5 { note = true }
    //  And this does not rule in the Haven: with the zone switched off, «being
    //  outside» is always true, so it switched the capsule off 300 ms after
    //  opening it.
    on away notecard_area for 300ms while fan < 0.01 and not haven { note = false }
    //  And a net under both: the rules above count only after the pointer has
    //  been over their zone, and one that fired while its `while` did not hold
    //  —the fan was out at that moment— was spent, and the time stayed open
    //  with nobody over her until she was touched again. This one looks at
    //  the whole: the note open, and the pointer over none of her, 400 ms.
    fact in.body = false
    fact in.note = false
    fact in.fan = false
    on leave body_zone { in.body = false }
    on leave notecard_area { in.note = false }
    on leave fan_area { in.fan = false }
    on enter body_zone { in.body = true }
    on enter notecard_area { in.note = true }
    on enter fan_area { in.fan = true }
    on still note and not (in.body or in.note or in.fan) for 400ms while note and not (in.body or in.note or in.fan) and not haven { note = false }
    //  With the fan out, the grace is counted over the whole.
    on away fan_area for 300ms { note = false }
    //  And opening the card takes the menu with it, as the menu takes the card
    //  with it: there are no two things of hers open at once.
    on change open while open { note = false; menu_open = false }
    //  The time opens the calendar: in her card, on its own page.
    on press notecard_zone { note = false; open = true; page = calendar; emit calendar }
    //  A single grace clock for everything that needs her —the pointer, the note,
    //  the card—: 2.6 s from when the LAST one stops needing her. With one `away`
    //  per zone, leaving her towards the note already counted, and she sank with
    //  the time in her hand.
    fact wanted = false
    on leave body_zone while not note and not open { wanted = false }
    on change note while not note { wanted = false }
    on change open while not open { wanted = false }
    //  And she does not sink with something of hers open: the tray, the finder or
    //  her menu need her just like the card. She sank with the swell open —2.6 s
    //  after letting go of her— and the tray was left hanging from half a ball.
    on still wanted for 2.6s while not wanted and not note and not open and not tray_open and not searching and not menu_open { needed = false }
    //  And she falls asleep by herself after 45 s with nobody there: nothing
    //  needs her and the mouse has not moved anywhere. Only by nothing needing
    //  her she dozed off while you worked, and now that the mouse wakes her she
    //  would nod off and wake up every 45 s. Not in the Haven: automatic sleep
    //  stays suspended while it lasts, which is what the contract says —she is
    //  concentrating, not absent—.
    on idle for 45s while not needed and not haven and not open and not tray_open and not corner and not asleep { asleep = true; dozed = true }
    //  The click opens; brushing past does not. Before, 450 ms of brushing were
    //  enough for a whole panel to cover what you were reading.
    on press body_zone { press: 1; toggle open }
    on release body_zone { press: 0 }
    // ── her menu ─────────────────────────────────────────────────
    //  It goes at the end on purpose: its zones have to be the last ones, because
    //  the press belongs to the topmost zone and the time's one lands on top of it.
    //  Open, the time, the fan and the capsule fold away: «whatever the pointer
    //  had brought out there, goes away». Whoever arrives last, wins.
    on press right body_zone { toggle menu_open }
    on change menu_open while menu_open { open = false; note = false; menu_selected = -1; searching = false; tray_open = false }
    //  It closes like the note: after being outside the whole —her and the menu—
    //  for a while, with Esc, on choosing something, or with another right click.
    //  And not before it is open: while it grows, its zone is not there yet, and
    //  «I've been outside for 300 ms» came true without anyone having moved. The
    //  menu closed by itself 370 ms after opening it if the pointer stayed on her.
    on key Escape while menu_open { menu_open = false }
    //  Esc closes whatever is open. The session's confirmation is the only
    //  thing that goes back a step first: it is the one that cannot be undone.
    on key Escape while open and not (page == session and confirming != none) { open = false }
    on key Escape while tray_open { tray_open = false }
    on key Escape while reel_open { reel_open = false }
    //  «Escape goes back to the menu without executing; a second Escape closes.»
    on key Escape while page == session and confirming != none { confirming = none }
    //  With the keyboard: the arrows move the pointed row and Enter chooses it.
    //  Enter without having pointed at anything takes the first one, which is
    //  Settings: what the right button used to do is still one key away.
    on key Down while menu_open { menu_selected = min(menu_selected + 1, 3 + entries.count) }
    on key Up while menu_open { menu_selected = max(menu_selected - 1, 0) }
    on key Return while menu_open and menu_selected < 1 { emit search; menu_open = false }
    on key Return while menu_open and menu_selected == 1 { emit settings; menu_open = false }
    //  «Settings», from her menu or from outside, opens its page in the control
    //  center.
    on settings { open = true; page = settings; section = menu }
    on key Return while menu_open and menu_selected == 2 { emit customize; menu_open = false; open = true; page = wardrobe }
    on key Return while menu_open and menu_selected == 3 { emit sleep; menu_open = false }
    on key Return while menu_open and menu_selected > 3 { emit menu_entry(menu_selected - 4); menu_open = false }
    on menu_entry { menu_open = false }

    //  The house zones, outside the drawing and after the whole.
    repeat m in 0..4 {
        zone box own_zone.$m { at: menu.x, menu.y0 + 4 + 11.5 + m * 23; size: 155, 23
                                corner: 7; cursor: pointer; active: menu > 0.9 }
        on enter own_zone.$m { own.$m: 1; menu_selected = -1 }
        on leave own_zone.$m { own.$m: 0 }
    }
    on press own_zone.0 { emit search; menu_open = false }
    on press own_zone.1 { emit settings; menu_open = false }
    on press own_zone.3 { emit sleep; menu_open = false }
    //  «Customize» opens her wardrobe, which is where this lives.
    on press own_zone.2 { emit customize; menu_open = false; open = true; page = wardrobe }

    // ── the corner ───────────────────────────────────────────────
    //  She peeks out 82 %: with a little more than half, the red eye spent the
    //  time behind the edge, which is exactly the only thing this mode is for.
    //  46 × 0.82 − 23 = 14.7: that is how far from the angle her centre sits.
    // ── the lock screen ──────────────────────────────────────────
    //  «A lock screen has a job and a half. The job is to let in whoever knows the
    //  password and nobody else. The half is not to be scary»: it appears all at
    //  once, covers what you were doing and has no cancel button. That is why she
    //  is there, with the padlock on her face —the same one she put on when
    //  pointing at «Lock» a second ago—, so that what covers the desktop is the
    //  same thing as the card you have just used and not a stranger asking for
    //  the password.
    //
    //  The background is almost black and still: not the desktop photo, which
    //  would show whoever walks by what you were doing, nor anything that moves.
    on lock { locked = true }
    on change locked while locked { hint = lock; focus password; lock.glow: 1 }
    on change locked while not locked { hint = none; lock.glow: 0 }
    //  Closing the panel takes her padlock face away; while it lasts, it is put
    //  back on.
    on change hint while locked and hint != lock { hint = lock }
    on wrong_password { impulse headshake 22 }
    //  The emergency exit of the first locks. It is said on screen: one that
    //  opens with Esc without saying so is not a lock screen, it is a poster.
    on key Escape while locked and with_exit { locked = false }
    //  And the second seatbelt of those first locks: if the keyboard did not
    //  arrive —and then neither would Esc—, it opens by itself after a minute. A
    //  locker that stays shut without being able to open has no stand-in on this
    //  machine, so while it is a test one it does not trust a single exit.
    on still locked for 60s while locked and with_exit { locked = false }

    surface lockscreen {
        kind: lock
        size: 640, 440
        open: locked

        box { from: -4000, -4000; size: 8640, 8440; color: #07080a }
        //  Almost black, but not quite in the centre: she is a very dark grey and
        //  on pure black she would get lost.
        body {
            gradient: radial 320, 236 radius 260, #14171a, #07080a
            ellipse { at: 320, 236; radius: 260 }
        }

        text now.time { at: 320, 58; anchor: center; size: 68; weight: 300; color: #f6f6f5 }
        text "{upper(now.date)}" { at: 320, 112; anchor: center; size: 12; weight: 600; color: #8b8f95 }

        //  Her, at a size that can be seen from the door.
        group {
            pivot: 320, 214
            scale: 2.1, 2.1
            move: headshake, 0
            body {
                color: coal
                rim: 14%
                ellipse { at: 320, 214; radius: 23 }
            }
            Face(320, 214, 0, 0)
        }

        //  The box. It has the whole keyboard —it is `kind: lock`—, so there is
        //  no need to press it: you just type.
        box { at: 320, 346; size: 300, 46; corner: 14; color: mix(#15171a, #1b1e22, lock.glow) }
        box { at: 320, 346; size: 300, 46; corner: 14; stroke: 1.2; color: mix(mint, #e0655a, clamp(abs(headshake) / 6, 0, 1)); opacity: 35% + lock.glow * 40% }
        input password { at: 188, 335; width: 264; size: 16; color: #f6f6f5; placeholder: "Password"; secret: true }

        text "Checking…" { at: 320, 392; anchor: center; size: 11.5; color: #8b8f95; show: checking }
        text "Enter to unlock" { at: 320, 392; anchor: center; size: 11.5; color: #8b8f95; opacity: 60%; show: not checking and lock.held > 0.5 }
        text "Esc to exit · test lock" { at: 320, 420; anchor: center; size: 11; color: mint; opacity: 80%; show: with_exit }
    }

    // ── the adventure's stage ────────────────────────────────────
    //  The whole monitor, only while it lasts. It catches no clicks: a surface
    //  only takes the pointer where it has zones, and this one has none.
    //  The catcher: while something of hers is open, a transparent surface over
    //  the whole of every monitor, just under her. It draws nothing; it only
    //  catches the press that lands outside her, and that closes whatever is
    //  open. On Wayland a surface does not hear clicks on other windows, and
    //  losing the keyboard is no help when the finder holds it exclusively:
    //  this is what any menu of a desktop does.
    surface catcher {
        size: full, full
        anchor: top_left
        level: top
        screens: each max 2
        open: open or tray_open or menu_open or reel_open or searching
        //  And the zone says it again: a full-screen zone that stays on by
        //  mistake is the whole desktop taken. It happened.
        zone box outside { from: 0, 0; size: catcher.width, catcher.height; active: open or tray_open or menu_open or reel_open }
        on press outside { open = false; tray_open = false; menu_open = false; reel_open = false }
        //  The finder stays in her own layer —moving it up as it opens left
        //  it without the keyboard—, so here the catcher would be over it:
        //  around it instead, three strips —left, right and below— and the
        //  finder and Marea herself in the hole. (Her surface is centred at
        //  the top: `ox` is where it starts on this one.)
        let ox = (catcher.width - 820) / 2
        let hole.x0 = ox + cx - r - 12
        let hole.x1 = ox + finder.x + finder.w / 2 + 8
        let hole.y1 = finder.y + finder.h / 2 + 8
        zone box outside_left { from: 0, 0; size: hole.x0, catcher.height; active: searching }
        zone box outside_right { from: hole.x1, 0; size: catcher.width - hole.x1, catcher.height; active: searching }
        zone box outside_below { from: hole.x0, hole.y1; size: hole.x1 - hole.x0, catcher.height - hole.y1; active: searching }
        on press outside_left { searching = false }
        on press outside_right { searching = false }
        on press outside_below { searching = false }
    }

    // ── the tide, under the windows ──────────────────────────────
    //  Where a new wallpaper arrives: over the one `swaybg` paints and below
    //  every window (`level: bottom`), on each monitor, with nothing that
    //  catches the mouse. The drop falls on the monitor she lives on; on the
    //  others the wave comes in from the side, a moment later.
    shader tides = file "shaders/tide.wgsl"
    surface tide {
        size: full, full
        anchor: top_left
        level: bottom
        screens: each max 2
        open: tide.on
        let here = screen.index == tide.home
        let tw = tide.width
        let th = tide.height
        let t.ox = if(here, tw / 2, if(screen.index > tide.home, -240, tw + 240))
        let t.oy = th * 0.55
        let t.p = clamp(tide.p * 1.3 - if(here, 0, 0.3), 0, 1)
        group {
            opacity: tide.fade
            for t in tidepics {
                group {
                    shader: tides, t.p, t.ox, t.oy, tide.settle
                    image t.pic { at: 0, 0; size: tw, th }
                }
            }
            //  The drop, from her to where it lands: long as it falls, round when it lands.
            let fall = tide.fall * tide.fall
            let dx = tw / 2 - 50 + (tw / 2 - (tw / 2 - 50)) * tide.fall
            let dy = 30 + (t.oy - 30) * fall
            let stretch = clamp(vel(tide.fall) * 0.25, 0, 1.2)
            body {
                show: here and tide.fall > 0.01 and tide.p < 0.02
                color: #151616
                rim: 30%
                shadow: 0, 6, 14, 40%
                ellipse { at: dx, dy; radius: 11; scale: 1 - stretch * 0.25, 1 + stretch }
            }
            ellipse { at: dx - 3, dy - 4 - stretch * 5; radius: 2.6; color: #fff; opacity: 70%; show: here and tide.fall > 0.01 and tide.p < 0.02 }
            //  And the splash: drops thrown up and out, falling back.
            particles {
                at: tw / 2, t.oy; area: 20, 4; count: 140
                life: 0.5s .. 1.1s; speed: 180 .. 520
                direction: -90deg; spread: 150deg; gravity: 0, 900
                size: 5, 1.5; colors: #e8f6ff, #9ed6bd; opacity: 95%, 0%
                shape: dot; burst: splash
            }
        }
    }

    surface stage {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 2
        open: adventuring and screen.index == adv_screen
        //  Where she is: across the bottom and between home and the floor.
        //  Home is where she lives: 50 px left of the middle, at her height.
        let home.x = stage.width / 2 - 50
        let home.y = cy - rise
        let floor.y = stage.height - 26
        let ax = home.x + adv.fx * (stage.width / 2 - 80)
        //  Where in its hop she is (0 taking off, 1 landing), the arc's height,
        //  how close to the ground —for the squash— and how fast she goes up or
        //  down —for the stretch—.
        let hop.f = fract(adv.p)
        let hop.h = 4 * hop.f * (1 - hop.f) * hop.amp * hopping
        let hop.ground = (1 - smooth(0, 0.14, min(hop.f, 1 - hop.f))) * hopping
        let hop.speed = abs(1 - 2 * hop.f) * (1 - hop.ground) * hopping
        let ay = home.y + adv.fy * (floor.y - home.y) - hop.h + 5 * hop.ground
        //  The wings, flapping while they are out.
        prop flap = 0
        //  Slow, broad strokes: fast ones looked like a hummingbird.
        wave flap = 1 at 11
        repeat w in 0..2 {
            let s.w = w * 2 - 1
            group {
                pivot: ax + 16 * s.w, ay - 6
                rotate: s.w * (0.55 + 0.5 * flap) * wing
                scale: wing, wing
                body {
                    color: #eef3f6
                    rim: 20%
                    ellipse { at: ax + 34 * s.w, ay - 14; radius: 16; scale: 1.5, 0.6; rotate: s.w * -0.4 }
                    ellipse { at: ax + 46 * s.w, ay - 8; radius: 10; scale: 1.4, 0.5; rotate: s.w * -0.15; blend: 6 }
                    ellipse { at: ax + 50 * s.w, ay; radius: 8; scale: 1.4, 0.45; rotate: s.w * 0.15; blend: 6 }
                }
            }
        }
        //  Her, melted with the water at the top while she lets go.
        body {
            color: skin
            rim: 14%
            ellipse { at: home.x, -30; radius: 40 * clamp(1 - adv.fy * 6, 0, 1); blend: 18 * clamp(1 - adv.fy * 8, 0, 1) }
            ellipse { at: ax, ay; radius: 23; rotate: tilt; blend: 18 * clamp(1 - adv.fy * 8, 0, 1)
                      scale: sx * (1 + 0.2 * hop.ground - 0.07 * hop.speed), sy * (1 - 0.24 * hop.ground + 0.1 * hop.speed) }
        }
        Face(ax, ay, gaze.x * 0.5, gaze.y * 0.5, 0)
        //  A little dust where she lands and hops.
        particles { at: ax, floor.y + 18; area: 30, 0; count: 40; life: 0.3s .. 0.6s; speed: 20 .. 70; direction: -90deg; spread: 120deg
                    gravity: 0, 200; size: 3, 0; colors: #cfd3d8; opacity: 50%, 0%; emit: adventuring and adv.fy > 0.98 and (hop.ground > 0.6 or sx > 1.1) }
    }

    surface nook {
        //  Wide for the panel that comes out of her when you come near, with its
        //  shadow.
        size: 260, 120
        //  The edge is decided by a fact, and it changes on the fly: layer-shell
        //  lets a live surface move corner without creating it again. Before, this
        //  needed four surfaces —it was pleamar's limitation S13—.
        anchor: nook
        level: overlay
        //  One per monitor, and only the one she was on when the recording began
        //  is open —with «follow me», the one with the focus, which is the one
        //  being recorded—. It used to say `screens: "DP-3"`, from when she only
        //  lived there, and with her on the other monitor the corner came out on
        //  the wrong one.
        screens: each max 2
        //  Open while anything of her is left inside: that way she slides out
        //  instead of disappearing with the window.
        open: tuck > 0.01 and screen.index == nook_screen

        //  Where she falls inside her surface, depending on which angle she is
        //  stuck to. She leaves by the same angle she came in by: what hides her is
        //  the corner, not a fixed direction.
        let wing.r = if(nook == top_right or nook == bottom_right, 1, 0)
        let wing.b = if(nook == bottom_right or nook == bottom_left, 1, 0)
        let rx = 14.7 + wing.r * (260 - 29.4) + (1 - tuck) * 44 * (wing.r * 2 - 1)
        let ry = 14.7 + wing.b * (120 - 29.4) + (1 - tuck) * 44 * (wing.b * 2 - 1)

        //  The gaze, folded onto her visible side: looking towards her own hidden
        //  half is looking nowhere. Stuck to the right she only looks inwards, and
        //  at the top only downwards.
        prop rgaze.x = 0 ~gentle
        prop rgaze.y = 0 ~gentle
        look rgaze.x, rgaze.y at rx, ry reach 6, 3.5 within 260
        prop cam.hold = 0 ~lively
        let cam.sx = 1 - 2 * wing.r
        let cam.sy = 1 - 2 * wing.b
        let cam.dx = nook.cursor.x - rx
        let cam.dy = nook.cursor.y - ry
        let cam.base = atan2(cam.sy, cam.sx)
        prop cam.rel = 0 ~gentle
        follow cam.rel = clamp(atan2(cam.sx * cam.dy - cam.sy * cam.dx, cam.sx * cam.dx + cam.sy * cam.dy), -100, 100)
        let cam.aim = cam.base + cam.rel
        let cam.flip = if(cos(cam.aim) < 0, -1, 1)
        //  Filming, she looks where the camera points.
        let aim.x = mix(if(wing.r, min(rgaze.x, 0), max(rgaze.x, 0)), 5 * cos(cam.aim), cam.hold)
        let aim.y = mix(if(wing.b, min(rgaze.y, 0), max(rgaze.y, 0)), 3 * sin(cam.aim), cam.hold)

        //  The clock and «Stop», which come out OF her when you come near. It is
        //  not a panel that appears beside her: it is the same body, stretching
        //  into the screen like a drop and separating —with its neck halfway—
        //  until it sits 8 px away. Marea fades it in 150 ms; here it is born.
        fact nearby = false
        prop near = 0 ~lively
        follow near = if(nearby and tuck > 0.9, 1, 0)
        follow cam.hold = if(face == rec and corner, 1, 0) * (1 - clamp(near * 2, 0, 1))
        let p.w = 124 * near
        //  And the panel comes out on the inner side of the screen, not always to
        //  the left.
        let p.x = rx + (23 + 8 + 62) * near * (1 - wing.r * 2)
        let p.y = ry
        //  How long it has been going. The renderer counts it: a second is a
        //  second even if the logic is busy starting a recorder.
        fact secs = 0
        on change taping while taping { secs = 0 }
        every 1s while taping { secs = secs + 1 }

        //  The grace zone goes BELOW everything else: the press belongs to the
        //  topmost zone, and declared at the end it kept the click on «Stop» and
        //  the one on her.
        zone box around { at: (p.x + rx) / 2, ry; size: abs(rx - p.x) + 140, 100; active: nearby }

        body {
            color: coal
            rim: 6%
            //  The same halo as on the other surface: it is her, and she separates
            //  from the desktop with light, not by darkening it. And when the time
            //  panel comes out of her, it becomes a shadow again.
            shadow: 0, 0, 13, 45%, mix(ink, #05070a, clamp(near * 2, 0, 1))
            box { at: p.x, p.y; size: p.w, 42 * clamp(near * 3, 0, 1); corner: 13 }
            ellipse her { at: rx, ry; radius: 23; scale: sx + press * 0.04, sy - press * 0.05; blend: 16 * 4 * near * (1 - near) }
        }
        group {
            //  It comes in late: until the panel has come loose from her, the
            //  button would sit below her face.
            opacity: clamp(near * 5 - 4, 0, 1)
            move: (1 - near) * 14, 0
            text "{secs, time}" { at: p.x - 46, p.y; anchor: left center; size: 13; weight: 600; color: ink }
            prop hot = 0 ~140ms
            box { at: p.x + 22, p.y; size: 64, 26; corner: 8; color: mix(#e0655a, #f0796a, hot) }
            text "Stop" { at: p.x + 22, p.y; anchor: center; size: 12; weight: 600; color: #060000 }
            zone box stop_btn { at: p.x + 22, p.y; size: 64, 26; corner: 8; cursor: pointer; active: near > 0.8 }
            on enter stop_btn { hot: 1 }
            on leave stop_btn { hot: 0 }
            on press stop_btn { emit stop }
        }
        //  The face goes a little inwards, so the disc stays in sight.
        Face(rx - 5 * (wing.r * 2 - 1), ry + 4 * (1 - wing.b * 2), aim.x, aim.y)

        //  The camera. Recording, she holds one out on her inner side and points
        //  it at the mouse wherever it is —`nook.cursor`, the mouse in this
        //  surface's own coordinates—. The angle is measured from the direction
        //  that goes into the screen from her corner, so it never wraps round at
        //  180° and the spring does not spin it the long way. Pointing left, the
        //  camera flips so its viewfinder stays on top. When you come near for
        //  «Stop», she puts it away: the panel comes out of that same side.
        //  Held to one eye, like somebody looking through the viewfinder: the
        //  eye on the side it points to, which the eyepiece covers. The same
        //  place the Face puts that eye —its centre, 6.5 to the side, and where
        //  it is looking—, so camera and eye move as one.
        let cam.ex = rx - 5 * (wing.r * 2 - 1) + 6.5 * cam.flip + aim.x
        let cam.ey = ry + 4 * (1 - wing.b * 2) + aim.y
        group {
            show: cam.hold > 0.01
            pivot: cam.ex, cam.ey
            rotate: cam.aim * 1deg
            scale: cam.hold, cam.hold * cam.flip
            //  What it sees: a faint cone of light from the lens, fading out.
            group {
                mask: radial cam.ex + 28.5, cam.ey radius 6 to 90
                path { at: 0, 0; color: #ffffff; opacity: 7%
                       move cam.ex + 28.5, cam.ey - 2.5; line cam.ex + 125, cam.ey - 30; line cam.ex + 125, cam.ey + 30; line cam.ex + 28.5, cam.ey + 2.5; close }
            }
            //  The camera: eyepiece (on her eye), body, viewfinder and lens hood.
            //  Boxes with nearly square corners, joined without melting: a
            //  camera is a box, and melted with rounded corners it read as an
            //  egg. The eyepiece is a square 16 across, which covers the eye —13
            //  tall, turning with the aim— at any angle.
            body {
                color: #2c3035
                rim: 14%
                box { at: cam.ex, cam.ey; size: 16, 16; corner: 2 }
                box { at: cam.ex + 13, cam.ey + 0.5; size: 16, 14; corner: 1.5 }
                box { at: cam.ex + 10, cam.ey - 8.5; size: 9, 5; corner: 1 }
                box { at: cam.ex + 22.5, cam.ey + 0.5; size: 5, 11; corner: 1 }
            }
            //  The lens, with its glint.
            ellipse { at: cam.ex + 25.5, cam.ey + 0.5; radius: 3.8; color: #1d3f63 }
            ellipse { at: cam.ex + 25.5, cam.ey + 0.5; radius: 3.8; stroke: 1.1; color: #6f7a85 }
            ellipse { at: cam.ex + 24.5, cam.ey - 0.8; radius: 1.2; color: #ffffff; opacity: 75% }
            //  REC: blinking once a second while the recorder really runs.
            ellipse { at: cam.ex + 14.5, cam.ey - 3; radius: 1.8; color: #ff4b3e; opacity: if(taping, if(mod(secs, 2) < 1, 1, 0.2), 0.2) }
        }

        //  Pressing her stops it.
        zone box her_zone { at: rx, ry; size: 46, 46; corner: 23; cursor: pointer }
        on press her_zone { press: 1; emit stop }
        on release her_zone { press: 0 }
        //  Coming near brings it out; and it folds away with 320 ms of grace,
        //  because the gap between her and the panel is real and must not be lost
        //  while crossing it.
        on enter her_zone { nearby = true }
        on away around for 320ms { nearby = false }
        on stop { nearby = false }
    }
}
